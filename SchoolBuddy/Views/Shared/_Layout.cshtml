@{
    var controller = ViewContext.RouteData.Values["Controller"]?.ToString();
    var action = ViewContext.RouteData.Values["Action"]?.ToString();
    bool indoorTrackingActive = controller == "Home" &&
      (action == "uhfGates" ||
       action == "uwbTracking" ||
       action == "blTracking" ||
       action == "staffDetails" ||
       action == "visitorDetails");
    bool driverManagementActive = controller == "Driver_Management";
    bool masterActive =
        (controller == "Home" &&
            (action == "Students" ||
             action == "EventHoliday" ||
             action == "teacherDetails"||
             action == "Attendance")) ||

        (controller == "Route" &&
            (action == "Trip" ||
             action == "Halts")) ||

        (controller == "Command" &&
            action == "Getcommandss");

}
