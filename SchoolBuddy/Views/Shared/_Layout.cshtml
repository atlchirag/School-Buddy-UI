    <script>
        // Video Telematics menu: shown only when the account has MDVR vehicles.
        // The server renders it once the session knows; otherwise ask /VideoTelematics/MdvrStatus once.
        (function () {
            var item = document.getElementById('vtNavItem');
            if (!item || item.getAttribute('data-mdvr-checked') === '1' || !window.fetch) return;

            fetch(item.getAttribute('data-mdvr-url'), {
                credentials: 'same-origin',
                headers: { 'Accept': 'application/json', 'X-Requested-With': 'XMLHttpRequest' }
            })
                .then(function (response) { return response.ok ? response.json() : null; })
                .then(function (data) { item.hidden = !(data && data.isMdvrEnabled); })
                .catch(function () { item.hidden = true; });
        })();
    </script>
