            /* Logout modal width */
            .logout-modal-dialog {
                max-width: 430px;
                padding: 15px;
            }

            /* Main modal card */
            .logout-modal-content {
                position: relative;
                border: none !important;
                border-radius: 22px !important;
                overflow: hidden;
                background: #ffffff;
                box-shadow: 0 20px 60px rgba(15, 23, 42, 0.22);
            }

            /* Modal body */
            .logout-modal-body {
                padding: 38px 35px 32px;
                text-align: center;
            }

            /* Close button */
            .logout-close-btn {
                position: absolute;
                top: 18px;
                right: 18px;
                z-index: 2;
                width: 28px;
                height: 28px;
                padding: 6px;
                border-radius: 50%;
                background-color: #f1f5f9;
                opacity: 1;
                box-shadow: none !important;
            }

                .logout-close-btn:hover {
                    background-color: #e2e8f0;
                }

            /* Icon circle */
            .logout-icon {
                width: 76px;
                height: 76px;
                margin: 0 auto 20px;
                display: flex;
                align-items: center;
                justify-content: center;
                border-radius: 50%;
                background: rgba(25, 25, 112, 0.1);
                color: midnightblue;
                font-size: 34px;
            }

            /* Title */
            .logout-title {
                margin-bottom: 10px;
                color: #0f172a;
                font-size: 25px;
                font-weight: 700;
            }

            /* Message */
            .logout-message {
                margin-bottom: 28px;
                color: #64748b;
                font-size: 16px;
                line-height: 1.6;
            }

            /* Buttons wrapper */
            .logout-actions {
                display: flex;
                justify-content: center;
                gap: 12px;
            }

                /* Common button style */
                .logout-actions .btn {
                    min-width: 125px;
                    padding: 11px 20px;
                    border-radius: 12px;
                    font-size: 15px;
                    font-weight: 600;
                    transition: all 0.25s ease;
                }

            /* Cancel button */
            .logout-cancel-btn {
                color: #475569 !important;
                background: #f1f5f9 !important;
                border: 1px solid #e2e8f0 !important;
            }

                .logout-cancel-btn:hover {
                    color: #0f172a !important;
                    background: #e2e8f0 !important;
                    transform: translateY(-1px);
                }

            /* Logout button */
            .logout-confirm-btn {
                color: #ffffff !important;
                background: midnightblue !important;
                border: 1px solid midnightblue !important;
                box-shadow: 0 7px 18px rgba(25, 25, 112, 0.25);
            }

                .logout-confirm-btn:hover {
                    color: #ffffff !important;
                    background: #10105c !important;
                    border-color: #10105c !important;
                    transform: translateY(-1px);
                    box-shadow: 0 10px 22px rgba(25, 25, 112, 0.32);
                }

            /* Background overlay */
            .modal-backdrop.show {
                opacity: 0.45;
            }

            /* Mobile responsive */
            @@media (max-width: 576px) {
                .logout-modal-body {
                    padding: 35px 22px 25px;
                }

                .logout-actions {
                    flex-direction: column-reverse;
                }

                    .logout-actions .btn {
                        width: 100%;
                    }
            }
            .footer {
                text-align: center;
            }

            .back-to-top {
                position: fixed;
                visibility: hidden;
                opacity: 0;
                /* Bottom Right Corner */
                right: 20px;
                left: auto;
                bottom: 20px;
                z-index: 99999;
                width: 45px;
                height: 45px;
                background: midnightblue;
                color: white;
                border-radius: 50%;
                text-decoration: none;
                box-shadow: 0 5px 15px rgba(0, 0, 0, 0.25);
                transition: all 0.3s ease;
                font-size: 18px;
    font-weight: 500;
            }

                .back-to-top i {
                    font-size: 28px;
                    line-height: 0;

                }

                .back-to-top:hover {
                    background: #2929a3;
                    color: white;
                    transform: translateY(-4px);
                    box-shadow: 0 8px 20px rgba(0, 0, 0, 0.35);
                }

                .back-to-top.active {
                    visibility: visible;
                    opacity: 1;
                }
            /* Keep scrolling but hide scrollbar */

            /* Chrome, Edge, Safari */
            html::-webkit-scrollbar,
            body::-webkit-scrollbar {
                display: none;
            }

            /* Firefox */
            html,
            body {
                scrollbar-width: none;
            }

            /* IE / Old Edge */
            html,
            body {
                -ms-overflow-style: none;
            }

