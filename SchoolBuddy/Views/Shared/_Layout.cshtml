   <style>
            /* =========================================================
               ROOT VARIABLES
            ========================================================= */

            :root {
                --sb-header-height: 60px;
                --sb-sidebar-width: 250px;
                --sb-sidebar-bg: midnightblue;
                --sb-sidebar-border: #1f2937;
                --sb-primary: #2563eb;
            }

            .iconstyle {
                border: 2px solid midnightblue;
                border-radius: 50%;
                color: midnightblue;
                cursor: pointer;
            }

            /* =========================================================
               GLOBAL LAYOUT
            ========================================================= */

            html,
            body {
                min-height: 100vh;
                margin: 0;
            }

            body {
                display: flex;
                flex-direction: column;
                padding-top: var(--sb-header-height);
                overflow-x: hidden;
                background-color: var(--sb-page-bg); /* Soft gray for the dashboard background */
                color: var(--sb-text);
            }

            /* =========================================================
               HEADER
            ========================================================= */

            #header {
                height: var(--sb-header-height);
                z-index: 1100;
                box-sizing: border-box;
            }

            #header-logo-container {
                width: var(--sb-sidebar-width) !important;
                min-width: var(--sb-sidebar-width) !important;
                max-width: var(--sb-sidebar-width) !important;
                flex: 0 0 var(--sb-sidebar-width) !important;
                box-sizing: border-box !important;
                background-color: var(--sb-sidebar-bg) !important;
                transition: all .3s ease;
                overflow: hidden;
                position: relative;
                z-index: 1050;
            }

            /* =========================================================
               SIDEBAR
            ========================================================= */

            #sidebar {
                position: fixed;
                top: var(--sb-header-height);
                left: 0;
                width: var(--sb-sidebar-width) !important;
                min-width: var(--sb-sidebar-width) !important;
                max-width: var(--sb-sidebar-width) !important;
                flex: 0 0 var(--sb-sidebar-width) !important;
                box-sizing: border-box !important;
                height: calc(100vh - var(--sb-header-height));
                background-color: var(--sb-sidebar-bg) !important;
                border-right: 1px solid var(--sb-sidebar-border);
                overflow-x: hidden !important;
                overflow-y: auto !important;
                transition: all .3s ease;
                z-index: 1040;
                scrollbar-width: none !important;
                -ms-overflow-style: none !important;
            }

            #sidebar::-webkit-scrollbar {
                display: none !important;
                width: 0 !important;
                height: 0 !important;
            }

            /* =========================================================
               MAIN CONTENT
            ========================================================= */

            #layoutmain,
            #footer {
                margin-left: var(--sb-sidebar-width);
                min-width: 0;
                max-width: 100%;
                box-sizing: border-box;
                transition: all .3s ease;
            }

            #layoutmain {
                flex: 1 1 auto;
                min-height: 0;
                overflow-x: auto;
                scrollbar-width: none;
            }

            #footer {
                width: auto;
            }

            #layoutmain::-webkit-scrollbar {
                display: none;
            }

            /* =========================================================
               SIDEBAR WRAPPER
            ========================================================= */

            #sidebar .sb-sidebar-wrapper {
                width: 100% !important;
                min-width: 0;
                max-width: 100%;
                min-height: 100%;
                height: auto !important;
                box-sizing: border-box;
                padding: .85rem .65rem;
                display: flex;
                flex-direction: column;
                justify-content: space-between;
                overflow: visible !important;
            }

            /* =========================================================
               SIDEBAR NAVIGATION
            ========================================================= */

            .sidebar-nav {
                padding: 0;
                margin: 0;
                list-style: none;
                min-width: 0;
                max-width: 100%;
                box-sizing: border-box;
            }

            .sidebar-nav .nav-item {
                width: 100%;
                min-width: 0;
                max-width: 100%;
                box-sizing: border-box;
                margin-bottom: 3px;
            }

            .sidebar-nav .nav-link {
    display: flex !important;
    align-items: center !important;
    gap: 10px;
    width: 100%;
    border-radius: 8px;
    padding: .7rem .9rem !important;
    color: rgba(255,255,255,.78) !important;
    background: transparent !important;
    border: none !important;
    box-shadow: none !important;

    font-size: .78rem !important;
    font-weight: 500;
    min-width: 0;
    max-width: 100%;
    box-sizing: border-box;
    overflow-wrap: anywhere;

    transition:
        background-color .2s ease,
        color .2s ease,
        border-color .2s ease;
}
            .sidebar-nav .nav-link i {
                font-size: 1rem;
                color: rgba(255,255,255,.65) !important;
                transition: all .2s ease;
            }

            /* Hover */
            .sidebar-nav .nav-link:hover {
                background: rgba(255,255,255,.08) !important;
                color: #fff !important;
            }

            .sidebar-nav .nav-link:hover i {
                color: #fff !important;
            }

            /* Active */
            .sidebar-nav .nav-link.active {
                background: var(--sb-primary) !important;
                color: #fff !important;
                font-weight: 600;
            }

            .sidebar-nav .nav-link.active i {
                color: #fff !important;
            }

            /* =========================================================
               SUBMENU
            ========================================================= */

            .sidebar-nav .collapse,
            .sidebar-nav .collapsing {
                background: rgba(0,0,0,.15);
                border-radius: 8px;
                margin: 4px 0 8px 0;
                padding: 4px 0;
            }

            .sidebar-nav .collapse ul,
            .sidebar-nav .collapsing ul {
                list-style: none;
                margin: 0;
                padding: 0;
            }
.sidebar-nav .collapse .nav-link,
.sidebar-nav .collapsing .nav-link {
    padding: .45rem .75rem .45rem 2rem !important;
    font-size: .78rem !important;   /* Same as main menu */
    font-weight: 500 !important;
    line-height: 1.4 !important;
    background: transparent !important;
    color: rgba(255,255,255,.78) !important;
    border-radius: 0 !important;
    transition: background-color .2s ease, color .2s ease;
}
            .sidebar-nav .collapse .nav-link.active,
            .sidebar-nav .collapsing .nav-link.active {
                background: var(--sb-primary) !important;
                color: #fff !important;
                font-weight: 600;
            }

            .sidebar-nav .collapse .nav-link i,
            .sidebar-nav .collapsing .nav-link i {
                font-size: .45rem;
            }

            .sidebar-nav .collapse .nav-link:hover,
            .sidebar-nav .collapsing .nav-link:hover {
                text-decoration: underline;
                color: #fff !important;
            }

            /* =========================================================
               HIDDEN SIDEBAR (DESKTOP)
            ========================================================= */

            body.sidebar-collapsed #sidebar {
                left: calc(-1 * var(--sb-sidebar-width));
            }

            body.sidebar-collapsed #layoutmain,
            body.sidebar-collapsed #footer {
                margin-left: 0 !important;
            }

            body.sidebar-collapsed #header-logo-container {
                width: 0 !important;
                min-width: 0 !important;
                max-width: 0 !important;
                flex-basis: 0 !important;
                padding: 0 !important;
            }

            /* =========================================================
               SIDEBAR FOOTER WIDGET
            ========================================================= */

            .parent-app-widget {
                background: rgba(255,255,255,.08);
                border: 1px solid rgba(255,255,255,.08);
                color: #fff;
            }

            .sidebar-widget-icon {
                width: 42px;
                height: 42px;
                border-radius: 10px;
                background: rgba(255,255,255,.12);
                display: flex;
                align-items: center;
                justify-content: center;
                font-size: 1.2rem;
            }

            /* =========================================================
               BACKDROP
            ========================================================= */

            .sidebar-backdrop {
                position: fixed;
                inset: 0;
                background: rgba(0,0,0,.45);
                border: 0;
                opacity: 0;
                visibility: hidden;
                transition: .3s ease;
                z-index: 1035;
            }

            /* =========================================================
               MOBILE RESPONSIVE
            ========================================================= */

            @@media (max-width:991.98px) {
                body:not(.sidebar-mobile-open) #header-logo-container {
                    display: none !important;
                }
                body.sidebar-mobile-open #header-logo-container {
                    display: flex !important;
                    background-color: var(--sb-sidebar-bg) !important;
                }
                
                body.sidebar-mobile-open #header {
                    z-index: 1050 !important;
                }

                /* Sidebar is hidden by default on mobile */
                #sidebar {
                    left: calc(-1 * var(--sb-sidebar-width));
                }

                body.sidebar-mobile-open #sidebar {
                    left: 0;
                }

                body.sidebar-mobile-open .sidebar-backdrop {
                    opacity: 1;
                    visibility: visible;
                }

                #layoutmain,
                #footer {
                    margin-left: 0 !important;
                }
            }

            /* =========================================================
               DARK THEME
            ========================================================= */

            /* =========================================================
               MODAL
            ========================================================= */

            .modal-dialog {
                margin-top: calc(var(--sb-header-height) + 12px);
            }

            /* =========================================================
               TRANSITIONS
            ========================================================= */

            body.sidebar-ready #sidebar,
            body.sidebar-ready #layoutmain,
            body.sidebar-ready #footer,
            body.sidebar-ready #header-logo-container {
                transition: all .3s ease;
            }

