@inject Microsoft.AspNetCore.Antiforgery.IAntiforgery Antiforgery
@{
    var userName = Context.Session.GetString("schoolname");
    var requestVerificationToken = Antiforgery.GetAndStoreTokens(Context).RequestToken;
}
@{
    var controller = ViewContext.RouteData.Values["Controller"]?.ToString();
    var action = ViewContext.RouteData.Values["Action"]?.ToString();
    bool indoorTrackingActive = controller == "Home" &&
      (action == "uhfGates" ||
       action == "uwbTracking" ||
       action == "blTracking" ||
       action == "staffDetails" ||
       action == "visitorDetails");
    bool driverManagementActive = controller == "Driver_Management";
    bool videoTelematicsActive = controller == "VideoTelematics";
    // "1" / "0" once /VideoTelematics/MdvrStatus has checked this session; null = not checked yet.
    string? mdvrFlag = Context.Session.GetString(SchoolBuddy.Models.VideoTelematics.VideoTelematicsRepository.MdvrEnabledSessionKey);
    bool showVideoTelematics = mdvrFlag == "1";
    bool masterActive =
        (controller == "Home" &&
            (action == "Students" ||
             action == "EventHoliday" ||
             action == "teacherDetails"||
             action == "Attendance")) ||

        (controller == "Route" &&
            (action == "Trip" ||
             action == "Halts")) ||

        (controller == "Command" &&
            action == "Getcommandss");

}
