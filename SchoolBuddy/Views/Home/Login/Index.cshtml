    <section class="vh-100">
        <div class="container-fluid">
            <div class="row">
                <div class="col-sm-5 text-black vh-100" style="background-color:rgba(255,255,255,0.60);overflow-y:hidden">

                    <div class="px-5 ms-xl-4">
                        <i class="fas fa-crow fa-2x me-3 pt-5 mt-xl-4" style="color: #709085;"></i>
                        @*<span class="h1 fw-bold mb-0">Logo</span>*@
                    </div>

                    <div class="d-flex align-items-center justify-content-center h-custom-2 px-5  mt-5 pt-5 pt-xl-0 mt-xl-n5">

                        <form style="width: 23rem;" asp-action="Index" asp-controller="Home" method="post" id="loginForm">
                            <div class="d-flex">
                                <img src="~/images/school-buddy-logo.png" style="margin-left:auto;margin-right:auto" />
                            </div>
                         
                            <h3 class="fw-normal mb-3 pb-3 " style="letter-spacing: 1px;text-align:center">Login into your account</h3>

                            <div data-mdb-input-init class="form-outline mb-4">
                                <label asp-for="username" class="form-label" >User Name</label>
                                <input asp-for="username" name="username" type="text" class="form-control form-control-lg" placeholder="Enter Username" />
                                <div>
                                    <span asp-validation-for="username" class="text-danger"></span>
                                </div>
                                
                                
                            </div>

                            <div data-mdb-input-init class="form-outline mb-4">
                                <label asp-for="password" class="form-label">Password</label>
                                <input asp-for="password" name="password" type="password" class="form-control form-control-lg" placeholder="Enter Password" />
                                
                            </div>
                            <div>
                                <span asp-validation-for="password" class="text-danger"></span>
                            </div>

                            <div class="pt-1 mb-4">
                                <button data-mdb-button-init data-mdb-ripple-init class="w-100 btn btn-info btn-sm btn-block" type="submit">Login</button>
                            </div>

                            <p class="small mb-5 pb-lg-2 d-flex"><a class="text-muted" style="margin-left:auto" href="#!">Forgot password?</a></p>
                            @*<p>Don't have an account? <a href="#!" class="link-info">Register here</a></p>
*@
                            <div class="d-flex justify-content-between mt-3" style="border-top:1px solid grey;">
                                <p><a class="text-muted" style="text-decoration: none; cursor:pointer; font-size: 12px; font-weight:700;" asp-controller="Contact" asp-action="Index">Contact Us</a></p>
                                <p><a class="text-muted" style="text-decoration: none; cursor:pointer; font-size: 12px; font-weight:700;" asp-controller="Privacy" asp-action="Index">Privacy Policy</a></p>
                            </div>
                        </form>

                    </div>

                </div>
                @*<div class="col-sm-7 px-0 d-none d-sm-none d-md-none">*@
                <div class="col-sm-7 d-none d-lg-block">
                   @* <img src="https://mdbcdn.b-cdn.net/img/Photos/new-templates/bootstrap-login-form/img3.webp"
                         alt="Login image" class="w-100 vh-100" style="object-fit: cover; object-position: left;">*@
                </div>
                
            </div>
        </div>
    </section>






    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        window.onload = function () {
            document.getElementById('loginForm').reset();
        }

    </script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/sweetalert2/11.11.0/sweetalert2.min.js" integrity="sha512-Wi5Ms24b10EBwWI9JxF03xaAXdwg9nF51qFUDND/Vhibyqbelri3QqLL+cXCgNYGEgokr+GA2zaoYaypaSDHLg==" crossorigin="anonymous" referrerpolicy="no-referrer"></script>
    @if (ViewData["status"] != null)
    {
        if (ViewData["status"] != "success")
        {

            <script>swal.fire("Username or password is incorrect")</script>

        }

    }
    <script>

        // Disable browser back

        history.pushState(null, null, location.href);

        window.onpopstate = function () {

        history.go(1);

        };

    </script>
