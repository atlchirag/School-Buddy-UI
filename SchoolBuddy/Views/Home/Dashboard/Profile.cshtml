        }

    .profile-secure-actions {
        display: flex;
        align-items: center;
        justify-content: flex-end;
        gap: 10px;
        margin-top: 24px;
    }

    .profile-otp-control {
        min-height: 52px;
        text-align: center;
        font-size: 1.2rem;
        font-weight: 700;
        letter-spacing: 0.55rem;
    }

        .profile-otp-control::placeholder {
