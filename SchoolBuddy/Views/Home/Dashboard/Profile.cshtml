    }

    .limit-title-wrapper {
        display: flex;
        align-items: center;
        gap: 10px;
    }

    .limit-icon {
        width: 38px;
        height: 38px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
        color: midnightblue;
        background: rgba(25, 25, 112, 0.09);
        border-radius: 11px;
        font-size: 1rem;
    }

    .limit-title {
        margin: 0;
        color: #0f172a;
        font-size: 0.83rem;
        font-weight: 700;
    }

    .limit-subtitle {
        color: #94a3b8;
        font-size: 0.68rem;
    }

    .limit-number {
