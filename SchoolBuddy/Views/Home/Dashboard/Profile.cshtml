            text-decoration: underline;
        }

    .profile-secure-status:empty {
        display: none;
    }

    .profile-information-grid {
        display: grid;
        grid-template-columns: repeat(4, minmax(0, 1fr));
    }

    .profile-information-column {
        min-width: 0;
        padding: 4px 18px;
        border-left: 1px solid #cbd5e1;
    }

        .profile-information-column:first-child {
            padding-left: 0;
            border-left: none;
        }

    .profile-detail-row {
        display: flex;
        align-items: flex-start;
        gap: 7px;
        margin-bottom: 9px;
        color: #64748b;
        font-size: 0.82rem;
    }

        .profile-detail-row:last-child {
            margin-bottom: 0;
        }

    .profile-detail-label {
        flex-shrink: 0;
    }

    .profile-detail-value {
        min-width: 0;
        color: #0f172a;
        font-weight: 600;
