@model SchoolBuddy.Models.ProfileApiResponse

@{
    ViewData["Title"] = "My Profile";

    var profile = Model?.data?.profile ?? new SchoolBuddy.Models.SchoolProfile();
    var limits = Model?.data?.limits ?? new SchoolBuddy.Models.ProfileLimits();
    var settings = Model?.data?.settings ?? new SchoolBuddy.Models.ProfileSettings();
    var maps = Model?.data?.maps?.list ?? new List<SchoolBuddy.Models.MapItem>();

    string fullName = string.IsNullOrWhiteSpace(profile.full_name)
        ? "N/A"
        : profile.full_name.Trim();

    string companyName = string.IsNullOrWhiteSpace(profile.company_name)
        ? "N/A"
        : profile.company_name.Trim();

    string mobile = string.IsNullOrWhiteSpace(profile.mobile)
        ? "N/A"
        : profile.mobile.Trim();

    string email = string.IsNullOrWhiteSpace(profile.email)
        ? "N/A"
        : profile.email.Trim();

    string timezone = string.IsNullOrWhiteSpace(profile.timezone)
        ? "N/A"
        : profile.timezone.Trim();

    string language = string.IsNullOrWhiteSpace(profile.language)
        ? "N/A"
        : profile.language.Trim();

    string currency = string.IsNullOrWhiteSpace(profile.currency)
        ? "N/A"
        : profile.currency.Trim();

    string address = string.IsNullOrWhiteSpace(profile.address)
        ? "N/A"
        : profile.address.Trim();

    string profileImage = string.IsNullOrWhiteSpace(profile.profile_url)
        ? Url.Content("~/assets/img/profile.png")
        : profile.profile_url;

    int deviceUsed = limits.added_device;
    int smsUsed = limits.used_sms;
    int subUserUsed = limits.added_subuser;
    int emailUsed = limits.used_email;

    int devicePercentage = limits.device_limit > 0
        ? Math.Min(100, (deviceUsed * 100) / limits.device_limit)
        : 0;

    int smsPercentage = limits.message_limit > 0
        ? Math.Min(100, (smsUsed * 100) / limits.message_limit)
        : 0;

    int subUserPercentage = limits.sub_user_limit > 0
        ? Math.Min(100, (subUserUsed * 100) / limits.sub_user_limit)
        : 0;

    int emailPercentage = limits.email_limit > 0
        ? Math.Min(100, (emailUsed * 100) / limits.email_limit)
        : 0;
}

<style>
    .profile-page {
        padding: 18px;
    }

    .profile-card {
        background: #ffffff;
        border: 1px solid #edf0f5;
        border-radius: 18px;
        box-shadow: 0 8px 25px rgba(15, 23, 42, 0.07);
    }

    .profile-header-card {
        padding: 28px;
    }

    .profile-image-wrapper {
        position: relative;
        width: 108px;
        height: 108px;
        flex-shrink: 0;
    }

    .profile-image {
        width: 108px;
        height: 108px;
        object-fit: cover;
        border-radius: 50%;
        border: 4px solid #ffffff;
        box-shadow: 0 6px 18px rgba(15, 23, 42, 0.15);
        background: #f8fafc;
    }

    .profile-camera-btn {
        position: absolute;
        right: -1px;
        bottom: 5px;
        width: 34px;
        height: 34px;
        padding: 0;
        display: flex;
        align-items: center;
        justify-content: center;
        color: #ffffff;
        background: midnightblue;
        border: 3px solid #ffffff;
        border-radius: 50%;
        box-shadow: 0 4px 10px rgba(15, 23, 42, 0.2);
    }

        .profile-camera-btn:hover {
            color: #ffffff;
            background: #10105c;
        }

    .profile-school-name {
        margin-bottom: 4px;
        color: #0f172a;
        font-size: 1.45rem;
        font-weight: 700;
    }

    .profile-company-name {
        margin-bottom: 22px;
        color: #94a3b8;
        font-size: 0.85rem;
    }

    .profile-heading-row {
        display: flex;
        align-items: flex-start;
        justify-content: space-between;
        gap: 20px;
    }

    .profile-edit-button {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 7px;
        flex-shrink: 0;
        padding: 9px 16px;
        color: #ffffff;
        background: midnightblue;
        border-color: midnightblue;
        border-radius: 10px;
        box-shadow: 0 5px 14px rgba(25, 25, 112, 0.2);
        font-size: 0.82rem;
        font-weight: 600;
    }

        .profile-edit-button:hover,
        .profile-edit-button:focus {
            color: #ffffff;
            background: #10105c;
            border-color: #10105c;
        }

    .profile-edit-label {
        margin-bottom: 7px;
        color: #334155;
        font-size: 0.78rem;
        font-weight: 700;
    }

    .profile-edit-photo-section {
