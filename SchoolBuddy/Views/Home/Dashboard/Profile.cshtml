        padding: 9px 16px;
        border-radius: 10px;
        font-size: 0.82rem;
        font-weight: 700;
    }

    .profile-edit-secondary-button {
        color: #475569;
        background: #ffffff;
        border-color: #cbd5e1;
    }

    .profile-edit-primary-button {
        color: #ffffff;
        background: midnightblue;
        border-color: midnightblue;
    }

        .profile-edit-primary-button:hover,
        .profile-edit-primary-button:focus {
            color: #ffffff;
            background: #10105c;
            border-color: #10105c;
        }

    .profile-edit-form-message {
        display: none;
        flex: 1 1 auto;
        margin: 0;
        color: #64748b;
        font-size: 0.76rem;
    }

        .profile-edit-form-message.has-message {
            display: block;
        }

    .profile-secure-intro {
        margin-bottom: 20px;
        color: #64748b;
        font-size: 0.84rem;
        line-height: 1.55;
    }

    .profile-secure-current {
        margin-bottom: 22px;
        padding: 13px 15px;
        background: #f8fafc;
        border: 1px solid #e8edf4;
        border-radius: 11px;
    }

    .profile-secure-current-label {
        display: block;
        margin-bottom: 3px;
        color: #94a3b8;
        font-size: 0.67rem;
