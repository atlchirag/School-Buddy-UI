        border-radius: 20px;
        overflow: hidden;
    }

    .limit-progress-bar {
        height: 100%;
        background: midnightblue;
        border-radius: 20px;
    }

    .limit-statistics {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 6px;
    }

    .limit-stat {
        text-align: center;
    }

    .limit-stat-label {
        display: block;
        margin-bottom: 3px;
        color: #94a3b8;
        font-size: 0.62rem;
        text-transform: uppercase;
    }

    .limit-stat-value {
        color: #0f172a;
        font-size: 0.78rem;
        font-weight: 700;
    }

    .billing-grid {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 0;
    }

    .billing-column {
        padding: 2px 24px;
        border-left: 1px solid #e2e8f0;
    }

        .billing-column:first-child {
            padding-left: 0;
            border-left: none;
        }

    .billing-row {
        display: flex;
        align-items: flex-start;
        gap: 7px;
        margin-bottom: 18px;
        color: #64748b;
        font-size: 0.8rem;
    }

    .billing-value {
        color: #0f172a;
        font-weight: 700;
        overflow-wrap: anywhere;
    }

    .settings-card {
        padding: 22px;
    }

    .settings-title {
        margin-bottom: 18px;
        color: #0f172a;
        font-size: 1rem;
        font-weight: 700;
    }

    .settings-item {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
        padding: 13px 0;
        border-bottom: 1px solid #edf0f5;
    }

        .settings-item:last-child {
            padding-bottom: 0;
            border-bottom: none;
        }

    .settings-label {
        color: #64748b;
        font-size: 0.78rem;
    }

    .settings-value {
        color: #0f172a;
        font-size: 0.8rem;
        font-weight: 700;
        text-align: right;
    }

    @@media (max-width: 1199.98px) {
        .profile-information-grid {
            grid-template-columns: repeat(2, minmax(0, 1fr));
            gap: 18px 0;
        }

        .profile-information-column:nth-child(3) {
            padding-left: 0;
            border-left: none;
        }
    }

    @@media (max-width: 767.98px) {
        .profile-page {
            padding: 12px;
        }

        .profile-header-card {
            padding: 20px;
        }

        .profile-header-layout {
            flex-direction: column;
            align-items: flex-start !important;
        }

        .profile-image-wrapper,
        .profile-image {
            width: 90px;
            height: 90px;
        }

        .profile-school-name {
            font-size: 1.15rem;
        }

        .profile-heading-row {
            align-items: stretch;
            flex-direction: column;
            gap: 0;
        }

        .profile-edit-button {
            width: 100%;
            margin-bottom: 20px;
        }

        .profile-edit-form-message {
            flex-basis: 100%;
            width: 100%;
            text-align: center;
        }

        .profile-edit-photo-section {
            align-items: flex-start;
        }

        .profile-edit-secondary-button,
        .profile-edit-primary-button {
            flex: 1 1 0;
            min-width: 0;
        }

        .profile-secure-actions .profile-edit-secondary-button,
        .profile-secure-actions .profile-edit-primary-button {
            flex: 1 1 0;
        }

        .profile-information-grid {
            grid-template-columns: 1fr;
        }

        .profile-information-column,
        .profile-information-column:nth-child(3) {
            padding: 0 0 13px;
            border-left: none;
            border-bottom: 1px solid #e2e8f0;
        }

            .profile-information-column:last-child {
                padding-bottom: 0;
                border-bottom: none;
            }

        .limit-grid,
        .billing-grid {
            grid-template-columns: 1fr;
        }

        .billing-column {
            padding: 14px 0;
            border-left: none;
            border-bottom: 1px solid #e2e8f0;
        }

            .billing-column:first-child {
                padding-top: 0;
            }

            .billing-column:last-child {
                border-bottom: none;
            }
    }

    @@media (max-width: 399.98px) {
        .profile-edit-photo-section {
            align-items: center;
            flex-direction: column;
            text-align: center;
        }

        .profile-edit-photo-button {
            width: 100%;
        }

        .profile-sensitive-input-group {
            display: flex;
            flex-wrap: wrap;
            gap: 8px;
        }

        .profile-sensitive-input-group .profile-edit-control,
        .profile-sensitive-input-group .profile-change-button {
            width: 100%;
            border-radius: 10px;
        }

        .profile-secure-actions {
            align-items: stretch;
            flex-direction: column-reverse;
        }

        .profile-secure-actions .btn {
            width: 100%;
        }

        .profile-otp-control {
            padding-right: 8px;
            padding-left: 8px;
            letter-spacing: 0.35rem;
        }
    }
    /* Edit Profile Modal - Scrollable */
#editProfileModal .modal-content {
    max-height: calc(100vh - 2rem);
    overflow: hidden;
}

#editProfileModal #editProfileForm {
    display: flex;
    flex-direction: column;
    min-height: 0;
    max-height: calc(100vh - 2rem);
}

#editProfileModal .modal-header {
    flex-shrink: 0;
}

#editProfileModal .modal-body {
    flex: 1 1 auto;
    min-height: 0;
    overflow-y: auto;
    overflow-x: hidden;
}

#editProfileModal .modal-footer {
    flex-shrink: 0;
}

/* Scrollbar */
#editProfileModal .modal-body::-webkit-scrollbar {
    width: 6px;
}

#editProfileModal .modal-body::-webkit-scrollbar-track {
    background: #f1f1f1;
}

#editProfileModal .modal-body::-webkit-scrollbar-thumb {
    background: #b6b6b6;
    border-radius: 10px;
}

#editProfileModal .modal-body::-webkit-scrollbar-thumb:hover {
    background: #909090;
}
</style>

<div class="profile-page">

    @if (!string.IsNullOrWhiteSpace(ViewBag.ErrorMessage))
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i>
            @ViewBag.ErrorMessage

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert"
                    aria-label="Close">
            </button>
        </div>
    }

    <!-- Profile header -->
    <section class="profile-card profile-header-card mb-4">
        <div class="profile-header-layout d-flex align-items-center gap-4">

            <div class="profile-image-wrapper">
                <img src="@profileImage"
                     id="schoolProfileImage"
                     class="profile-image"
                     alt="@fullName"
                     onerror="this.onerror=null; this.src='@Url.Content("~/assets/img/profile.png")';" />

                
            </div>

            <div class="flex-grow-1 w-100">
                <div class="profile-heading-row">
                    <div>
                        <h1 class="profile-school-name">@fullName</h1>

                        <p class="profile-company-name">@companyName</p>
                    </div>

                    <button type="button"
                            class="btn profile-edit-button"
                            onclick="openPasswordVerificationModal()">
                        <i class="bi bi-pencil-square" aria-hidden="true"></i>
                        <span>Edit Profile</span>
                    </button>
                </div>

                <div class="profile-information-grid">

                    <div class="profile-information-column">
                        <div class="profile-detail-row">
                            <span class="profile-detail-label">Name:</span>
                            <span class="profile-detail-value">@fullName</span>
                        </div>

                        <div class="profile-detail-row">
                            <span class="profile-detail-label">Company:</span>
                            <span class="profile-detail-value">@companyName</span>
                        </div>
                    </div>

                    <div class="profile-information-column">
                        <div class="profile-detail-row">
                            <span class="profile-detail-label">Mobile:</span>
                            <span class="profile-detail-value">@mobile</span>
                        </div>

                        <div class="profile-detail-row">
                            <span class="profile-detail-label">Email:</span>
                            <span class="profile-detail-value">@email</span>
                        </div>
                    </div>

                    <div class="profile-information-column">
                        <div class="profile-detail-row">
                            <span class="profile-detail-label">Timezone:</span>
                            <span class="profile-detail-value">@timezone</span>
                        </div>

                        <div class="profile-detail-row">
                            <span class="profile-detail-label">Language:</span>
                            <span class="profile-detail-value">@language</span>
                        </div>
                    </div>

                    <div class="profile-information-column">
                        <div class="profile-detail-row">
                            <span class="profile-detail-label">Currency:</span>
                            <span class="profile-detail-value">@currency</span>
                        </div>

                        <div class="profile-detail-row">
                            <span class="profile-detail-label">Address:</span>
