    }

    .profile-edit-photo-title {
        margin-bottom: 4px;
        color: #0f172a;
        font-size: 0.85rem;
        font-weight: 700;
    }

    .profile-edit-photo-note {
        margin-bottom: 10px;
        color: #94a3b8;
        font-size: 0.7rem;
    }

    .profile-edit-photo-button {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 6px;
        color: midnightblue;
        background: #ffffff;
        border-color: midnightblue;
        border-radius: 9px;
        font-size: 0.76rem;
        font-weight: 700;
    }

        .profile-edit-photo-button:hover,
        .profile-edit-photo-button:focus {
            color: #ffffff;
            background: midnightblue;
            border-color: midnightblue;
        }

    .profile-edit-control {
        min-height: 43px;
