<!-- Edit profile modal submitted through the profile controller. -->
<div class="modal fade sb-common-modal profile-edit-modal"
     id="editProfileModal"
     tabindex="-1"
     aria-labelledby="editProfileModalLabel"
     aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered modal-dialog-scrollable">
        <div class="modal-content">
            <form id="editProfileForm" novalidate onsubmit="saveProfileChanges(event)">
                @Html.AntiForgeryToken()

                <div class="modal-header profile-edit-modal-header">
                    <h2 class="modal-title" id="editProfileModalLabel">
                        <i class="bi bi-person-gear" aria-hidden="true"></i>
                        Edit Profile
                    </h2>

                    <button type="button"
                            class="btn-close"
                            data-bs-dismiss="modal"
                            aria-label="Close">
                    </button>
                </div>

                <div class="modal-body">
                    <div class="profile-edit-photo-section">
                        <img src="@profileImage"
                             id="editProfileImagePreview"
                             class="profile-edit-photo-preview"
                             data-current-src="@profileImage"
                             alt="Profile image preview"
                             onerror="this.onerror=null; this.src='@Url.Content("~/assets/img/profile.png")';" />

                        <div class="profile-edit-photo-content">
                            <div class="profile-edit-photo-title">Profile Picture</div>
                            <p class="profile-edit-photo-note">
                                JPG or PNG, maximum 2 MB. Uploaded when you save changes.
                            </p>

                            <button type="button"
                                    class="btn profile-edit-photo-button"
                                    onclick="document.getElementById('editProfileImageInput').click()">
                                <i class="bi bi-camera-fill" aria-hidden="true"></i>
                                Change Photo
                            </button>

                            <input type="file"
                                   id="editProfileImageInput"
                                   accept=".jpg,.jpeg,.png,image/jpeg,image/png"
                                   hidden
                                   onchange="previewEditProfileImage(this)" />

                            <div class="profile-field-error text-danger small"
                                 id="profileImageError"
                                 role="alert">
                            </div>
                        </div>
                    </div>

                    <div class="row g-3">
                        <div class="col-md-6">
                            <label for="profileFullName" class="form-label profile-edit-label">
                                Full Name
                            </label>

                            <input type="text"
                                   class="form-control profile-edit-control"
                                   id="profileFullName"
                                   name="full_name"
                                   value="@profile.full_name"
                                   data-profile-field
                                   data-field="full_name"
                                   data-current="@profile.full_name"
                                   autocomplete="name"
                                   maxlength="150"
                                   required />

                            <div class="profile-field-error text-danger small"
                                 id="fullNameError"
                                 role="alert">
                            </div>
                        </div>

                        <div class="col-md-6">
                            <label for="profileCompanyName" class="form-label profile-edit-label">
                                Company Name
                            </label>

                            <input type="text"
                                   class="form-control profile-edit-control"
                                   id="profileCompanyName"
                                   name="company_name"
                                   value="@profile.company_name"
                                   data-profile-field
                                   data-field="company_name"
                                   data-current="@profile.company_name"
                                   autocomplete="organization"
                                   maxlength="200" />

                            <div class="profile-field-error text-danger small"
                                 id="companyError"
                                 role="alert">
                            </div>
                        </div>

                        <div class="col-md-6">
                            <label for="profileMobile" class="form-label profile-edit-label">
                                Mobile Number
                            </label>

                            <input type="tel"
                                   class="form-control profile-edit-control"
                                   id="profileMobile"
                                   name="mobile"
                                   value="@profile.mobile"
                                   data-profile-field
                                   data-field="mobile"
                                   data-current="@profile.mobile"
                                   autocomplete="tel"
                                   inputmode="numeric"
                                   maxlength="15"
                                   required />

                            <div class="profile-field-error text-danger small"
                                 id="mobileError"
                                 role="alert">
                            </div>

                        </div>

                        <div class="col-md-6">
                            <label for="profileEmail" class="form-label profile-edit-label">
                                Email
                            </label>

                            <input type="email"
                                   class="form-control profile-edit-control"
                                   id="profileEmail"
                                   name="email"
                                   value="@profile.email"
                                   data-profile-field
                                   data-field="email"
                                   data-current="@profile.email"
                                   autocomplete="email"
                                   maxlength="254"
                                   required />

                            <div class="profile-field-error text-danger small"
                                 id="emailError"
                                 role="alert">
                            </div>

                        </div>

                        <div class="col-md-6">
                            <label for="profileTimezone" class="form-label profile-edit-label">
                                Timezone
                            </label>

                            <input type="text"
                                   class="form-control profile-edit-control"
                                   id="profileTimezone"
                                   name="timezone"
                                   value="@profile.timezone"
                                   maxlength="100"
                                   readonly
                                   aria-describedby="timezoneUnsupportedNote" />

                            <div class="profile-field-error text-danger small"
                                 id="timezoneError"
                                 role="alert">
                            </div>

                            <div class="profile-unsupported-note" id="timezoneUnsupportedNote">
                                Update mapping is not configured yet.
                            </div>
                        </div>

                        <div class="col-md-6">
                            <label for="profileLanguage" class="form-label profile-edit-label">
                                Language
                            </label>

                            <input type="text"
                                   class="form-control profile-edit-control"
                                   id="profileLanguage"
                                   name="language"
                                   value="@profile.language"
                                   maxlength="100"
                                   readonly
                                   aria-describedby="languageUnsupportedNote" />

                            <div class="profile-field-error text-danger small"
                                 id="languageError"
                                 role="alert">
                            </div>

                            <div class="profile-unsupported-note" id="languageUnsupportedNote">
                                Update mapping is not configured yet.
                            </div>
                        </div>

                        <div class="col-md-6">
                            <label for="profileCurrency" class="form-label profile-edit-label">
                                Currency
                            </label>

                            <input type="text"
                                   class="form-control profile-edit-control"
                                   id="profileCurrency"
                                   name="currency"
                                   value="@profile.currency"
                                   maxlength="50"
                                   readonly
                                   aria-describedby="currencyUnsupportedNote" />

                            <div class="profile-field-error text-danger small"
                                 id="currencyError"
                                 role="alert">
                            </div>

                            <div class="profile-unsupported-note" id="currencyUnsupportedNote">
                                Update mapping is not configured yet.
                            </div>
                        </div>

                        <div class="col-12">
                            <label for="profileAddress" class="form-label profile-edit-label">
                                Address
                            </label>

                            <textarea class="form-control profile-edit-control"
                                      id="profileAddress"
                                      name="address"
                                      data-profile-field
                                      data-field="address"
                                      data-current="@profile.address"
                                      autocomplete="street-address"
                                      maxlength="500">@profile.address</textarea>

                            <div class="profile-field-error text-danger small"
                                 id="addressError"
                                 role="alert">
                            </div>
                        </div>
                    </div>
                </div>

                <div class="modal-footer">
                    <p class="profile-edit-form-message"
                       id="profileEditFormMessage"
                       role="status"
                       aria-live="polite">
                    </p>

                    <button type="button"
                            class="btn profile-edit-secondary-button"
                            data-bs-dismiss="modal">
                        Cancel
                    </button>

                    <button type="submit"
                            id="saveProfileChangesButton"
                            class="btn profile-edit-primary-button">
                        Save Changes
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Password verification is required before the edit form opens. -->
<div class="modal fade sb-common-modal profile-secure-modal"
     id="profilePasswordModal"
     tabindex="-1"
     aria-labelledby="profilePasswordModalLabel"
     aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header profile-edit-modal-header">
                <h2 class="modal-title" id="profilePasswordModalLabel">
                    <i class="bi bi-shield-lock" aria-hidden="true"></i>
                    Verify Password
                </h2>

                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="modal"
                        aria-label="Close">
                </button>
            </div>

            <div class="modal-body">
                <p class="profile-secure-intro">
                    Verify your current password before editing your profile.
                </p>

                <label for="profileCurrentPassword" class="form-label profile-edit-label">
