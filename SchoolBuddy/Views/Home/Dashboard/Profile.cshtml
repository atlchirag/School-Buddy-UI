<!-- OTP is requested only for sensitive fields changed in the edit form. -->
<div class="modal fade sb-common-modal profile-secure-modal"
     id="profileOtpModal"
     tabindex="-1"
     aria-labelledby="profileOtpModalLabel"
     aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header profile-edit-modal-header">
                <h2 class="modal-title" id="profileOtpModalLabel">
                    Verify Sensitive Changes
                </h2>

                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="modal"
                        aria-label="Close">
                </button>
            </div>

            <div class="modal-body">
                <p class="profile-secure-intro" id="profileOtpInstruction">
                    Enter the OTP sent for the changed contact information.
                </p>

                <div id="profileMobileOtpGroup" class="profile-otp-group d-none">
                    <div class="profile-secure-current">
                        <span class="profile-secure-current-label">New Mobile</span>
                        <span class="profile-secure-current-value"
                              id="profileOtpMobileTarget">
                        </span>
                    </div>

                    <label for="profileMobileOtp" class="form-label profile-edit-label">
                        Mobile OTP
                    </label>

                    <input type="text"
                           class="form-control profile-edit-control profile-otp-control"
                           id="profileMobileOtp"
                           inputmode="numeric"
                           autocomplete="one-time-code"
                           maxlength="6"
                           placeholder="000000" />

                    <div class="profile-field-error text-danger small"
                         id="mobileOtpError"
                         role="alert">
                    </div>

                    <div class="profile-secure-status text-success small"
                         id="mobileOtpStatus"
                         role="status">
                    </div>

                    <button type="button"
                            class="btn btn-link profile-resend-button mt-2"
                            id="resendMobileOtpButton"
                            onclick="resendProfileOtp('mobile')">
                        Resend Mobile OTP
                    </button>
                </div>

                <div id="profileEmailOtpGroup" class="profile-otp-group d-none">
                    <div class="profile-secure-current">
                        <span class="profile-secure-current-label">New Email</span>
                        <span class="profile-secure-current-value"
                              id="profileOtpEmailTarget">
                        </span>
                    </div>

                    <label for="profileEmailOtp" class="form-label profile-edit-label">
                        Email OTP
                    </label>

                    <input type="text"
                           class="form-control profile-edit-control profile-otp-control"
                           id="profileEmailOtp"
                           inputmode="numeric"
                           autocomplete="one-time-code"
                           maxlength="6"
                           placeholder="000000" />

                    <div class="profile-field-error text-danger small"
                         id="emailOtpError"
                         role="alert">
                    </div>

                    <div class="profile-secure-status text-success small"
                         id="emailOtpStatus"
                         role="status">
                    </div>

                    <button type="button"
                            class="btn btn-link profile-resend-button mt-2"
                            id="resendEmailOtpButton"
                            onclick="resendProfileOtp('email')">
                        Resend Email OTP
                    </button>
                </div>

                <div class="profile-field-error text-danger small"
                     id="otpError"
                     role="alert">
                </div>

                <div class="profile-secure-actions">
                    <button type="button"
                            class="btn profile-edit-secondary-button"
                            data-bs-dismiss="modal">
                        Back
                    </button>

                    <button type="button"
                            class="btn profile-edit-primary-button"
                            id="verifyProfileOtpButton"
                            onclick="verifyChangedProfileOtps()">
                        Verify &amp; Save
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

<div id="profileEditEndpoints"
     data-validate-password-url="@Url.Action("VerifyProfilePassword", "Profile")"
     data-send-otp-url="@Url.Action("SendProfileOtp", "Profile")"
     data-verify-otp-url="@Url.Action("VerifyProfileOtp", "Profile")"
     data-update-field-url="@Url.Action("UpdateProfileField", "Profile")"
     data-update-image-url="@Url.Action("UpdateProfileImage", "Profile")"
     hidden>
</div>

<script>
    const editProfileModalElement = document.getElementById("editProfileModal");
    const profilePasswordModalElement =
        document.getElementById("profilePasswordModal");
    const profileOtpModalElement = document.getElementById("profileOtpModal");
    const endpointElement = document.getElementById("profileEditEndpoints");

    const profileEditEndpoints = {
        validatePassword: endpointElement.dataset.validatePasswordUrl,
        sendOtp: endpointElement.dataset.sendOtpUrl,
        verifyOtp: endpointElement.dataset.verifyOtpUrl,
        updateField: endpointElement.dataset.updateFieldUrl,
        updateImage: endpointElement.dataset.updateImageUrl
    };

    const supportedProfileFields = new Set([
        "full_name",
        "company_name",
        "address",
        "mobile",
        "email"
    ]);

    const sensitiveProfileFields = new Set(["mobile", "email"]);

    const profileFieldErrorMap = {
        full_name: ["fullNameError", "profileFullName"],
        company_name: ["companyError", "profileCompanyName"],
        address: ["addressError", "profileAddress"],
        mobile: ["mobileError", "profileMobile"],
        email: ["emailError", "profileEmail"],
        profile_image: ["profileImageError", null]
    };

    const otpElementMap = {
        mobile: {
            groupId: "profileMobileOtpGroup",
            targetId: "profileOtpMobileTarget",
            inputId: "profileMobileOtp",
            errorId: "mobileOtpError",
            statusId: "mobileOtpStatus",
            resendButtonId: "resendMobileOtpButton"
        },
        email: {
            groupId: "profileEmailOtpGroup",
            targetId: "profileOtpEmailTarget",
            inputId: "profileEmailOtp",
            errorId: "emailOtpError",
            statusId: "emailOtpStatus",
            resendButtonId: "resendEmailOtpButton"
        }
    };

    let selectedProfileImageFile = null;
    const maximumProfileImageSize = 2 * 1024 * 1024;
    const allowedProfileImageTypes = new Set(["image/jpeg", "image/png"]);
    const allowedProfileImageExtensions = new Set(["jpg", "jpeg", "png"]);
    let pendingProfileChanges = [];
    let requiredOtpTypes = [];
    let verifiedOtpTypes = new Set();
    let passwordTransitionToEdit = false;
    let editTransitionToOtp = false;
    let otpReturnToEdit = false;

    function getProfileModalInstance(modalElement) {
        return bootstrap.Modal.getInstance(modalElement) ||
            new bootstrap.Modal(modalElement);
    }

    function getAntiForgeryToken() {
        return document.querySelector(
            "#editProfileForm input[name='__RequestVerificationToken']"
        )?.value || "";
    }

    async function postProfileJson(url, payload) {
        return requestProfileEndpoint(url, {
            method: "POST",
            headers: {
                "Content-Type": "application/json",
                "RequestVerificationToken": getAntiForgeryToken()
            },
            body: JSON.stringify(payload)
        });
    }

    async function requestProfileEndpoint(url, options) {
        let response;

        try {
            response = await fetch(url, options);
        } catch (networkError) {
            const error = new Error(
                "Unable to contact the server. Please check your connection and try again."
            );
            error.payload = null;
            throw error;
        }

        let payload = null;

        try {
            payload = await response.json();
        } catch (parseError) {
            payload = {
                success: false,
                message: "The server returned an invalid response."
            };
        }

        if (!response.ok || payload?.success !== true) {
            const error = new Error(
                payload?.message ||
                "Unable to complete the request. Please try again."
            );
            error.payload = payload;
            error.status = response.status;
            throw error;
        }

        return payload;
    }

    function setButtonLoading(buttonId, isLoading, loadingText) {
        const button = document.getElementById(buttonId);

        if (!button) {
            return;
        }

        if (!button.dataset.defaultContent) {
            button.dataset.defaultContent = button.innerHTML;
        }

        button.disabled = isLoading;
        button.innerHTML = isLoading
            ? '<span class="spinner-border spinner-border-sm me-2" aria-hidden="true"></span>' +
                loadingText
            : button.dataset.defaultContent;
    }

    function setFieldError(errorId, message, inputId) {
        const errorElement = document.getElementById(errorId);

        if (!errorElement) {
            return;
        }

        errorElement.textContent = message || "";
        errorElement.classList.toggle("has-error", Boolean(message));

        if (inputId) {
            document.getElementById(inputId)?.classList.toggle(
                "is-invalid",
                Boolean(message)
            );
        }
    }

    function clearFieldError(errorId, inputId) {
        setFieldError(errorId, "", inputId);
    }

    function showProfileFieldError(field, message) {
        const mapping = profileFieldErrorMap[field];

        if (mapping) {
            setFieldError(mapping[0], message, mapping[1]);
        }
    }

    function clearProfileErrors() {
        Object.values(profileFieldErrorMap).forEach(function (mapping) {
            clearFieldError(mapping[0], mapping[1]);
        });

        clearFieldError("timezoneError", "profileTimezone");
        clearFieldError("languageError", "profileLanguage");
        clearFieldError("currencyError", "profileCurrency");
    }

    function setProfileFormMessage(message) {
        const messageElement = document.getElementById("profileEditFormMessage");
        messageElement.textContent = message || "";
        messageElement.classList.toggle("has-message", Boolean(message));
    }

    function openPasswordVerificationModal() {
        resetProfileForm();
        resetProfilePasswordModal();
        resetProfileOtpModal();
        getProfileModalInstance(profilePasswordModalElement).show();
    }

    function submitProfilePasswordOnEnter(event) {
        if (event.key === "Enter") {
            event.preventDefault();
            verifyProfilePassword();
        }
    }

    async function verifyProfilePassword() {
        const passwordInput = document.getElementById(
            "profileCurrentPassword"
        );
        const verifyButton = document.getElementById(
            "verifyProfilePasswordButton"
        );

        if (verifyButton.disabled) {
            return;
        }

        clearFieldError("passwordError", "profileCurrentPassword");

        if (!passwordInput.value) {
            setFieldError(
                "passwordError",
                "Please enter your current password.",
                "profileCurrentPassword"
            );
            passwordInput.focus();
            return;
        }

        setButtonLoading(
            "verifyProfilePasswordButton",
            true,
            "Verifying..."
        );

        try {
            await postProfileJson(
                profileEditEndpoints.validatePassword,
                { currentPassword: passwordInput.value }
            );

            passwordTransitionToEdit = true;
            getProfileModalInstance(profilePasswordModalElement).hide();
        } catch (error) {
            setFieldError(
                "passwordError",
                error.message || "Unable to verify your password.",
                "profileCurrentPassword"
            );
            passwordInput.focus();
        } finally {
            setButtonLoading(
                "verifyProfilePasswordButton",
                false,
                ""
            );
        }
    }

    async function previewEditProfileImage(input) {
        clearFieldError("profileImageError");

        if (!input.files || !input.files[0]) {
            selectedProfileImageFile = null;
            resetEditProfileImagePreview();
            return;
        }

        const file = input.files[0];
        const extension = file.name.includes(".")
            ? file.name.split(".").pop().toLowerCase()
            : "";

        if (!allowedProfileImageTypes.has(file.type) ||
            !allowedProfileImageExtensions.has(extension)) {
            rejectProfileImageSelection(
                input,
                "Only JPG and PNG images are allowed."
            );
            return;
        }

        if (file.size > maximumProfileImageSize) {
            rejectProfileImageSelection(
                input,
                "Image size must be 2 MB or less."
            );
            return;
        }

        if (file.size === 0) {
            rejectProfileImageSelection(
                input,
                "Only JPG and PNG images are allowed."
            );
            return;
        }

        let signature;

        try {
            signature = new Uint8Array(
                await file.slice(0, 8).arrayBuffer()
            );
        } catch (error) {
            rejectProfileImageSelection(
                input,
                "Unable to read the selected image. Please try again."
            );
            return;
        }

        const hasJpegSignature = signature.length >= 3 &&
            signature[0] === 0xFF &&
            signature[1] === 0xD8 &&
            signature[2] === 0xFF;
        const pngSignature = [
            0x89, 0x50, 0x4E, 0x47,
            0x0D, 0x0A, 0x1A, 0x0A
        ];
        const hasPngSignature = signature.length >= pngSignature.length &&
            pngSignature.every(function (value, index) {
                return signature[index] === value;
            });
        const validJpeg = file.type === "image/jpeg" &&
            (extension === "jpg" || extension === "jpeg") &&
            hasJpegSignature;
        const validPng = file.type === "image/png" &&
            extension === "png" &&
            hasPngSignature;

        if (!validJpeg && !validPng) {
            rejectProfileImageSelection(
                input,
                "Only JPG and PNG images are allowed."
            );
            return;
        }

        selectedProfileImageFile = file;

        const reader = new FileReader();

        reader.onload = function (event) {
            document.getElementById("editProfileImagePreview").src =
                event.target.result;
        };

        reader.onerror = function () {
            rejectProfileImageSelection(
                input,
                "Unable to read the selected image. Please try again."
            );
        };

        reader.readAsDataURL(file);
    }

    function rejectProfileImageSelection(input, message) {
        input.value = "";
        selectedProfileImageFile = null;
        resetEditProfileImagePreview();
        setFieldError("profileImageError", message);
    }

    function resetEditProfileImagePreview() {
        const preview = document.getElementById("editProfileImagePreview");
        preview.src = preview.dataset.currentSrc;
    }

    function resetEditProfileImage() {
        document.getElementById("editProfileImageInput").value = "";
        selectedProfileImageFile = null;
        resetEditProfileImagePreview();
        clearFieldError("profileImageError");
    }

    function collectChangedProfileFields() {
        const changedFields = Array.from(
            document.querySelectorAll("#editProfileForm [data-profile-field]")
        ).reduce(function (changes, input) {
            const currentValue = input.dataset.current || "";
            const newValue = input.value.trim();
            const valuesMatch = input.dataset.field === "email"
                ? newValue.toLowerCase() === currentValue.toLowerCase()
                : newValue === currentValue;

            if (!valuesMatch) {
                changes.push({
                    field: input.dataset.field,
                    currentValue: currentValue,
                    newValue: newValue
                });
            }

            return changes;
        }, []);

        if (selectedProfileImageFile) {
            changedFields.push({
                field: "profile_image",
                currentValue: document.getElementById(
                    "editProfileImagePreview"
                ).dataset.currentSrc,
                newValue: selectedProfileImageFile.name
            });
        }

        return changedFields;
    }

    function validateProfileFields() {
        clearProfileErrors();

        const fullNameInput = document.getElementById("profileFullName");
        const companyInput = document.getElementById("profileCompanyName");
        const mobileInput = document.getElementById("profileMobile");
        const emailInput = document.getElementById("profileEmail");
        const addressInput = document.getElementById("profileAddress");

        fullNameInput.value = fullNameInput.value.trim();
        companyInput.value = companyInput.value.trim();
        mobileInput.value = mobileInput.value.trim();
        emailInput.value = emailInput.value.trim();
        addressInput.value = addressInput.value.trim();

        if (!fullNameInput.value) {
            showProfileFieldError("full_name", "Full name is required.");
            fullNameInput.focus();
            return false;
        }

        if (!mobileInput.value) {
            showProfileFieldError("mobile", "Mobile number is required.");
            mobileInput.focus();
            return false;
        }

        if (!/^[0-9]{7,15}$/.test(mobileInput.value)) {
            showProfileFieldError(
                "mobile",
                "Please enter a valid mobile number."
            );
            mobileInput.focus();
            return false;
        }

        if (!emailInput.value) {
            showProfileFieldError("email", "Email address is required.");
            emailInput.focus();
            return false;
        }

        if (!/^[^\s@@]+@@[^\s@@]+\.[^\s@@]+$/.test(emailInput.value)) {
            showProfileFieldError(
                "email",
                "Please enter a valid email address."
            );
            emailInput.focus();
            return false;
        }

        return true;
    }

    async function saveProfileChanges(event) {
        if (event) {
            event.preventDefault();
            event.stopImmediatePropagation();
        }

        if (typeof hideLoader === "function") {
            hideLoader();
        }

        const saveButton = document.getElementById(
            "saveProfileChangesButton"
        );

        if (saveButton.disabled) {
            return;
        }

        setProfileFormMessage("");

        if (!validateProfileFields()) {
            return;
        }

        pendingProfileChanges = collectChangedProfileFields();

        if (pendingProfileChanges.length === 0) {
            setProfileFormMessage("No profile changes detected.");
            return;
        }

        requiredOtpTypes = pendingProfileChanges
            .filter(function (item) {
                return sensitiveProfileFields.has(item.field);
            })
            .map(function (item) {
                return item.field;
            });

        verifiedOtpTypes = new Set();

        if (requiredOtpTypes.length === 0) {
            setProfileSaveLoading(true, "Saving...");

            try {
                const results = await updateChangedFields(
                    pendingProfileChanges
                );
                await handleProfileUpdateResults(results, false);
            } finally {
                setProfileSaveLoading(false, "");
            }

            return;
        }

        setProfileSaveLoading(true, "Sending OTP...");

        try {
            const otpSent = await sendRequiredProfileOtps();

            if (!otpSent) {
                return;
            }

            configureProfileOtpModal();
            editTransitionToOtp = true;
            otpReturnToEdit = true;
            getProfileModalInstance(editProfileModalElement).hide();
        } finally {
            setProfileSaveLoading(false, "");
        }
    }

    async function sendRequiredProfileOtps() {
        for (const type of requiredOtpTypes) {
            const change = getPendingChange(type);
            clearProfileFieldErrorForType(type);

            try {
                const result = await postProfileJson(
                    profileEditEndpoints.sendOtp,
                    {
                        type: type,
                        value: change.newValue
                    }
                );

                otpElementMap[type].sendMessage =
                    result.message || "OTP sent successfully";
            } catch (error) {
                showProfileFieldError(
                    type,
                    error.message || "Unable to send OTP. Please try again."
                );
                return false;
            }
        }

        return true;
    }

    function configureProfileOtpModal() {
        const hasMobile = requiredOtpTypes.includes("mobile");
        const hasEmail = requiredOtpTypes.includes("email");

        document.getElementById("profileOtpModalLabel").textContent =
            hasMobile && hasEmail
                ? "Verify Mobile & Email"
                : hasMobile
                    ? "Verify Mobile Number"
                    : "Verify Email Address";

        document.getElementById("profileOtpInstruction").textContent =
            hasMobile && hasEmail
                ? "Enter the OTP sent to each new contact value."
                : "Enter the OTP sent to your new " +
                    (hasMobile ? "mobile number." : "email address.");

        Object.keys(otpElementMap).forEach(function (type) {
            const elements = otpElementMap[type];
            const isRequired = requiredOtpTypes.includes(type);
            const group = document.getElementById(elements.groupId);

            group.classList.toggle("d-none", !isRequired);

            if (!isRequired) {
                return;
            }

            const change = getPendingChange(type);
            document.getElementById(elements.targetId).textContent =
                change.newValue;
            document.getElementById(elements.inputId).value = "";
            clearFieldError(elements.errorId, elements.inputId);
            document.getElementById(elements.statusId).textContent =
                elements.sendMessage || "OTP sent successfully";
        });

        clearFieldError("otpError");
    }

    function getPendingChange(type) {
        return pendingProfileChanges.find(function (item) {
            return item.field === type;
        });
    }

    function clearProfileFieldErrorForType(type) {
        const mapping = profileFieldErrorMap[type];

        if (mapping) {
            clearFieldError(mapping[0], mapping[1]);
        }
    }

    async function resendProfileOtp(type) {
        if (!requiredOtpTypes.includes(type)) {
            return;
        }

        const elements = otpElementMap[type];
        const change = getPendingChange(type);
        const button = document.getElementById(elements.resendButtonId);

        if (!change || button.disabled) {
            return;
        }

        clearFieldError(elements.errorId, elements.inputId);
        document.getElementById(elements.statusId).textContent = "";
        setButtonLoading(
            elements.resendButtonId,
            true,
            "Sending..."
        );

        try {
            const result = await postProfileJson(
                profileEditEndpoints.sendOtp,
                {
                    type: type,
                    value: change.newValue
                }
            );

            document.getElementById(elements.inputId).value = "";
            verifiedOtpTypes.delete(type);
            document.getElementById(elements.statusId).textContent =
                result.message || "OTP sent successfully";
            document.getElementById(elements.inputId).focus();
        } catch (error) {
            setFieldError(
                elements.errorId,
                error.message || "Unable to resend OTP. Please try again.",
                elements.inputId
            );
        } finally {
            setButtonLoading(
                elements.resendButtonId,
                false,
                ""
            );
        }
    }

    function validateRequiredOtpInputs() {
        let valid = true;
        let firstInvalidInput = null;

        requiredOtpTypes.forEach(function (type) {
            if (verifiedOtpTypes.has(type)) {
                return;
            }

            const elements = otpElementMap[type];
            const input = document.getElementById(elements.inputId);
            const otp = input.value.trim();

            clearFieldError(elements.errorId, elements.inputId);

            if (!/^[0-9]{6}$/.test(otp)) {
                setFieldError(
                    elements.errorId,
                    "Please enter a valid 6-digit OTP.",
                    elements.inputId
                );
                firstInvalidInput = firstInvalidInput || input;
                valid = false;
            }
        });

        firstInvalidInput?.focus();
        return valid;
    }

    async function verifyChangedProfileOtps() {
        const verifyButton = document.getElementById(
            "verifyProfileOtpButton"
        );

        if (verifyButton.disabled || !validateRequiredOtpInputs()) {
            return;
        }

        clearFieldError("otpError");
        setButtonLoading(
            "verifyProfileOtpButton",
            true,
            "Verifying..."
        );

        try {
            for (const type of requiredOtpTypes) {
                if (verifiedOtpTypes.has(type)) {
                    continue;
                }

                const elements = otpElementMap[type];
                const change = getPendingChange(type);
                const otp = document.getElementById(
                    elements.inputId
                ).value.trim();

                try {
                    await postProfileJson(
                        profileEditEndpoints.verifyOtp,
                        {
                            type: type,
                            value: change.newValue,
                            otp: otp
                        }
                    );
                    verifiedOtpTypes.add(type);
                    document.getElementById(
                        elements.statusId
                    ).textContent = "OTP verified successfully";
                } catch (error) {
                    setFieldError(
                        elements.errorId,
                        error.message || "Unable to verify OTP.",
                        elements.inputId
                    );
                    document.getElementById(elements.inputId).focus();
                    return;
                }
            }

            verifyButton.innerHTML =
                '<span class="spinner-border spinner-border-sm me-2" aria-hidden="true"></span>Saving...';

            const results = await updateChangedFields(
                pendingProfileChanges
            );
            await handleProfileUpdateResults(results, true);
        } finally {
            setButtonLoading(
                "verifyProfileOtpButton",
                false,
                ""
            );
        }
    }

    async function updateChangedFields(changedFields) {
        const results = [];
        const profileImageChange = changedFields.find(function (item) {
            return item.field === "profile_image";
        });
        const textChanges = changedFields.filter(function (item) {
            return item.field !== "profile_image";
        });

        for (const item of textChanges) {
            const result = await updateProfileField(item);
            results.push({
                field: item.field,
                success: result.success,
                message: result.message
            });
        }

        // Do not upload the image when an earlier profile-field update failed.
        // This keeps the chosen file available for the user's next save attempt.
        if (results.some(function (result) { return !result.success; })) {
            return results;
        }

        if (profileImageChange) {
            results.push(await updateProfileImage());
        }

        return results;
    }

    async function updateProfileImage() {
        if (!selectedProfileImageFile) {
            const message = "Please select a profile image.";
            showProfileFieldError("profile_image", message);

            return {
                field: "profile_image",
                success: false,
                message: message
            };
        }

        const formData = new FormData();
        formData.append(
            "logo_img",
            selectedProfileImageFile,
            selectedProfileImageFile.name
        );

        try {
            const result = await requestProfileEndpoint(
                profileEditEndpoints.updateImage,
                {
                    method: "POST",
                    headers: {
                        "RequestVerificationToken": getAntiForgeryToken()
                    },
                    body: formData
                }
            );

            selectedProfileImageFile = null;
            document.getElementById("editProfileImageInput").value = "";
            clearFieldError("profileImageError");

            return {
                field: "profile_image",
                success: true,
                message: result.message || "Logo updated successfully"
            };
        } catch (error) {
            const message = error.payload?.message ||
                (error.status
                    ? error.message
                    : "Unable to update profile picture. Please try again.");

            showProfileFieldError("profile_image", message);

            return {
                field: "profile_image",
                success: false,
                message: message
            };
        }
    }

    async function updateProfileField(item) {
        if (!supportedProfileFields.has(item.field)) {
            const message = item.field === "profile_image"
                ? "Profile image update mapping is not configured yet."
                : "Unsupported profile field.";

            showProfileFieldError(item.field, message);

            return {
                success: false,
                field: item.field,
                message: message
            };
        }

        try {
            const result = await postProfileJson(
                profileEditEndpoints.updateField,
                {
                    field: item.field,
                    currentValue: item.currentValue,
                    newValue: item.newValue
                }
            );

            updateCurrentValueAfterSuccess(item.field, item.newValue);
            return result;
        } catch (error) {
            const field = error.payload?.field || item.field;
            const message = error.message ||
                "Unable to update this field. Please try again.";

            showProfileFieldError(field, message);

            return {
                success: false,
                field: field,
                message: message
            };
        }
    }

    async function handleProfileUpdateResults(results, usedOtpFlow) {
        const failures = results.filter(function (result) {
            return !result.success;
        });

        if (failures.length > 0) {
            setProfileFormMessage(
                "Some fields could not be updated. Correct the errors below and try again."
            );

            if (usedOtpFlow) {
                otpReturnToEdit = true;
                getProfileModalInstance(profileOtpModalElement).hide();
            }

            return;
        }

        otpReturnToEdit = false;

        if (usedOtpFlow) {
            getProfileModalInstance(profileOtpModalElement).hide();
        } else {
            getProfileModalInstance(editProfileModalElement).hide();
        }

        if (typeof Swal !== "undefined") {
            const imageResult = results.find(function (result) {
                return result.field === "profile_image";
            });
            const successMessage = imageResult && results.length === 1
                ? imageResult.message
                : imageResult
                    ? "Your profile details and picture have been updated successfully."
                    : "Your profile has been updated successfully.";

            await Swal.fire({
                icon: "success",
                title: "Profile Updated",
                text: successMessage,
                confirmButtonColor: "midnightblue"
            });
        }

        window.location.reload();
    }

    function updateCurrentValueAfterSuccess(field, value) {
        const input = document.querySelector(
            '#editProfileForm [data-field="' + field + '"]'
        );

        if (!input) {
            return;
        }

        input.value = value;
        input.dataset.current = value;
    }

    function setProfileSaveLoading(isLoading, loadingText) {
        setButtonLoading(
            "saveProfileChangesButton",
            isLoading,
            loadingText || "Saving..."
        );
    }

    function resetProfilePasswordModal() {
        document.getElementById("profileCurrentPassword").value = "";
        clearFieldError("passwordError", "profileCurrentPassword");
    }

    function resetProfileOtpModal() {
        requiredOtpTypes = [];
        verifiedOtpTypes = new Set();

        Object.values(otpElementMap).forEach(function (elements) {
            document.getElementById(elements.groupId).classList.add("d-none");
            document.getElementById(elements.targetId).textContent = "";
            document.getElementById(elements.inputId).value = "";
            document.getElementById(elements.statusId).textContent = "";
            elements.sendMessage = "";
            clearFieldError(elements.errorId, elements.inputId);
            setButtonLoading(elements.resendButtonId, false, "");
        });

        clearFieldError("otpError");
    }

    function resetProfileForm() {
        document.querySelectorAll("#editProfileForm [data-profile-field]")
            .forEach(function (input) {
                input.value = input.dataset.current || "";
            });

        pendingProfileChanges = [];
        resetEditProfileImage();
        clearProfileErrors();
        setProfileFormMessage("");
    }

    profilePasswordModalElement.addEventListener(
        "shown.bs.modal",
        function () {
            document.getElementById("profileCurrentPassword").focus();
        }
    );

    profilePasswordModalElement.addEventListener(
        "hidden.bs.modal",
        function () {
            resetProfilePasswordModal();

            if (passwordTransitionToEdit) {
                passwordTransitionToEdit = false;
                getProfileModalInstance(editProfileModalElement).show();
            }
        }
    );

    editProfileModalElement.addEventListener(
        "hidden.bs.modal",
        function () {
            if (editTransitionToOtp) {
                editTransitionToOtp = false;
                getProfileModalInstance(profileOtpModalElement).show();
                return;
            }

            resetProfileForm();
        }
    );

    profileOtpModalElement.addEventListener(
        "shown.bs.modal",
        function () {
            const firstType = requiredOtpTypes.find(function (type) {
                return !verifiedOtpTypes.has(type);
            });

            if (firstType) {
                document.getElementById(
                    otpElementMap[firstType].inputId
                ).focus();
            }
        }
    );

    profileOtpModalElement.addEventListener(
        "hidden.bs.modal",
        function () {
            resetProfileOtpModal();

            if (otpReturnToEdit) {
                otpReturnToEdit = false;
                getProfileModalInstance(editProfileModalElement).show();
            }
        }
    );

    Object.entries(otpElementMap).forEach(function ([type, elements]) {
        document.getElementById(elements.inputId).addEventListener(
            "input",
            function () {
                this.value = this.value.replace(/\D/g, "").slice(0, 6);
                verifiedOtpTypes.delete(type);
                clearFieldError(elements.errorId, elements.inputId);
            }
        );
    });

    document.getElementById("profileMobile").addEventListener(
        "input",
        function () {
            this.value = this.value.replace(/\D/g, "").slice(0, 15);
            clearFieldError("mobileError", "profileMobile");
        }
    );

    document.querySelectorAll(
        "#editProfileForm [data-profile-field]"
    ).forEach(function (input) {
        input.addEventListener("input", function () {
            const mapping = profileFieldErrorMap[this.dataset.field];

            if (mapping) {
                clearFieldError(mapping[0], mapping[1]);
            }

            setProfileFormMessage("");
        });
    });

</script>
