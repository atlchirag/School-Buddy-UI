            border-color: midnightblue;
            box-shadow: 0 0 0 0.2rem rgba(25, 25, 112, 0.12);
        }

        .profile-edit-control[readonly] {
            color: #475569;
            background: #f8fafc;
        }

    textarea.profile-edit-control {
        min-height: 92px;
