                            <i class="
                                bi bi-crosshair
                                text-primary me-2
                            "></i>

                            ${escapeAlertHtml(longitude)}

                        </div>

                    </div>

                    <div>

                        <div style="
                            color:#0f172a;
                            font-weight:700;
                        ">
                            Notification Sent On:
                        </div>

                        <div style="color:#334155;">
