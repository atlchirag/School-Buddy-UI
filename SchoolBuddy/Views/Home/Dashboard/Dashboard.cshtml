<!-- Quick Reports Download Modal -->
<div class="modal fade sb-common-modal" id="quickReportsModal" tabindex="-1" aria-labelledby="quickReportsModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="quickReportsModalLabel">Download Report</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form id="quickReportsForm">
                @Html.AntiForgeryToken()
                <div class="modal-body">
                    <div class="mb-3">
                        <label for="quickReportType" class="form-label">Report Type</label>
                        <select id="quickReportType" class="form-select" required>
                            <option value="">Select Report</option>
                            <option value="Daily Attendance Report">Daily Attendance Report</option>
                            <option value="Distance Chart">Distance Chart</option>
                            <option value="Vehicle Summary">Vehicle Summary</option>
                            <option value="Driver Performance Report">Driver Performance Report</option>
                            <option value="Student Pickup/Drop Report">Student Pickup/Drop Report</option >
                        </select>
                    </div>
                    <div id="vehicleSummaryFields" class="row g-3 mt-1" style="display:none;">
                        <div class="col-12">
                            <label class="form-label">Vehicles</label>
                            <div class="dropdown w-100">
                                <button id="vehicleSummaryVehicleButton" class="btn btn-outline-secondary dropdown-toggle w-100 text-start" type="button" data-bs-toggle="dropdown" aria-expanded="false">Select vehicles</button>
                                <div class="dropdown-menu w-100 p-2 vehicle-summary-multiselect" aria-labelledby="vehicleSummaryVehicleButton">
                                    <label class="dropdown-item px-1"><input id="vehicleSummaryVehiclesAll" type="checkbox" class="form-check-input me-2">Select All</label>
                                    <div class="dropdown-divider"></div>
                                    <div id="vehicleSummaryVehicleList"></div>
                                </div>
                            </div>
                        </div>
                        <div class="col-12">
                            <label class="form-label">Columns</label>
                            <div class="dropdown w-100">
                                <button id="vehicleSummaryColumnButton" class="btn btn-outline-secondary dropdown-toggle w-100 text-start" type="button" data-bs-toggle="dropdown" aria-expanded="false">All columns selected</button>
                                <div class="dropdown-menu w-100 p-2 vehicle-summary-multiselect" aria-labelledby="vehicleSummaryColumnButton">
                                    <label class="dropdown-item px-1"><input id="vehicleSummaryColumnsAll" type="checkbox" class="form-check-input me-2" checked>Select All</label>
                                    <div class="dropdown-divider"></div>
                                    <label class="dropdown-item px-1"><input type="checkbox" class="form-check-input me-2 vehicle-summary-column" value="Vehicle" checked>Vehicle</label>
                                    <label class="dropdown-item px-1"><input type="checkbox" class="form-check-input me-2 vehicle-summary-column" value="Driver" checked>Driver</label>
                                    <label class="dropdown-item px-1"><input type="checkbox" class="form-check-input me-2 vehicle-summary-column" value="IMEI" checked>IMEI</label>
                                    <label class="dropdown-item px-1"><input type="checkbox" class="form-check-input me-2 vehicle-summary-column" value="Start Location" checked>Start Location</label>
                                    <label class="dropdown-item px-1"><input type="checkbox" class="form-check-input me-2 vehicle-summary-column" value="Total Distance" checked>Total Distance</label>
                                    <label class="dropdown-item px-1"><input type="checkbox" class="form-check-input me-2 vehicle-summary-column" value="Total Running Time" checked>Total Running Time</label>
                                    <label class="dropdown-item px-1"><input type="checkbox" class="form-check-input me-2 vehicle-summary-column" value="Total Idle Time" checked>Total Idle Time</label>
                                    <label class="dropdown-item px-1"><input type="checkbox" class="form-check-input me-2 vehicle-summary-column" value="Total Halt Time" checked>Total Halt Time</label>
                                    <label class="dropdown-item px-1"><input type="checkbox" class="form-check-input me-2 vehicle-summary-column" value="Max Idle Time" checked>Max Idle Time</label>
                                    <label class="dropdown-item px-1"><input type="checkbox" class="form-check-input me-2 vehicle-summary-column" value="Max Idle Location" checked>Max Idle Location</label>
                                    <label class="dropdown-item px-1"><input type="checkbox" class="form-check-input me-2 vehicle-summary-column" value="Idle Duration(HH:MM:SS)" checked>Idle Duration(HH:MM:SS)</label>
                                    <label class="dropdown-item px-1"><input type="checkbox" class="form-check-input me-2 vehicle-summary-column" value="Max Halt" checked>Max Halt</label>
                                    <label class="dropdown-item px-1"><input type="checkbox" class="form-check-input me-2 vehicle-summary-column" value="Max Halt Location" checked>Max Halt Location</label>
                                    <label class="dropdown-item px-1"><input type="checkbox" class="form-check-input me-2 vehicle-summary-column" value="Halt Duration(HH:MM:SS)" checked>Halt Duration(HH:MM:SS)</label>
                                    <label class="dropdown-item px-1"><input type="checkbox" class="form-check-input me-2 vehicle-summary-column" value="No of Idle" checked>No of Idle</label>
                                    <label class="dropdown-item px-1"><input type="checkbox" class="form-check-input me-2 vehicle-summary-column" value="Avg Speed" checked>Avg Speed</label>
                                    <label class="dropdown-item px-1"><input type="checkbox" class="form-check-input me-2 vehicle-summary-column" value="Max Speed" checked>Max Speed</label>
                                    <label class="dropdown-item px-1"><input type="checkbox" class="form-check-input me-2 vehicle-summary-column" value="No of Overspeed" checked>No of Overspeed</label>
                                    <label class="dropdown-item px-1"><input type="checkbox" class="form-check-input me-2 vehicle-summary-column" value="Alerts" checked>Alerts</label>
                                    <label class="dropdown-item px-1"><input type="checkbox" class="form-check-input me-2 vehicle-summary-column" value="End Location" checked>End Location</label>
                                    <label class="dropdown-item px-1"><input type="checkbox" class="form-check-input me-2 vehicle-summary-column" value="Playback" checked>Playback</label>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div id="distanceChartFields" class="row g-3 mt-1" style="display:none;">
                        <div class="col-12">
                            <label class="form-label">Vehicles</label>
                            <div class="dropdown w-100">
                                <button id="distanceChartVehicleButton" class="btn btn-outline-secondary dropdown-toggle w-100 text-start" type="button" data-bs-toggle="dropdown" aria-expanded="false">Select vehicles</button>
                                <div class="dropdown-menu w-100 p-2 vehicle-summary-multiselect" aria-labelledby="distanceChartVehicleButton">
                                    <label class="dropdown-item px-1"><input id="distanceChartVehiclesAll" type="checkbox" class="form-check-input me-2">Select All</label>
                                    <div class="dropdown-divider"></div>
                                    <div id="distanceChartVehicleList"></div>
                                </div>
                            </div>
                        </div>
                        <div class="col-6">
                            <label for="distanceChartMinDistance" class="form-label">Minimum Distance (km)</label>
                            <input max="10000" type="number" id="distanceChartMinDistance" class="form-control" min="0" step="any" value="0">
                        </div>
                        <div class="col-6">
                            <label for="distanceChartMaxDistance" class="form-label">Maximum Distance (km)</label>
                            <input max="10000" type="number" id="distanceChartMaxDistance" class="form-control" min="0" step="any" value="10">
                        </div>
                    </div>
                    <div class="row g-3">
                        <div class="col-6">
                            <label for="quickReportStartDate" class="form-label">Start Date</label>
                            <div class="notification-picker-wrapper">
                                <input type="text" id="quickReportStartDate" class="form-control notification-line-control" placeholder="Select start date" required>
                                <i class="bi bi-calendar3 notification-picker-icon" id="quickReportStartDateIcon"></i>
                            </div>
                        </div>
                        <div class="col-6">
                            <label for="quickReportStartTime" class="form-label">Start Time</label>
                            <div class="notification-picker-wrapper">
                                <input type="text" id="quickReportStartTime" class="form-control notification-line-control" placeholder="Select start time" required>
                                <i class="bi bi-clock notification-picker-icon" id="quickReportStartTimeIcon"></i>
                            </div>
                        </div>
                        <div class="col-6">
                            <label for="quickReportEndDate" class="form-label">End Date</label>
                            <div class="notification-picker-wrapper">
                                <input type="text" id="quickReportEndDate" class="form-control notification-line-control" placeholder="Select end date" required>
                                <i class="bi bi-calendar3 notification-picker-icon" id="quickReportEndDateIcon"></i>
                            </div>
                        </div>
                        <div class="col-6">
                            <label for="quickReportEndTime" class="form-label">End Time</label>
                            <div class="notification-picker-wrapper">
                                <input type="text" id="quickReportEndTime" class="form-control notification-line-control" placeholder="Select end time" required>
                                <i class="bi bi-clock notification-picker-icon" id="quickReportEndTimeIcon"></i>
                            </div>
                        </div>
                    </div>
                    <div class="mt-3">
                        <span class="form-label d-block">Export Format</span>
                        <div class="d-flex flex-wrap gap-2" role="group" aria-label="Export format">
                            <input type="radio" class="btn-check" name="quickReportFormat" id="quickReportFormatExcel" value="excel" autocomplete="off" checked>
                            <label class="btn btn-outline-success quick-report-format-btn" for="quickReportFormatExcel" title="Excel" aria-label="Excel"><i class="bi bi-file-earmark-excel fs-6"></i></label>

                            <input type="radio" class="btn-check" name="quickReportFormat" id="quickReportFormatPdf" value="pdf" autocomplete="off">
                            <label class="btn btn-outline-danger quick-report-format-btn" for="quickReportFormatPdf" title="PDF" aria-label="PDF"><i class="bi bi-file-earmark-pdf fs-6"></i></label>

                            <input type="radio" class="btn-check" name="quickReportFormat" id="quickReportFormatCsv" value="csv" autocomplete="off">
                            <label class="btn btn-outline-primary quick-report-format-btn" for="quickReportFormatCsv" title="CSV" aria-label="CSV"><i class="bi bi-filetype-csv fs-6"></i></label>

                            <input type="radio" class="btn-check" name="quickReportFormat" id="quickReportFormatPrint" value="print" autocomplete="off">
                            <label class="btn btn-outline-secondary quick-report-format-btn" for="quickReportFormatPrint" title="Print" aria-label="Print"><i class="bi bi-printer fs-6"></i></label>
                        </div>
                    </div>
                </div>
                <div id="quickReportError"
     class="alert alert-danger mx-3 mb-0 py-2"
     style="display:none; font-size:0.82rem;">
</div>
                <div class="modal-footer">
                    <a asp-controller="Report" asp-action="Index" class="btn btn-outline-primary quick-report-action-btn me-auto"><i class="bi bi-folder2-open me-1"></i>All Reports</a>
                    <button type="button" class="btn btn-secondary quick-report-action-btn" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary quick-report-download-btn quick-report-action-btn"><i class="bi bi-download me-1"></i>Download</button>
                </div>
            </form>
        </div>
    </div>
</div>
