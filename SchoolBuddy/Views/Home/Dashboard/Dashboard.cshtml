                                formatNotificationDetailDate(
                                    notification.sentOn
                                )
                            )}
                        </div>

                    </div>

                </div>
            `,

            didOpen: function () {

                const locationButton =
                    document.getElementById(
                        "notificationViewLocationButton"
                    );

                if (!locationButton) {
                    return;
                }

                locationButton.addEventListener(
                    "click",
                    function () {

                        const mapUrl =
                            "https://www.google.com/maps?q=" +
                            encodeURIComponent(
                                notification.latitude
                            ) +
                            "," +
                            encodeURIComponent(
                                notification.longitude
                            );

                        window.open(
                            mapUrl,
                            "_blank",
                            "noopener,noreferrer"
                        );
                    }
                );
            }
        });
    }


    /* =========================================================
       MARK NOTIFICATION AS READ API
       ========================================================= */

    function markNotificationAsRead(
        notification,
        clickedRow
    ) {

        /*
         * Prevent multiple requests if the user clicks
         * the same row repeatedly before the response.
         */
        if (clickedRow.data("request-running") === true) {
            return;
        }

        clickedRow.data(
            "request-running",
            true
        );

        $.ajax({

            url: '@Url.Action(
                "MarkNotificationAsRead",
                "Home"
            )',

            type: "POST",

            contentType:
                "application/json; charset=utf-8",

            dataType: "json",

            data: JSON.stringify({
                id: notification.id
            }),

            success: function (response) {

                if (
                    !response ||
                    response.success !== true
                ) {
                   
                    return;
                }

                notification.isRead = 1;

                /*
                 * Update the status in the clicked row.
                 */
                clickedRow
                    .find(
                        ".notification-read-status"
                    )
                    .html(`
                        <span class="
                            alert-status-pill
                            text-success
                            fw-semibold
                        ">
                            Read
                        </span>
                    `);

                /*
                 * Update ViewBag-originated local array.
                 */
                updateNotificationStatusInArray(
                    dashboardAlerts,
                    notification.id
                );

                /*
                 * Update filtered/current array.
                 */
                updateNotificationStatusInArray(
                    currentAlertData,
                    notification.id
                );
            },

            error: function (
                xhr,
                status,
                error
            ) {

            },

            complete: function () {

                clickedRow.data(
                    "request-running",
                    false
                );
            }
        });
    }


    /* =========================================================
       FILTER NOTIFICATIONS
       ========================================================= */

    function filterNotifications() {

        const notificationStatus =
            $("#notificationStatus").val();

        const startDate =
            $("#notificationStartDate")
                .val()
                .trim();

        const startTime =
            $("#notificationStartTime")
                .val()
                .trim();

        const endDate =
            $("#notificationEndDate")
                .val()
                .trim();

        const endTime =
            $("#notificationEndTime")
                .val()
                .trim();

        const errorElement =
            $("#notificationFilterError");

        const submitButton =
            $("#notificationFilterSubmit");

        errorElement
            .addClass("d-none")
            .text("");

        if (
            !startDate ||
            !startTime ||
            !endDate ||
            !endTime
        ) {
            showNotificationFilterError(
                "Please select start and end date/time."
            );

            return;
        }

        const startDateTime =
            createLocalDateTime(
                startDate,
                startTime
            );

        const endDateTime =
            createLocalDateTime(
                endDate,
                endTime
            );

        if (
            !startDateTime ||
            !endDateTime
        ) {
            showNotificationFilterError(
                "Please select valid date and time values."
            );

            return;
        }

        if (
            startDateTime.getTime() >
            endDateTime.getTime()
        ) {
            showNotificationFilterError(
                "Start date/time cannot be greater than end date/time."
            );

            return;
        }

        const now = new Date();

        if (
            endDateTime.getTime() >
            now.getTime()
        ) {
            showNotificationFilterError(
                "End date/time cannot be greater than the current date/time."
            );

            return;
        }

        submitButton
            .prop("disabled", true)
            .html(`
                <span class="
                    spinner-border
                    spinner-border-sm
                "
                role="status">
                </span>
            `);

        $.ajax({

            url: '@Url.Action(
                "FilterNotifications",
                "Home"
            )',

            type: "POST",

            data: {
                notificationStatus:
                    notificationStatus,

                startDate:
                    startDate,

                startTime:
                    startTime,

                endDate:
                    endDate,

                endTime:
                    endTime
            },

            success: function (response) {

               

                let alerts = response;

                /*
                 * Supports:
                 * response = [...]
                 * or
                 * response = { data: [...] }
                 */
                if (
                    response &&
                    response.data !== undefined
                ) {
                    alerts = response.data;
                }

                if (!Array.isArray(alerts)) {
                    alerts = [];
                }

                currentAlertData = alerts;

                /*
                 * Clear old rows and show the current response,
                 * including an empty-table message.
                 */
                clearAndFillAlertTable(
                    currentAlertData
                );

                if (alerts.length === 0) {

                    Swal.fire({
                        icon: "info",
                        title: "No Data Found",
                        text:
                            "No alerts found for the selected filter.",
                        confirmButtonText: "OK"
                    });
                }
            },

            error: function (
                xhr,
                status,
                error
            ) {

               
                const errorMessage =
                    xhr.responseJSON?.message ||
                    xhr.responseText ||
                    "Unable to load notifications.";

                errorElement
                    .removeClass("d-none")
                    .text(errorMessage);

                Swal.fire({
                    icon: "error",
                    title:
                        "Unable to Load Notifications",
                    text:
                        errorMessage,
                    confirmButtonText:
                        "OK"
                });
            },

            complete: function () {

                submitButton
                    .prop("disabled", false)
                    .html(`
                        <i class="bi bi-search fs-6"></i>
                    `);
            }
        });
    }


    /* =========================================================
       FILTER TABLE REFRESH
       ========================================================= */

    function clearAndFillAlertTable(alerts) {

        renderAlertNotificationTable(alerts);
    }


    /* =========================================================
       HELPER FUNCTIONS
       ========================================================= */

    function getVehicleFromMessage(message) {

        if (!message) {
            return "-";
        }

        const words = String(message)
            .trim()
            .split(/\s+/);

        const vehicleIndex =
            words.findIndex(function (word) {

                return word
                    .replace(/[,:;]/g, "")
                    .toLowerCase() ===
                    "vehicle";
            });

        if (
            vehicleIndex >= 0 &&
            vehicleIndex + 1 < words.length
        ) {
            return words[vehicleIndex + 1]
                .replace(/[,.]+$/, "");
        }

        return "-";
    }


    function escapeAlertHtml(value) {

        return $("<div>")
            .text(
                value === null ||
                value === undefined
                    ? ""
                    : String(value)
            )
            .html();
    }


    function formatAlertDate(value) {

        const date =
            parseNotificationDate(value);

        if (!date) {
            return escapeAlertHtml(
                value || "-"
            );
        }

        return date.toLocaleString(
            "en-IN",
            {
                day: "2-digit",
                month: "short",
                year: "numeric",
                hour: "2-digit",
                minute: "2-digit",
                hour12: true
            }
        );
    }


    function formatNotificationDetailDate(value) {

        const date =
            parseNotificationDate(value);

        if (!date) {
            return value || "-";
        }

        return date.toLocaleString(
            "en-IN",
            {
                day: "2-digit",
                month: "short",
                year: "numeric",
                hour: "2-digit",
                minute: "2-digit",
                second: "2-digit",
                hour12: true
            }
        );
    }


    function parseNotificationDate(value) {

        if (!value) {
            return null;
        }

        if (value instanceof Date) {

            return Number.isNaN(
                value.getTime()
            )
                ? null
                : value;
        }

        /*
         * Supports API format:
         * 2026-07-17 15:04:13.003
         */
        const normalizedValue =
            String(value)
                .trim()
                .replace(" ", "T");

        const date =
            new Date(normalizedValue);

        return Number.isNaN(
            date.getTime()
        )
            ? null
            : date;
    }


    function createLocalDateTime(
        dateValue,
        timeValue
    ) {

        const dateTime =
            new Date(
                `${dateValue}T${timeValue}:00`
            );

        return Number.isNaN(
            dateTime.getTime()
        )
            ? null
            : dateTime;
    }


    function hasValidCoordinate(value) {

        if (
            value === null ||
            value === undefined ||
            value === ""
        ) {
            return false;
        }

        return Number.isFinite(
            Number(value)
        );
    }


    function showNotificationFilterError(
        message
    ) {

        $("#notificationFilterError")
            .removeClass("d-none")
            .text(message);
    }


    function updateNotificationStatusInArray(
        alerts,
        notificationId
    ) {

        if (!Array.isArray(alerts)) {
            return;
        }

        const alertItem =
            alerts.find(function (item) {

                return Number(
                    item.Id ??
                    item.id ??
                    0
                ) === Number(
                    notificationId
                );
            });

        if (!alertItem) {
            return;
        }

        if (
            Object.prototype.hasOwnProperty.call(
                alertItem,
                "IsRead"
            )
        ) {
            alertItem.IsRead = 1;
        }

        if (
            Object.prototype.hasOwnProperty.call(
                alertItem,
                "isRead"
            )
        ) {
            alertItem.isRead = 1;
        }

        if (
            Object.prototype.hasOwnProperty.call(
                alertItem,
                "is_read"
            )
        ) {
            alertItem.is_read = 1;
        }
    }
});
