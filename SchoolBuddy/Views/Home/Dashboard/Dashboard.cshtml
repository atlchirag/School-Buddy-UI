@using Newtonsoft.Json
@model Dashboard
@using System.Linq

@{
    var driverMonitoringList =
        ViewBag.DriverPerformance as IEnumerable<DriverPerformanceModel>
        ?? Enumerable.Empty<DriverPerformanceModel>();

         var routePerformance = ViewBag.RoutePerformance as List<RouteLiveStatusModel>;
    var alert = ViewBag.Alerts as List<NotificationItem>;
    var vehicleService = ViewBag.vehicleserve as List<VehicleInService> ?? new List<VehicleInService>();

    
                                 int totalBus = Convert.ToInt32(ViewData["total_bus"] ?? 0);

   
var groupedVehicles = (ViewBag.vehicleserve as List<VehicleInService>
        ?? new List<VehicleInService>())
        .GroupBy(x => x.veh_reg)
        .Select(g => new
        {
            VehReg = g.Key,

            SysServiceId = g
                .Select(x => x.sys_service_id)
                .FirstOrDefault(),

            MaximumSpeedToday = g
                .Select(x => x.MaximumSpeedToday)
                .FirstOrDefault(),

            LastRunningTime = g
                .OrderByDescending(x =>
                {
                    DateTime.TryParse(x.LastRunningTime, out var dt);
                    return dt;
                })
                .Select(x => x.LastRunningTime)
                .FirstOrDefault(),

            Routes = g
                .Where(x => !string.IsNullOrWhiteSpace(x.route_name))
                .Select(x => x.route_name)
                .Distinct()
                .ToList()
        })
        .ToList();

    int uniqueVehicleCount = groupedVehicles.Count;
     double runningPercentage = totalBus > 0
        ? (uniqueVehicleCount * 100.0) / totalBus
        : 0;
}
@{
    ViewData["Title"] = "Dashboard";
}
