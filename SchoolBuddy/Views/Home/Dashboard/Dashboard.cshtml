@model Dashboard

@*
    Lazy loaded: this page is returned straight away with every value at 0.
    The values come as JSON from HomeController.DashboardData(section) in three sections
    (top, middle, bottom), shown top to bottom by ~/js/dashboard/dashboard-lazy-load.js.
    data-dashboard-section marks which section fills an element.
      - data-dashboard-field="name"  -> text filled from the response "fields"
      - table bodies / lists by id   -> rows built by the script from the response lists
*@
@{
    ViewData["Title"] = "Dashboard";
}
