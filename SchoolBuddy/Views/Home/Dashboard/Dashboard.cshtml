                                            TimeSpan diff = DateTime.Now - item.DateTime.AddMinutes(330);

                                            string lastUpdate;

                                            if (diff.TotalSeconds < 60)
                                            {
                                                lastUpdate = $"{diff.Seconds} sec ago";
                                            }
                                            else if (diff.TotalMinutes < 60)
                                            {
                                                lastUpdate = $"{diff.Minutes} min ago";
                                            }
                                            else if (diff.TotalHours < 24)
                                            {
                                                lastUpdate = $"{diff.Hours} hr ago";
                                            }
                                            else
                                            {
                                                lastUpdate = $"{diff.Days} day(s) ago";
                                            }

                                            decimal battery = 0;
                                            decimal.TryParse(item.battery_percent, out battery);

                                            string batteryClass = battery >= 60
                                                ? "text-success"
                                                : battery >= 30
                                                    ? "text-warning"
                                                    : "text-danger";

                                            <tr >
                                           <td class="fw-bold text-dark" style="white-space: nowrap; font-size:10px;">
    @{
        var vehicle = string.IsNullOrWhiteSpace(item.Id) ? "N/A" : item.Id;
