                                        <th style="padding: 4px 2px;">Vehicle</th>
                                        <th style="padding: 4px 2px;">Students</th>
                                        <th style="padding: 4px 2px;">Status</th>
                                        <th style="padding: 4px 2px;">ETA</th>
