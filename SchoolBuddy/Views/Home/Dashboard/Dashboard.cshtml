 @if (routePerformance != null && routePerformance.Any())
    {
    
        foreach (var item in routePerformance.Take(4))
        {
            string statusClass = "text-secondary";
            string bgClass = "#e9ecef";

            switch (item.RouteStatus)
            {
                case "On Time":
                    statusClass = "text-success";
                    bgClass = "#e0f8e9";
                    break;

                case "Delayed":
                    statusClass = "text-warning";
                    bgClass = "#fff3cd";
                    break;

                case "Route Time Completed":
                    statusClass = "text-primary";
                    bgClass = "#dbeafe";
                    break;

                case "Not Started":
                    statusClass = "text-secondary";
                    bgClass = "#f1f3f5";
                    break;
            }

            <tr>
                <td style="padding: 4px 2px;"  class="fw-bold text-dark">
                    @item.Route
                </td>

                <td style="padding: 4px 2px;">
    
@{
    var vehicle = item.Vehicle ?? "";

    for (int i = 0; i < vehicle.Length; i += 8)
    {
        var length = Math.Min(8, vehicle.Length - i);
        @vehicle.Substring(i, length)

        if (i + 8 < vehicle.Length)
        {
            <br />
        }
    }
}
</td>
                <td style="padding: 4px 2px; text-align:center">
                    @item.Students
                </td>

                <td style="padding: 4px 2px;">
                    <span class="@statusClass fw-semibold"
                          style="font-size:0.55rem;background:@bgClass;padding:2px 4px;border-radius:4px;">
                        @item.RouteStatus
                    </span>
                </td>

                <td style="padding: 4px 2px;">
                    @(item.ETA == "0" ? "0 Min" :
                      item.ETA == "N/A" ? "N/A" :
                      item.EtaDifferenceMinutes.HasValue
                            ? $"{Math.Abs(item.EtaDifferenceMinutes.Value)} Min"
                            : item.ETA)
                </td>
            </tr>
        }
    }
    else
    {
        <tr>
            <td colspan="5" class="text-center text-muted py-3">
                No Route Data Available
            </td>
        </tr>
    }
</tbody>
                            </table>
