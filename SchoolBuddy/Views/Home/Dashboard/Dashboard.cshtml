<script src="https://cdn.jsdelivr.net/npm/flatpickr"></script>
<script>
    let notificationStartDatePicker;
    let notificationStartTimePicker;
    let notificationEndDatePicker;
    let notificationEndTimePicker;

    document.addEventListener("DOMContentLoaded", function () {

        initializeNotificationDateTimePickers();

        document
            .getElementById("resetNotificationFilter")
            ?.addEventListener("click", function () {
                setNotificationDefaultDateTime();
            });
    });

    function initializeNotificationDateTimePickers() {

        const now = new Date();

        /*
         * Start date:
         * Defaults to today's date.
         */
        notificationStartDatePicker = flatpickr("#notificationStartDate", {
            dateFormat: "Y-m-d",
            defaultDate: now,
            maxDate: now,
          allowInput: true,
clickOpens: false,

            disableMobile: true,
            onChange: updateNotificationTimeLimits
        });

        /*
         * Start time:
         * Defaults to 00:00.
         */
        notificationStartTimePicker = flatpickr("#notificationStartTime", {
            enableTime: true,
            noCalendar: true,
            dateFormat: "H:i",
            time_24hr: true,
            defaultDate: "00:00",
            allowInput: true,
clickOpens: false,
            disableMobile: true
        });

        /*
         * End date:
         * Defaults to today's date.
         */
        notificationEndDatePicker = flatpickr("#notificationEndDate", {
            dateFormat: "Y-m-d",
            defaultDate: now,
            maxDate: now,
           allowInput: true,
clickOpens: false,
            disableMobile: true,
            onChange: updateNotificationTimeLimits
        });

        /*
         * End time:
         * Defaults to current time.
         */
        notificationEndTimePicker = flatpickr("#notificationEndTime", {
            enableTime: true,
            noCalendar: true,
            dateFormat: "H:i",
            time_24hr: true,
            defaultDate: now,
            maxTime: formatTimeForFlatpickr(now),
    allowInput: true,
    clickOpens: false,
            disableMobile: true
        });

        bindNotificationPickerIcons();

        updateNotificationTimeLimits();
    }

    function bindNotificationPickerIcons() {

    bindPickerToggle(
    "notificationStartDate",
    "notificationStartDateIcon",
    notificationStartDatePicker
    );

    bindPickerToggle(
    "notificationStartTime",
    "notificationStartTimeIcon",
    notificationStartTimePicker
    );

    bindPickerToggle(
    "notificationEndDate",
    "notificationEndDateIcon",
    notificationEndDatePicker
    );

    bindPickerToggle(
    "notificationEndTime",
    "notificationEndTimeIcon",
    notificationEndTimePicker
    );
    }

    function bindPickerToggle(inputId, iconId, picker) {

    const input = document.getElementById(inputId);
    const icon = document.getElementById(iconId);

    if (!input || !picker) {
        return;
    }

    function togglePicker(event) {

        event.preventDefault();
        event.stopPropagation();
        event.stopImmediatePropagation();

        /*
         * pointerdown runs before Flatpickr's document click
         * handler, so the current open state is still correct.
         */
        if (picker.isOpen) {
            picker.close();
        } else {
            picker.open();
        }
    }

    /*
     * Use pointerdown rather than click.
     */
    input.addEventListener(
        "pointerdown",
        togglePicker,
        true
    );

    if (icon) {
        icon.addEventListener(
            "pointerdown",
            togglePicker,
            true
        );
    }

    /*
     * Prevent the later click event from opening it again.
     */
    function blockClick(event) {
        event.preventDefault();
        event.stopPropagation();
        event.stopImmediatePropagation();
    }

    input.addEventListener(
        "click",
        blockClick,
        true
    );

    if (icon) {
        icon.addEventListener(
            "click",
            blockClick,
            true
        );
    }
}

    function setNotificationDefaultDateTime() {

        const now = new Date();

        notificationStartDatePicker.setDate(now, true);
        notificationStartTimePicker.setDate("00:00", true);

        notificationEndDatePicker.setDate(now, true);
        notificationEndTimePicker.setDate(now, true);

        updateNotificationTimeLimits();

        const errorElement =
            document.getElementById("notificationFilterError");

        if (errorElement) {
            errorElement.classList.add("d-none");
            errorElement.textContent = "";
        }
    }

    function updateNotificationTimeLimits() {

        if (!notificationStartDatePicker ||
            !notificationEndDatePicker ||
            !notificationStartTimePicker ||
            !notificationEndTimePicker) {
            return;
        }

        const now = new Date();
        const today = formatDateForFlatpickr(now);
        const currentTime = formatTimeForFlatpickr(now);

        const selectedStartDate =
            document.getElementById("notificationStartDate").value;

        const selectedEndDate =
            document.getElementById("notificationEndDate").value;

        /*
         * Only restrict time to the current time when
         * the selected date is today.
         */
        notificationStartTimePicker.set(
            "maxTime",
            selectedStartDate === today ? currentTime : null
        );

        notificationEndTimePicker.set(
            "maxTime",
            selectedEndDate === today ? currentTime : null
        );
    }

    function formatDateForFlatpickr(date) {

        const year = date.getFullYear();
        const month = String(date.getMonth() + 1).padStart(2, "0");
        const day = String(date.getDate()).padStart(2, "0");

        return `${year}-${month}-${day}`;
    }

    function formatTimeForFlatpickr(date) {

        const hours = String(date.getHours()).padStart(2, "0");
        const minutes = String(date.getMinutes()).padStart(2, "0");

        return `${hours}:${minutes}`;
    }
</script>
<script>
document.addEventListener("DOMContentLoaded", function () {
    /* =========================================================
       INITIAL NOTIFICATION DATA
       ========================================================= */

    const dashboardAlerts = @Html.Raw(
        JsonConvert.SerializeObject(
            alert ?? new List<NotificationItem>(),
            new JsonSerializerSettings {
                StringEscapeHandling = StringEscapeHandling.EscapeHtml
            }
        )
    );

    let currentAlertData = Array.isArray(dashboardAlerts)
        ? dashboardAlerts
        : [];

    let alertNotificationDataTable = null;


    /* =========================================================
       MODAL OPEN
       ========================================================= */

    $(document).ready(function () {

        const alertModal =
            document.getElementById("alertNotificationModal");

        if (alertModal) {

            alertModal.addEventListener(
                "shown.bs.modal",
                function () {

                    renderAlertNotificationTable(
                        currentAlertData
                    );
                }
            );
        }

        renderAlertNotificationTable(currentAlertData);


        /* =====================================================
           FILTER FORM SUBMIT
           ===================================================== */

        $("#notificationFilterForm").on(
            "submit",
            function (event) {

                event.preventDefault();

                filterNotifications();

                return false;
            }
        );


        /* =====================================================
           RESET FILTER
           ===================================================== */

        $("#resetNotificationFilter").on(
            "click",
            function () {

                $("#notificationStatus").val("0");

                /*
                 * This function already exists in your
                 * Flatpickr script.
                 */
                if (
                    typeof setNotificationDefaultDateTime ===
                    "function"
                ) {
                    setNotificationDefaultDateTime();
                }

                $("#notificationFilterError")
                    .addClass("d-none")
                    .text("");

                currentAlertData = Array.isArray(dashboardAlerts)
                    ? dashboardAlerts
                    : [];

                renderAlertNotificationTable(
                    currentAlertData
                );
            }
        );
    });


    /* =========================================================
       BUILD NOTIFICATION TABLE
       ========================================================= */

    function bindAlertNotificationTable(alerts) {

        const tableSelector =
            "#alertNotificationTable";

        const tableBody =
            $("#alertNotificationTableBody");

        /*
         * Destroy the previous DataTable before changing
         * the tbody HTML.
         */
        if ($.fn.DataTable.isDataTable(tableSelector)) {

            $(tableSelector)
                .DataTable()
                .clear()
                .destroy();

            alertNotificationDataTable = null;
        }

        tableBody.empty();

        if (!Array.isArray(alerts) || alerts.length === 0) {

            tableBody.html(`
                <tr class="empty-row">
                    <td colspan="6"
                        class="text-center align-middle text-muted">
                        No alerts found.
                    </td>
                </tr>
            `);

            return;
        }

        alerts.forEach(function (item, index) {

            const notification =
                normalizeNotificationItem(item);

            const statusHtml =
                notification.isRead === 1
                    ? `
                        <span class="alert-status-pill
                                     text-success fw-semibold">
                            Read
                        </span>
                      `
                    : `
                        <span class="alert-status-pill
                                     text-danger fw-semibold">
                            New
                        </span>
                      `;

            const row = $(`
                <tr class="notification-click-row"
                    title="Click to view notification details">

                    <td>
                        ${index + 1}
                    </td>

                    <td>
                        <span class="alert-type-text">
                            ${escapeAlertHtml(
                                notification.msgStatus
                            )}
                        </span>
                    </td>

                    <td class="fw-semibold">
                        ${escapeAlertHtml(
                            notification.vehicle
                        )}
                    </td>

                    <td class="alert-message-cell">
                        ${escapeAlertHtml(
                            notification.message
                        )}
                    </td>

                    <td class="alert-date-cell">
                        ${formatAlertDate(
                            notification.sentOn
                        )}
                    </td>

                    <td class="notification-read-status">
                        ${statusHtml}
                    </td>

                </tr>
            `);

            /*
             * Store the complete notification object
             * against the generated row.
             */
            row.data(
                "notification",
                notification
            );

            tableBody.append(row);
        });

        alertNotificationDataTable =
            $(tableSelector).DataTable({

                pageLength: 10,

                lengthMenu: [
                    5,
                    10,
                    25,
                    50
                ],

                responsive: false,
                autoWidth: false,
                ordering: true,
                searching: true,
                info: true,
                paging: true,
                destroy: true,
                scrollY: "36vh",
                scrollCollapse: true,

                language: {
                    search: "Search:",
                    lengthMenu:
                        "Show _MENU_ entries",
                    info:
                        "Showing _START_ to _END_ of _TOTAL_ entries",
                    emptyTable:
                        "No alerts found",
                    zeroRecords:
                        "No matching alerts found"
                },

                columnDefs: [
                    {
                        targets: 0,
                        orderable: false,
                        searchable: false
                    }
                ]
            });

        setTimeout(function () {

            if (alertNotificationDataTable) {

                alertNotificationDataTable
                    .columns
                    .adjust()
                    .draw(false);
            }

        }, 150);
    }


    /*
     * One render path for the initial server list, reset and search results.
     * bindAlertNotificationTable destroys the old DataTable and empties the
     * tbody before it creates rows for the supplied list.
     */
    function renderAlertNotificationTable(alerts) {

        bindAlertNotificationTable(
            Array.isArray(alerts)
                ? alerts
                : []
        );
    }

    /* =========================================================
       NORMALIZE API/VIEWBAG PROPERTY NAMES
       ========================================================= */

    function normalizeNotificationItem(item) {

        item = item || {};

        const message =
            item.Message ??
            item.message ??
            "-";

        return {

            id: Number(
                item.Id ??
                item.id ??
                0
            ),

            msgStatus:
                item.MsgStatus ??
                item.msgStatus ??
                item.msg_status ??
                "-",

            message: message,

            vehicle:
                item.Vehicle ??
                item.vehicle ??
                getVehicleFromMessage(message),

            sentOn:
                item.SentOn ??
                item.sentOn ??
                item.sent_on ??
                null,

            latitude:
                item.GpsLatitude ??
                item.gpsLatitude ??
                item.gps_latitude ??
                null,

            longitude:
                item.GpsLongitude ??
                item.gpsLongitude ??
                item.gps_longitude ??
                null,

            isRead: Number(
                item.IsRead ??
                item.isRead ??
                item.is_read ??
                0
            )
        };
    }


    /* =========================================================
       ROW CLICK
       ========================================================= */

    $(document).on(
        "click",
        "#alertNotificationTable tbody tr.notification-click-row",
        function () {

            const clickedRow = $(this);

            const notification =
                clickedRow.data("notification");

            if (!notification) {
                return;
            }

            /*
             * Open SweetAlert with the clicked row data.
             */
            showNotificationDetailSwal(
                notification
            );

            /*
             * Call the API only when:
             * 1. ID is valid.
             * 2. Notification is currently unread.
             */
            if (
                notification.id > 0 &&
                notification.isRead !== 1
            ) {
                markNotificationAsRead(
                    notification,
                    clickedRow
                );
            }
        }
    );


    /* =========================================================
       SWEETALERT NOTIFICATION DETAIL
       ========================================================= */

    function showNotificationDetailSwal(
        notification
    ) {

        const hasLocation =
            hasValidCoordinate(
                notification.latitude
            ) &&
            hasValidCoordinate(
                notification.longitude
            );

        const latitude = hasLocation
            ? notification.latitude
            : "-";

        const longitude = hasLocation
            ? notification.longitude
            : "-";

        Swal.fire({

            width: 520,

            

            showConfirmButton: true,

            confirmButtonText: "Close",

            confirmButtonColor: "#6c757d",

            html: `
                <div style="
                    border:1px solid #cbd5e1;
                    border-radius:7px;
                    padding:17px;
                    text-align:left;
                ">

                    <div style="
                        display:flex;
                        align-items:center;
                        justify-content:space-between;
                        flex-wrap:wrap;
                        gap:12px;
                        margin-bottom:18px;
                    ">

                        <span style="
                            color:#0369a1;
                            font-size:1rem;
                            font-weight:700;
                            text-decoration:underline;
                        ">
                            Notification Detail
                        </span>

                        ${
                            hasLocation
                                ? `
                                    <button type="button"
                                            id="notificationViewLocationButton"
                                            class="btn btn-primary btn-sm">

                                        <i class="bi bi-geo-alt-fill me-1"></i>
