                            )}
                        </div>

                    </div>

                    <div style="margin-bottom:13px;">

                        <div style="
                            color:#0f172a;
                            font-weight:700;
                        ">
                            Vehicle:
                        </div>

                        <div style="color:#334155;">
                            ${escapeAlertHtml(
                                notification.vehicle
                            )}
                        </div>

                    </div>

                    <div style="margin-bottom:13px;">

                        <div style="
                            color:#0f172a;
                            font-weight:700;
                        ">
                            Message:
                        </div>

                        <div style="
