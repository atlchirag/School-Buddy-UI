function formatPickupDropDate(
    dateValue
) {

    if (!dateValue) {
        return '';
    }

    const date =
        new Date(dateValue);

    if (
        Number.isNaN(
            date.getTime()
        )
    ) {
        return '';
    }

    const day =
        String(
            date.getDate()
        ).padStart(2, '0');

    const month =
        String(
            date.getMonth() + 1
        ).padStart(2, '0');

    const year =
        date.getFullYear();

    return `${day}-${month}-${year}`;
}
function formatPickupDropTime(
    dateValue
) {

    if (!dateValue) {
        return '';
    }

    const date =
        new Date(dateValue);

    if (
        Number.isNaN(
            date.getTime()
        )
    ) {
        return '';
    }

    const hours =
        String(
            date.getHours()
        ).padStart(2, '0');

    const minutes =
        String(
            date.getMinutes()
        ).padStart(2, '0');

    const seconds =
        String(
            date.getSeconds()
        ).padStart(2, '0');

    return `${hours}:${minutes}:${seconds}`;
}
