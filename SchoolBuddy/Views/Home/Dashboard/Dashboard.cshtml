    {
        @vehicle.Substring(0, 8)
        <br />
        @vehicle.Substring(8)
    }
    else
    {
        @vehicle
    }
</td>

                                                <td style="text-align:center">
                                                    @(string.IsNullOrWhiteSpace(item.Temperature)
