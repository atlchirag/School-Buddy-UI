<div class="modal fade sb-common-modal dashboard-table-modal"
     id="driverMonitoringModal"
     tabindex="-1"
     aria-labelledby="driverMonitoringModalLabel"
     aria-hidden="true">

    <div class="modal-dialog modal-xl modal-dialog-centered">

        <div class="modal-content">

            <div class="modal-header">
                <i class="bi bi-person-badge-fill fs-5 px-2"></i>
                <h5 class="modal-title"
                    id="driverMonitoringModalLabel">
                    Driver Monitoring
                </h5>

                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="modal"
                        aria-label="Close">
                </button>

            </div>

            <div class="modal-body">
<div class="w-100"
     id="driverMonitoringTableContainer"
     style="visibility:hidden;">

    <table class="table table-hover align-middle mb-0 w-100"
           id="driverMonitoringTable"
           style="width:100%;">

                            <thead>
                                <tr>
                                    <th style="text-align:center">S.No.</th>
                                    <th>Driver</th>
                                    <th>Vehicle</th>
                                    <th>Status</th>
                                    <th>Last Trip</th>
                                </tr>
                            </thead>

                           <tbody>
@{
    int srno = 1;
}
@foreach (SchoolBuddy.Models.Driver.DriverPerformanceModel driver
    in ((IEnumerable<SchoolBuddy.Models.Driver.DriverPerformanceModel>)ViewBag.DriverPerformance))
{
   <tr>
       <td>@srno</td>
                                        <td class="text-muted" style="white-space: normal; word-break: break-word; max-width: 150px;">@driver.DriverName</td>

                                            <td class="text-muted" style="line-height:1.2;">
                                                @{
                                                    var busName = string.IsNullOrWhiteSpace(driver.BusName) ? "-" : driver.BusName;

                                                    var match = System.Text.RegularExpressions.Regex.Match(busName, @"^(.*?\d{4})(.*)$");

                                                    @if (match.Success)
                                                    {
                                                        @match.Groups[1].Value
                                                        <br />
                                                        @match.Groups[2].Value
                                                    }
                                                    else
                                                    {
                                                        @(string.IsNullOrWhiteSpace(busName) || busName == "-" ? "N/A" : busName)
                                                    }
                                                }
                                            </td>

                                            <td>
                                                <span class="sb-badge @(driver.DriverStatus == "Active"
                                                                              ? "sb-badge-success"
                                                                              : "sb-badge-secondary")">
                                                    @driver.DriverStatus
                                                </span>
                                            </td>

                                            <td class="@(driver.BusStatus == "Running"
                                                                    ? "fw-semibold text-dark"
                                                                    : "text-muted")">
                                                @driver.BusStatus
                                            </td>
                                        </tr>

    srno++;
}
</tbody>

                        </table>

                    </div>

                

            </div>

           

        </div>

    </div>

</div>

