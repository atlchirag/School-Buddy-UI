@* route performance modal *@

<div class="modal fade sb-common-modal dashboard-modal dashboard-table-modal"
     id="routePerformanceModal"
     tabindex="-1"
     aria-labelledby="routePerformanceModalLabel"
     aria-hidden="true">

    <div class="modal-dialog modal-xl modal-dialog-centered">

        <div class="modal-content">

            <div class="modal-header">
                <h5 class="modal-title"
                    id="routePerformanceModalLabel">

                    <i class="bi bi-bus-front-fill me-2"></i>
                    Route Performance
                </h5>

                <button type="button"
                        class="btn-close btn-close-black"
                        data-bs-dismiss="modal"
                        aria-label="Close">
                </button>
            </div>

            <div class="modal-body">
<div class="w-100"
     id="routePerformanceTableContainer"
     style="visibility:hidden;">

    <table class="table table-hover align-middle mb-0 w-100"
           id="routePerformanceModalTable"
           style="width:100%;">

                        <thead>
                            <tr>
                                <th>Route</th>
                                <th>Vehicle</th>
                                <th>Students</th>
                                <th>Start Time</th>
                                <th>End Time</th>
                                <th>Stop Name</th>
                                <th>ETA</th>
                                <th>Route Status</th>
                                <th>Live Status</th>
                            </tr>
                        </thead>

                        <tbody>

                            @if (routePerformance != null &&
                                 routePerformance.Any())
                            {
                                foreach (var item in routePerformance)
                                {
                                    string routeTextClass = "text-secondary";
                                    string routeBackground = "#f1f3f5";

                                    switch (item.RouteStatus)
                                    {
                                        case "On Time":
                                            routeTextClass = "text-success";
                                            routeBackground = "#e0f8e9";
                                            break;

                                        case "Delayed":
                                            routeTextClass = "text-warning";
                                            routeBackground = "#fff3cd";
                                            break;

                                        case "Route Time Completed":
                                            routeTextClass = "text-primary";
                                            routeBackground = "#dbeafe";
                                            break;

                                        case "Not Started":
                                            routeTextClass = "text-secondary";
                                            routeBackground = "#f1f3f5";
                                            break;
                                    }

                                    string liveTextClass = "text-secondary";
                                    string liveBackground = "#f1f3f5";

                                    switch (item.VehicleLiveStatus)
                                    {
                                        case "Running":
                                            liveTextClass = "text-success";
                                            liveBackground = "#e0f8e9";
                                            break;

                                        case "Idle":
                                            liveTextClass = "text-warning";
                                            liveBackground = "#fff3cd";
                                            break;

                                        case "Stopped":
                                            liveTextClass = "text-danger";
                                            liveBackground = "#fde2e2";
                                            break;

                                        case "Offline":
                                            liveTextClass = "text-secondary";
                                            liveBackground = "#e9ecef";
                                            break;
                                    case "Live":
        liveBackground = "bg-success";
        liveTextClass = "text-white";
        break;
                                    }

                                    <tr>
                                        <td class="fw-bold text-dark">
                                            @item.Route
                                        </td>

                                        <td>
                                            @{
                                                var vehicle = item.Vehicle ?? "";

                                                if (vehicle.Contains("-"))
                                                {
                                                    var index =
                                                        vehicle.IndexOf("-");

                                                    @vehicle.Substring(0, index)
                                                    <br />
                                                    @vehicle.Substring(index)
                                                }
                                                else
                                                {
                                                    @vehicle
                                                }
                                            }
                                        </td>

                                        <td class="text-center">
                                            @item.Students
                                        </td>

                                        <td>
                                            @item.StartTime
                                        </td>

                                        <td>
                                            @item.EndTime
                                        </td>

                                        <td>
                                            @item.StopName
                                        </td>

                                        <td>
                                            @if (item.RouteStatus == "Route Time Completed")
                                            {
                                                <span>0 Min</span>
                                            }
                                            else if (item.ETA == "N/A")
                                            {
                                                <span class="text-muted">
                                                    N/A
                                                </span>
                                            }
                                            else if (item.EtaDifferenceMinutes.HasValue)
                                            {
                                                <span>
                                                    @Math.Abs(
                                                        item.EtaDifferenceMinutes.Value
                                                    ) Min
                                                </span>
                                            }
                                            else
                                            {
                                                <span>@item.ETA</span>
                                            }
                                        </td>

                                        <td>
                                            <span class="@routeTextClass fw-semibold"
                                                  style="font-size:0.72rem;
                                                         background:@routeBackground;
                                                         padding:5px 9px;
                                                         border-radius:5px;
                                                         white-space:nowrap;">
                                                @item.RouteStatus
                                            </span>
                                        </td>

                                        <td>
                                            <span class="@liveTextClass fw-semibold"
                                                  style="font-size:0.72rem;
                                                         background:@liveBackground;
                                                         padding:5px 9px;
                                                         border-radius:5px;
                                                         white-space:nowrap;">
                                                @item.VehicleLiveStatus
                                            </span>
                                        </td>
                                    </tr>
                                }
                            }
                          

                        </tbody>

                    </table>

                </div>

            </div>

            

        </div>

    </div>

</div>

@* vehicle Health model *@
<div class="modal fade sb-common-modal dashboard-table-modal"
     id="vehicleHealthModal"
     tabindex="-1"
     aria-labelledby="vehicleHealthModalLabel"
     aria-hidden="true">

    <div class="modal-dialog modal-dialog-centered modal-xl">

        <div class="modal-content">

            <div class="modal-header">
                <i class="bi bi-Truck-fill fs-5 px-2"></i>
                <h5 class="modal-title"
                    id="vehicleHealthModalLabel">
                    Vehicle Health
                </h5>

                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="modal"
                        aria-label="Close">
                </button>

            </div>

            <div class="modal-body">


                 <div class="w-100"
     id="vehicleHealthTableContainer"
     style="visibility:hidden;">

    <table class="table table-hover align-middle mb-0 w-100"
           id="vehicleHealthTable"
           style="width:100%;">

                            <thead>
                                <tr>
                                    <th style="text-align:center">S.No.</th>
                                    <th>Vehicle</th>
                                    <th>Temperature</th>
                                    <th>Battery</th>
                                    <th>Fuel</th>
                                    <th>Last Update</th>
                                </tr>
                            </thead>

                          <tbody>
    @{
        int sno = 1;

        var vehicles = ViewBag.VehicleHealth
            as IEnumerable<SchoolBuddy.Models.Dashboard.VehicleHealthModel>;
    }

    @if (vehicles != null && vehicles.Any())
    {
        foreach (var vehicle in vehicles)
        {
            var vehicleName = string.IsNullOrWhiteSpace(vehicle.Id)
                ? "N/A"
                : vehicle.Id;

            var match = System.Text.RegularExpressions.Regex.Match(
                vehicleName,
                @"^(.*?\d{4})(.*)$");

            DateTime istTime = vehicle.DateTime.AddMinutes(330);
            TimeSpan diff = DateTime.Now - istTime;

            string lastUpdate;

            if (diff.TotalSeconds < 60)
            {
                lastUpdate = $"{Math.Max(0, (int)diff.TotalSeconds)} sec ago";
            }
            else if (diff.TotalMinutes < 60)
            {
                lastUpdate = $"{(int)diff.TotalMinutes} min ago";
            }
            else if (diff.TotalHours < 24)
            {
                lastUpdate = $"{(int)diff.TotalHours} hr ago";
            }
            else
            {
                lastUpdate = $"{(int)diff.TotalDays} day(s) ago";
            }

            decimal battery = 0;

            bool hasBattery = decimal.TryParse(
                vehicle.battery_percent,
                out battery);

            <tr>
                <td class="text-center">
                    @sno
                </td>

                <td class="fw-bold text-dark" style="line-height:1.2;">
                    @if (match.Success)
                    {
                        @match.Groups[1].Value

                        @if (!string.IsNullOrWhiteSpace(match.Groups[2].Value))
                        {
                            <br />
                            @match.Groups[2].Value
                        }
                    }
                    else
                    {
                        @(vehicleName == "-" ? "N/A" : vehicleName)
                    }
                </td>

                <td class="text-muted">
                    @(string.IsNullOrWhiteSpace(vehicle.Temperature)
                        ? "N/A"
                        : vehicle.Temperature)
                </td>

                <td class="@(hasBattery
                    ? battery >= 60
                        ? "text-success fw-semibold"
                        : battery >= 30
                            ? "text-warning fw-semibold"
                            : "text-danger fw-semibold"
                    : "text-muted")">

                    @(hasBattery ? $"{battery}%" : "N/A")
                </td>

                <td>
                    @(string.IsNullOrWhiteSpace(vehicle.remaining_fuel) ||
                      vehicle.remaining_fuel == "N/A"
                        ? "N/A"
                        : vehicle.remaining_fuel)
                </td>

                <td class="text-muted">
                    @lastUpdate
                </td>
            </tr>

            sno++;
        }
    }
</tbody>

                        </table>

                    </div>


            </div>

            

        </div>

    </div>

</div>
