function clearAndFillAlertTable(alerts) {

    let table;

    /*
     * Get existing DataTable or initialize it.
     */
    if ($.fn.DataTable.isDataTable("#alertNotificationTable")) {

        table = $("#alertNotificationTable").DataTable();

        /*
         * Clear all old rows.
         */
        table.clear();

    } else {

        table = $("#alertNotificationTable").DataTable({
            pageLength: 10,
            lengthMenu: [5, 10, 25, 50],
            responsive: false,
            autoWidth: false,
            ordering: true,
            searching: true,
            info: true,
            paging: true,
            scrollY: "36vh",
            scrollCollapse: true,

            language: {
                search: "Search:",
                lengthMenu: "Show _MENU_ entries",
                info: "Showing _START_ to _END_ of _TOTAL_ entries",
                emptyTable: "No alerts found for selected date and time.",
                zeroRecords: "No matching alerts found"
            },

            columnDefs: [
                {
                    targets: 0,
                    orderable: false,
                    searchable: false
                }
            ],
             dom: 'Bfrtip',
    buttons: [
        'copy',
        'excel',
        'csv',
        'pdf',
        'print'
    ]
        });
    }

    /*
     * When response is empty, draw the empty DataTable.
     */
    if (!alerts || alerts.length === 0) {

        table.clear().draw();

        return;
    }

    const rows = alerts.map(function (item, index) {

        const message =
            item.Message ??
            item.message ??
            "-";

        const msgStatus =
            item.MsgStatus ??
            item.msgStatus ??
            item.msg_status ??
            "-";

        const sentOn =
            item.SentOn ??
            item.sentOn ??
            item.sent_on ??
            null;

        const isRead = Number(
            item.IsRead ??
            item.isRead ??
            item.is_read ??
            0
        );

        const vehicle = getVehicleFromMessage(message);

        const statusHtml = isRead === 1
            ? `
                <span class="alert-status-pill alert-seen text-success">
                    Seen
                </span>
              `
            : `
                <span class="alert-status-pill alert-unseen text-danger">
                    Unseen
                </span>
              `;

        return [
            index + 1,

            `
                <span class="alert-type-text">
                    ${escapeAlertHtml(msgStatus)}
                </span>
            `,

            `
                <span class="fw-semibold">
                    ${escapeAlertHtml(vehicle)}
                </span>
            `,

            `
                <span class="alert-message-cell">
                    ${escapeAlertHtml(message)}
                </span>
            `,

            `
                <span class="alert-date-cell">
                    ${formatAlertDate(sentOn)}
                </span>
            `,

            statusHtml
        ];
    });

    /*
     * Add new response rows.
     */
    table.rows.add(rows).draw();

    /*
     * Correct column width inside Bootstrap modal.
     */
    setTimeout(function () {
        table.columns.adjust().draw(false);
    }, 100);
    bindAlertNotificationTable(alerts);
}
