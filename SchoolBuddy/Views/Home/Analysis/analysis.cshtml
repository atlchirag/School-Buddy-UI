@using Newtonsoft.Json
@using System.Data

@{
    ViewData["Title"] = "Analysis";

    DataTable routeTable = new DataTable();

    try
    {
        string routeJson = Convert.ToString(ViewBag.RouteList);

        if (!string.IsNullOrEmpty(routeJson) &&
            routeJson != "[]" &&
            routeJson != "0" &&
            routeJson != "Data Not Found")
        {
            routeTable = JsonConvert.DeserializeObject<DataTable>(routeJson);
        }
    }
    catch
    {
        routeTable = new DataTable();
    }
}
