                                       aria-describedby="dataTables-example_info">
                                    <thead>
                                        <tr role="row" style="background-color:#C8D7E3">
                                            <th style="color:black">Route Name</th>
                                            <th style="color:black">Engine</th>
                                            <th style="color:black">Check Stops</th>
                                        </tr>
                                    </thead>

                                    <tbody>
                                        @if (routeTable != null && routeTable.Rows.Count > 0)
                                        {
                                            foreach (DataRow route in routeTable.Rows)
                                            {
                                                var isPisEnabled = false;

                                                try
                                                {
                                                    isPisEnabled = Convert.ToBoolean(route["is_pis_enabled"]);
                                                }
                                                catch
                                                {
                                                    isPisEnabled = Convert.ToString(route["is_pis_enabled"]) == "1";
                                                }

                                                <tr>
                                                    <td>@route["route_name"]</td>
                                                    <td>
                                                        @if (isPisEnabled)
                                                        {
                                                            <span class="badge bg-success">PIS</span>
                                                        }
                                                        else
                                                        {
                                                            <span class="badge bg-danger">Disable PIS</span>
                                                        }
                                                    </td>
                                                    <td>
                                                        <button type="button"
                                                                class="btn btn-sm btn-info"
                                                                onclick="handleActionClick1('@route["id"]')">
                                                            Action
                                                        </button>
                                                    </td>
                                                </tr>
                                            }
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </div>
