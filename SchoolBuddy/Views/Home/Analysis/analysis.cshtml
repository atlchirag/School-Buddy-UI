                                    <th style="color:black">Via No</th>
                                </tr>
                            </thead>
                        </table>
                    </div>
                </div>
            </div>

        </div>
    </div>
</div>

<!-- New Check ETA Modal -->
<div class="modal fade sb-common-modal" id="CheckEtaModal" tabindex="-1" aria-labelledby="CheckEtaModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">

            <div class="modal-header">
                <h5 class="modal-title" id="CheckEtaModalLabel">Route Stop ETA</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>

            <div class="modal-body">
                <div class="row">
                    <div class="mt-2 ms-2">
