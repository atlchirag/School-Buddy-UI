<!-- Existing Check Each Route Modal -->
<div class="modal fade sb-common-modal" id="CheckEachRoute" tabindex="-1" aria-labelledby="exampleModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">

            <div class="modal-header">
                <h1 class="modal-title fs-5" id="exampleModalLabel">Stops with vias point</h1>
