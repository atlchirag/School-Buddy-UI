        console.error('Error occurred:', error);
        Swal.fire('An error occurred while fetching data.');
        }
        });
        }

        function parseApiResponse(response) {
            if (typeof response !== 'string') {
                return response;
            }

            try {
                return JSON.parse(response);
            } catch (e) {
                return null;
            }
        }

        function getApiRecords(response) {
            response = parseApiResponse(response);

            if (!response || response.status === false || String(response.message || '').toLowerCase().includes('data not found')) {
                return [];
            }

            if (Array.isArray(response)) {
                return response;
            }

            if (Array.isArray(response.response)) {
                return response.response;
            }

            if (Array.isArray(response.data)) {
                return response.data;
            }

            if (response.data && Array.isArray(response.data.response)) {
                return response.data.response;
            }

            return [];
        }

        function tbl_student_sms_func(){
            var table = $("#tbl_student_sms").DataTable();
            table.clear().draw();

            var from = $("#date_picker1").val();
            var to = $("#date_picker2").val();
            var selectedValue = $('#ddl_student_search').val();

            if (!from || !to) {
                Swal.fire('Please select the date');
                return false;
            }

            if (!selectedValue) {
                Swal.fire('Please select a student');
                return false;
            }

            var dataToSend = {
                // The existing backend binds SelectedValues as List<string>.
                selectedValues: [selectedValue],
                from: from,
                to: to
            };

            $.ajax({
                url: '/schoolbuddy/Report/GetStudentReport',
                type: 'POST',
                contentType: 'application/json; charset=utf-8',
                data: JSON.stringify(dataToSend),
                success: function (response) {
                    var records = getApiRecords(response);

                    if (!records.length) {
                        table.clear().draw();
                        return;
                    }

                    var rows = records.map(function (item) {
                        return [
                            item.student_name || 'N/A',
                            item.admission_no || 'N/A',
                            item.route_name || 'N/A',
                            item.mobile_no || 'N/A',
                            item.message || 'N/A',
                            item.status || 'sent',
                            item.date_time || 'N/A'
                        ];
                    });

                    table.rows.add(rows).draw(false);
                },
                error: function (xhr, status, error) {
                    console.error('Error occurred:', error);
                    Swal.fire('An error occurred while fetching data.');
                }
            });
        }
