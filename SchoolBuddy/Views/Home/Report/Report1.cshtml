        function bindSms() {

    var table = $('#tblSms').DataTable();

    table.clear().draw();

    var from = $('#datepicker').val();

    if (!from) {
        Swal.fire('Please select the date');
        return false;
    }

    $.ajax({
        url: '@Url.Action("Index", "Report")',
        type: 'POST',
        data: {
            fdate: from
        },
        success: function (response) {

            let data = response;

            if (typeof response === 'string') {
                data = JSON.parse(response);
            }

            if (!data || data.length === 0) {
                Swal.fire('No data found');
                return;
            }

            let rows = data.map(item => [
                item.student_name || '',
                item.admission_no || '',
                item.route_name || '',
                item.mobile_no || '',
                item.message || '',
                'Sent'
            ]);

            table.rows.add(rows).draw();
        },
        error: function (xhr, status, error) {
            console.error(error);
            Swal.fire('An error occurred while fetching data.');
        }
    });
}

        function rfidreport() {
        // Clear existing data
        var table = $("#rfidreport").DataTable();
        table.clear().draw();

        var from = $("#datepicker4").val();
        if (!from) {
        Swal.fire('Please select the date');
        return false;
        }

        $.ajax({
        url: '/schoolbuddy/Report/GetRFIDReport', // Ensure this URL matches your endpoint
        type: 'POST',
        data: { fDate: from },
        success: function (response) {
        let data;
        try {
               data = JSON.parse(response);
        if (!data || data.length === 0) {
        Swal.fire('No data found');
        return;
        }
        } catch (e) {
        console.error('Failed to parse JSON:', e);
        Swal.fire('Failed to load data.');
        return;
        }

        // Prepare data array for bulk addition
        let rows = data.map(item => [
        item.route_name || "",
        item.total || "",
        item.punched || "",
        item.not_punched || "",
        item.other || ""
        ]);

        // Add all rows in a single operation
        table.rows.add(rows).draw();
        },
        error: function (xhr, status, error) {
        console.error('Error occurred:', error);
        Swal.fire('An error occurred while fetching data.');
        }
        });
        }
        function report() {
        var from = $("#datepicker3").val();
        if (!from) {
        Swal.fire('Please select the date');
        return false;
        }

        // Access the DataTable instance
        var table = $("#tbl_login_report").DataTable();

        // Clear existing data
        table.clear().draw();

        $.ajax({
        url: '/schoolbuddy/Report/GetLoginReport',
        type: 'POST',
        data: { fdate: from },
        success: function (response) {
        let data;
           data = JSON.parse(response);
        try {
        if (!data || data.length === 0) {
        Swal.fire('No data found');
        return;
        }
        } catch (e) {
        console.error('Failed to parse JSON:', e);
        Swal.fire('Failed to load data.');
        return;
        }

        // Prepare data array for bulk addition
