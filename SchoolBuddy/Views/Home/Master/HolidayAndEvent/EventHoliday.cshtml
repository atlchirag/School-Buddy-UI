@{
    ViewData["Title"] = "Events & Holidays";
}   
@model IEnumerable<holiday_list>
<style>
    #showholidays thead th {
        background-color: midnightblue !important;
        color: white !important;
    }

        #showholidays thead th * {
            color: white !important;
        }

    #showholidays thead th {
        padding-right: 25px !important;
        vertical-align: middle !important;
    }
</style>
<!-- Hidden input field for schoolid -->
<input type="hidden" id="schoolid" value="@Context.Session.GetString("uid")" />

<div class="card container-fluid">
    <div class="row">
        <div class="col-lg-12" style="margin-top:3vmin">
            <div class="card-header rounded-top" style="background-color:midnightblue;color:white;">
                <p style="font-weight:600;margin:0px">Holidays</p>
            </div>
            <div class="card-body rounded" style="background-color:white">
                <div class="layout divmarginoutsideicon">
                    <a class="btn btn-sm" asp-controller="Home" asp-action="CreateHoliday" title="Add Holiday" style="padding:0px">
                        <i style="font-size:36px" class="ri-add-circle-line center" aria-hidden="true"></i>
                    </a>
                </div>
                <div class="row scrollit mt-1" style="background-color:white;">
                    <div class="col-lg-12 table-responsive" style="width:100%">
                        <!-- Table with stripped rows -->
                        <table id="showholidays" class="table table-striped table-hover">
                            <thead>
                                <tr class="text-center" style="font-size:14px;background-color:midnightblue;color:white">
                                    <th class="text-center">S.No</th>
                                    <th class="text-center">From</th>
                                    <th class="text-center">To</th>
                                    <th class="text-center">Reason</th>
                                    <th class="text-center">Action</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (Model != null)

                                {

                                    int sno = 1;

                                    foreach (var holiday in Model)

                                    {
                                        <tr class="text-center" style="font-size:12px">
                                            <td class="text-center">@sno</td>
                                            <td class="text-center">@holiday.from_date</td>
                                            <td class="text-center">@holiday.to_date</td>
                                            <td class="text-center">@holiday.description</td>
                                            <td class="text-center">
                                                <!-- Edit Button -->
                                                <a href="#" class="edit-holiday"
                                                   data-id="@holiday.id"
                                                   data-start="@holiday.from_date"
                                                   data-end="@holiday.to_date"
                                                   data-event="@holiday.description"
                                                   data-status="@holiday.status">
                                                    <i class="ri-edit-box-line text-info tableicon"></i>
                                                </a>
                                                <!-- Delete Button -->
                                                <a href="#" class="delete-holiday" data-id="@holiday.id">
                                                    <i class="bi bi-trash text-danger tableicon"></i>
                                                </a>
                                            </td>
                                        </tr>
                                        sno++;

                                    }

                                }
                            </tbody>
                        </table>
                        <!-- End Table with stripped rows -->
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Holiday Modal -->
<div class="modal fade sb-common-modal" id="holidayModal" tabindex="-1" aria-labelledby="holidayModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="holidayModalLabel">Add/Edit Holiday</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <input type="hidden" id="holidayId" />
                <input type="hidden" id="modalSchoolId" />

                <div class="row">
                    <div class="col-lg-6">
                        <label for="opt">Holiday</label>
                        <input id="holidayRadio" name="opt" value="0" type="radio" />
                    </div>
                    <div class="col-lg-6">
                        <label for="opt">Event</label>
                        <input id="eventRadio" value="1" name="opt" type="radio" />
                    </div>
                </div>

                <div class="row mt-2">
                    <div class="col-lg-6">
                        <label>From</label>
                        <input id="start" class="form-control" type="date" />
                    </div>
                    <div class="col-lg-6">
                        <label>To</label>
                        <input id="end" class="form-control" type="date" />
                    </div>
                </div>
                <div class="row mt-2">
                    <div class="col-lg-6">
                        <label>Name of Holiday/Event</label>
                    </div>
                    <div class="col-lg-6">
                        <input id="eventname" class="form-control" type="text" />
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                <button type="button" id="saveHoliday" class="btn btn-primary">Save</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            $("#showholidays").DataTable();
            var selectedHolidayId = null;

            var schoolid = $("#schoolid").val(); // Get schoolid from hidden input

            // Open Modal for Editing Holiday
                $(document).on("click", ".edit-holiday", function () {
                selectedHolidayId = $(this).data("id");
                $("#holidayModalLabel").text("Edit Holiday");
                $("#holidayId").val(selectedHolidayId);
                $("#start").val($(this).data("start"));
                $("#end").val($(this).data("end"));
                $("#eventname").val($(this).data("event"));
                $("#modalSchoolId").val(schoolid);

                // ✅ Auto-select the correct status
                var status = $(this).data("status");
                if (status === "0") {
                    $("#holidayRadio").prop("checked", true);
                } else {
                    $("#eventRadio").prop("checked", true);
                }

                $("#holidayModal").modal("show");
            });

            // Save or Update Holiday
            $("#saveHoliday").click(function () {
                var id = $("#holidayId").val();
                var eventName = $("#eventname").val();
                var startDate = $("#start").val();
                var endDate = $("#end").val();
                var status = $("input[name='opt']:checked").val();
                var schoolid = $("#modalSchoolId").val(); // ✅ Ensure schoolid is passed

                if (!eventName || !startDate || !endDate || !status) {
                    alert("Please fill all fields, including status.");
                    return;
                }

                var holidayData = {
                    id: id ? parseInt(id) : 0,
                    start: startDate,
                    end: endDate,
                    eventname: eventName,
                    schoolid: schoolid, // ✅ Fetch schoolid dynamically
                    status: status
                };

                console.log("📤 Sending Data to API:", holidayData);

                $.ajax({
                    url: id ? "/schoolbuddy/Home/UpdateHoliday" : "/schoolbuddy/Home/AddHoliday",
                    type: "POST",
                    contentType: "application/json",
                    data: JSON.stringify(holidayData),
                    success: function (response) {
                        console.log("📥 Response:", response);
                        alert(response.message);
                        $("#holidayModal").modal("hide");
                        location.reload();
                    },
                    error: function (xhr) {
                        console.log("❌ Error:", xhr.responseText);
                        alert("Error saving holiday.");
                    }
                });
            });

            // 🗑️ Delete Holiday Function
            $(document).on("click", ".delete-holiday", function () {
                var holidayId = $(this).data("id");
                var schoolid = $("#schoolid").val(); // ✅ Ensure schoolid is included

                if (!confirm("Are you sure you want to delete this holiday?")) {
                    return;
                }

                // ✅ Only passing required fields (id & schoolid)
                var deleteData = {
                    id: holidayId,
                    schoolid: schoolid
                };

                console.log("📤 Sending Delete Request:", deleteData);

                $.ajax({
                    url: "/schoolbuddy/Home/DeleteHoliday",
                    type: "POST",
                    contentType: "application/json",
                    data: JSON.stringify(deleteData),
                    success: function (response) {
                        alert(response.message);
                        location.reload();
                    },
                    error: function (xhr) {
                        console.log("❌ Delete Error:", xhr.responseText);
                        alert("Error deleting holiday.");
                    }
                });
            });

        });
    </script>
}
