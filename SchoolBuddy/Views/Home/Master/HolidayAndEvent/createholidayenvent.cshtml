
@{
    ViewData["Title"] = "createholidayenvent";
}


<div class="container-fluid">
    <div class="row">
        <div class="col-lg-12" style="padding:0px">
            <div class="card-header rounded-top " style="background-color:midnightblue;color:white;">
                <p style="font-weight:600;margin:0px">Create Holiday & Event</p>
            </div>
            <div class="card-body rounded" style="background-color:white;">
                <div>
                    <div class="rounded-circle" style="width:3%; height:auto; border:2px solid midnightblue">
                        <a href="/Event&Holiday"><i class="fa fa-angle-left ms-2" style="font-size: 20px;font-weight: 700;color: midnightblue;"></i></a>
                    </div>
                </div>
                <div class="row mt-3">
                    <div class="col-6">
                        <label>School</label>
                        <span style="color:red">*</span>
                        <select type="text" class="form-control inputbackgroundcolor">
                            <option>
                                Please Select School
                            </option>
                            <option>
                                MDAV
                            </option>
                        </select>
                    </div>

                      <div class="col-6">
                        <label>Type</label>
                        <span style="color:red">*</span>
                        <select type="text" class="form-control inputbackgroundcolor">
                            <option>
                                Please Select Type
                            </option>
                            <option>
                                MDAV
                            </option>
                        </select>
                    </div>

                </div>

                <div class="row mt-3">
                    <div class="col-6">
                        <label>Class</label>
                        <span style="color:red">*</span>
                        <select type="text" class="form-control inputbackgroundcolor">
                            <option>
                                Please Select Class
                            </option>
                            <option>
                                MDAV
                            </option>
                        </select>
                    </div>

                    <div class="col-6">
                        <label>Devision</label>
                        <span style="color:red">*</span>
                        <select type="text" class="form-control inputbackgroundcolor">
                            <option>
                                Please Select Devision
                            </option>
                            <option>
                                MDAV
                            </option>
                        </select>
                    </div>

                </div>

                 <div class="row mt-3">
                 <div class="col-4">
                     <label>Name</label>
                     <span style="color:red">*</span>
                     <input type="text" class="form-control inputbackgroundcolor" />
                 </div>
                    <div class="col-4">
                        <label>Start Date</label>
                        <span style="color:red">*</span>
                        <input type="date" class="form-control inputbackgroundcolor" />

                    </div>
                    <div class="col-4">

                        <label>End On</label>
                    
                     <input type="date" class="form-control inputbackgroundcolor" />
                    </div>



             </div>

             <div class="d-flex justify-content-center align-content-center mt-5">
                 <button class="btn" style="border:2px solid midnightblue;color:midnightblue">Save</button>
             </div>


            </div>


        </div>
    </div>



</div>



