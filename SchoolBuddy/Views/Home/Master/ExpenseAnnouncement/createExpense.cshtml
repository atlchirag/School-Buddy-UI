
@{
    ViewData["Title"] = "createExpense";
}


<div class="container-fluid">
    <div class="row">
        <div class="col-lg-12">
            <div class="card-header rounded-top mt-2" style="background-color:midnightblue;color:white;">
                <p style="font-weight:600;margin:0px">Create Expense</p>
            </div>
            <div class="card-body rounded" style="background-color:white;">
                <div>
                    <div class="rounded-circle" style="width:3%; height:auto; border:2px solid midnightblue">
                        <a href="/expenseannouncement"><i class="fa fa-angle-left ms-2" style="font-size: 20px;font-weight: 700;color: midnightblue;"></i></a>
                    </div>
                </div>
                <div class="row mt-3">
                    <div class="col-6">
                        <label>Object</label>
                        <span style="color:red">*</span>
                        <select type="text" class="form-control inputbackgroundcolor">
                            <option>
                                Please Select Object
                            </option>
                            <option>
                                MDAV
                            </option>
                        </select>
                    </div>

                    <div class="col-3">
                        <label>Type</label>
                        <span style="color:red">*</span>
                        <div class="row">
                            <div class="col-6">
                                <input type="radio" name="expensetype" />
                                <label>Variable</label>
                            </div>
                            <div class="col-6">
                                <input type="radio" name="expensetype" />
                                <label>Fix</label>
                            </div>
                        </div>
                        
                       
                    </div>

                    <div class="col-3">
                        <label>Consider Job</label>
                        <div class="row">
                            <div class="col-12">
                                <input type="checkbox" class=" inputbackgroundcolor" name="considerjob" />
                            </div>

                        </div>
                       
                    </div>

                </div>

                <div class="row mt-3">
                    <div class="col-4">
                        <label>Expense Date</label>
                        <span style="color:red">*</span>
                        <input type="date" class="form-control inputbackgroundcolor">
                    </div>

                    <div class="col-4">
                        <label>Type</label>
                        <span style="color:red">*</span>
                        <select type="text" class="form-control inputbackgroundcolor">
                            <option>
                                Please Select Devision
                            </option>
                            <option>
                                MDAV
                            </option>
                        </select>
                    </div>


                    <div class="col-4">
                        <label>Amount</label>
                        <span style="color:red">*</span>
                        <input type="text" class="form-control inputbackgroundcolor">
                           
                    </div>
                </div>

                <div class="row mt-3">
                    <div class="col-4">
                        <label>Ref Number</label>
                      
                        <input type="text" class="form-control inputbackgroundcolor" />
                    </div>
                    <div class="col-4">
                        <label>Odometer</label>
                      
                        <input type="text" class="form-control inputbackgroundcolor" />

                    </div>
                    <div class="col-4">

                        <label>Work Hour</label>

                        <input type="text" class="form-control inputbackgroundcolor" />
                    </div>

                </div>




                <div class="row mt-3">
                    <div class="col-4">
                        <label>Bill Upload</label>
                      
                        <input type="file" class="form-control inputbackgroundcolor" />
                    </div>
                    <div class="col-8">
                        <label>Description</label>
                       
                        <input type="text" class="form-control inputbackgroundcolor" />

                    </div>
                  

                </div>

                <div class="d-flex justify-content-center align-content-center mt-5">
                    <button class="btn" style="border:2px solid midnightblue;color:midnightblue">Save</button>
                </div>


            </div>


        </div>
    </div>



</div>

