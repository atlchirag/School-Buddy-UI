<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
<script>
    document.addEventListener('DOMContentLoaded', function () {

    const birthEl = document.getElementById('birth');
    const acadEl = document.getElementById('academicYear');
    const errEl = document.getElementById('dobError');

    function validateDOB() {

    if (!birthEl.value || !acadEl.value) {
    errEl.innerText = '';
    return;
    }

    const dob = new Date(birthEl.value);
    const acadVal = acadEl.value.trim();

    let acadYear;

    if (acadVal.includes(',')) {
    acadYear = parseInt(acadVal.split(',')[1], 10);
    }
    else if (acadVal.includes('-')) {
    acadYear = parseInt(acadVal.split('-')[0], 10);
    }
    else {
    acadYear = parseInt(acadVal, 10);
    }

    if (isNaN(acadYear)) {
    errEl.innerText = 'Invalid Academic Year.';
    return;
    }

    const age = acadYear - dob.getFullYear();

    if (age < 2) {
    errEl.innerText = 'The Difference Between The Acadmic Year and DOB to be at least 2 years';
    }
    else {
    errEl.innerText = '';
    }
    }

    birthEl.addEventListener('change', validateDOB);
    acadEl.addEventListener('change', validateDOB);
    });
</script>
<script>

    $(document).ready(function () {
        var successMessage = '@TempData["SuccessMessage"]';
        var errorMessage = '@TempData["ErrorMessage"]';

        if (successMessage && successMessage.trim() !== '') {
            Swal.fire({
                icon: 'success',
                title: 'Success',
                text: successMessage,
                confirmButtonColor: '#28a745',
                confirmButtonText: 'OK'
            });
        }

        if (errorMessage && errorMessage.trim() !== '') {
            Swal.fire({
                icon: 'error',
                title: 'Error',
                text: errorMessage,
                confirmButtonColor: '#3085d6',
                confirmButtonText: 'OK'
            });
        }
    });


</script>
<script>
document.addEventListener("DOMContentLoaded", function () {

    const form = document.getElementById("studentForm");

    if (!form) {
        return;
    }

    // Set maximum length for all text and email fields
    const allTextFields = form.querySelectorAll(
        'input[type="text"], input[type="email"]'
    );

    allTextFields.forEach(function (field) {

        // Address already has maximum 150
        if (field.id === "street" || field.name === "street") {
            field.maxLength = 150;
        }
        // Do not overwrite mobile maxlength=10 or RFID maxlength=8
        else if (!field.hasAttribute("maxlength")) {
            field.maxLength = 100;
        }
    });

    // Remove whitespace validation error while typing
    form.addEventListener("input", function (event) {

        const field = event.target;

        if (
            field.matches(
                'input[required][type="text"], ' +
                'input[required][type="email"]'
            )
        ) {
            if (field.value.trim().length > 0) {
                field.setCustomValidity("");
                field.classList.remove("is-invalid");
            }
        }
    });

    // Validate before submitting
    form.addEventListener("submit", function (event) {

        let firstInvalidField = null;

        const requiredFields = form.querySelectorAll(
            'input[required][type="text"], ' +
            'input[required][type="email"]'
        );

        requiredFields.forEach(function (field) {

            // Remove starting and ending spaces
            field.value = field.value.trim();

            // Block empty or whitespace-only values
            if (field.value.length === 0) {

                field.setCustomValidity(
                    "This field cannot contain only spaces."
                );

                field.classList.add("is-invalid");

                if (!firstInvalidField) {
                    firstInvalidField = field;
                }
            }
            else {
                field.setCustomValidity("");
                field.classList.remove("is-invalid");
            }
        });

        if (firstInvalidField) {
            event.preventDefault();
            event.stopPropagation();

            firstInvalidField.focus();
            firstInvalidField.reportValidity();
        }
    });
});
</script>