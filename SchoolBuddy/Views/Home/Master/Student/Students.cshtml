<div class="card container-fluid students-page">
    <div class="row">
        <div class="col-lg-12" style="margin-top:3vmin">
            <div class="card-header rounded-top" style="background-color:midnightblue;color:white;">
                <p style="font-weight:600;margin:0px">Student</p>
            </div>
            <div class="card-body rounded students-card-body">
                <div class="d-flex justify-content-between align-items-center mb-2">
                    <div class="divmarginoutsideicon">
                        <a class="btn btn-sm iconstyle" asp-controller="Home" asp-action="AddStudent" title="Add Student">
                            <i class="bi bi-person-fill-add" aria-hidden="true"></i>
                        </a>

                        <a class="btn btn-sm iconstyle" asp-controller="Home" asp-action="StudentBulkUpload" title="Upload Excel For Bulk Student">
                            <i class="bi bi-upload" aria-hidden="true"></i>
                        </a>

                        <a class="btn btn-sm iconstyle" asp-controller="Home" asp-action="DownloadStudentsExcel" title="Download Student Excel">
                            <i class="bi bi-file-earmark-excel-fill text-success" aria-hidden="true"></i>
                        </a>
                    </div>

                    <div>
                        <a class="btn btn-success btn-sm" asp-controller="Home" asp-action="RFIDBulkUpload" title="Upload RFID Excel">
                            <i class="bi bi-upload"></i> RFID Template
                        </a>
                    </div>
                </div>

                <div class="row scrollit mt-1 students-table-panel">
                    <div class="col-lg-12 table-responsive" style=" width:100%">
                        <!-- Table with stripped rows -->
                        <table id="students" class="table table-striped table-hover">
                            <thead>
                                <tr class="text-center" style="font-size:12px;background-color:midnightblue;color:white">
                                    <th class="text-center">S.No</th>
                                    <th class="text-center">Ad No</th>
                                    <th class="text-center">Student Name</th>
                                    @* <th class="text-center">Gender</th> *@
                                    @* <th class="text-center">Birth</th> *@
                                    <th class="text-center">Class</th>
                                    <th class="text-center">Division</th>
                                    <th class="text-center">Parent Name</th>
                                    <th class="text-center">Mobile Number</th>
                                    <th class="text-center">Address</th>
                                    <th class="text-center">Pwd</th>

                                    @*<th class="text-center">Created Date</th>*@
                                    <th class="text-center">RFID Tag</th>
                                    @* <th class="text-center">Email</th> *@
                                    @* <th class="text-center">Relation with Std</th>
                                    <th class="text-center">Blood Group</th>

                                    <th class="text-center">QRCode</th>*@
                                    <th class="text-center">Action</th>
                                </tr>
                            </thead>
                            <tbody>


                                @{
                                    if (Model != null)
                                    {
                                        int sno = 1;
                                        foreach (var student in Model)
                                        {

                                            <tr class="text-center" style="font-size:12px">
                                                <td class="text-center">@sno</td>
                                                <td class="text-center">@student.admission_no</td>
                                                <td class="text-center">@student.student_name</td>
                                                
                                                <td class="text-center">@student.class_</td>
                                                <td class="text-center">@student.division</td>
                                                <td class="text-center">@student.parent_name</td>
                                                <td class="text-center">@student.mobile_no1</td>
                                                <td class="text-center">@student.street</td>
                                                <td class="text-center">@student.password</td>
                                                @*<td class="text-center">@student.created_date</td>*@
                                                <td class="text-center">@student.rf_id</td>

                                                @*<td class="text-center fs-6">@student.relation_with_std</td>
                                    <td class="text-center fs-6">@student.blood_group</td>
                                    <td class="text-center fs-6">@student.qr_code</td>*@
                                                <td class="text-center fs-6">
                                                    <a asp-controller="Home" asp-action="Students" asp-route-id="@student.id"><i class="bi bi-pencil-square text-info tableicon"></i></a>
                                                    <a asp-controller="Home" asp-action="deleteStudent" asp-route-id="@student.id"><i class="bi bi-trash text-danger tableicon"></i></a>
                                                </td>

                                            </tr>
                                            sno++;
                                        }
                                    }

                                }
                            </tbody>
                        </table>
                        <!-- End Table with stripped rows -->
                    </div>

                </div>

                <!-- Modal for Missing Admission Nos -->
                <div class="modal fade sb-common-modal" id="missingAdNoModal" tabindex="-1" aria-labelledby="missingAdNoLabel" aria-hidden="true">
                    <div class="modal-dialog modal-dialog-centered modal-lg">
                        <div class="modal-content">
                            <div class="modal-header">
                                <h5 class="modal-title" id="missingAdNoLabel">⚠️ Missing Admission Numbers</h5>
                                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                            </div>
                            <div class="modal-body">
                                <p>The following Admission Numbers do not exist in the system:</p>
                                <textarea id="admissionNoList" class="form-control" rows="10" readonly></textarea>
                            </div>
                            <div class="modal-footer">
                                <button class="btn btn-secondary" onclick="copyAdmissionNos()">📋 Copy</button>
                                <button class="btn btn-primary" data-bs-dismiss="modal">Close</button>
                            </div>
                        </div>
                    </div>
                </div>



            </div>
        </div>
    </div>



</div>

<!-- Bootstrap & jQuery -->


<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

<script>
    $(document).ready(function () {
        $("#students").DataTable();

    var successMessage = '@TempData["SuccessMessage"]';
    var errorMessage = '@TempData["ErrorMessage"]';
    var errorListRaw = @Html.Raw(JsonConvert.SerializeObject(TempData["ErrorList"] ?? new List<string>()));

        // Log values for debug
        console.log("✅ successMessage:", successMessage);
        console.log("✅ errorMessage:", errorMessage);
        console.log("✅ errorListRaw (type):", typeof errorListRaw, errorListRaw);

        // Priority: show error popup if there is an ErrorMessage and no error list modal
        if (errorMessage && (!errorListRaw || errorListRaw.length === 0)) {
            setTimeout(() => {
                Swal.fire({
                    icon: 'error',
                    title: 'Error',
                    text: errorMessage,
                    confirmButtonColor: '#dc3545',
                    confirmButtonText: 'OK'
                });
            }, 300);
        }

        // Show success popup only when there's a success message and no other errors
        else if (successMessage && (!errorListRaw || errorListRaw.length === 0)) {
    setTimeout(() => {
    Swal.fire({
    icon: 'success',
    title: 'Success',
    text: successMessage,
    confirmButtonColor: '#28a745',
    confirmButtonText: 'OK'
    });
    }, 300);

        }

        // ✅ Case 2: Show missing admission modal if errors exist
        if (Array.isArray(errorListRaw) && errorListRaw.length > 0) {
            let admissionNos = errorListRaw.map(msg => {
                const match = msg.match(/Admission No ['"]?(\d+)['"]?/);
                return match ? match[1] : null;
            }).filter(n => n !== null);

            let distinct = [...new Set(admissionNos)];
            let finalText = distinct.join('\n');

            $("#admissionNoList").val(finalText);

            const modal = new bootstrap.Modal(document.getElementById('missingAdNoModal'));
            modal.show();
        }
    });

        function copyAdmissionNos() {
        const textarea = document.getElementById("admissionNoList");
        textarea.select();
        textarea.setSelectionRange(0, 99999);
        document.execCommand("copy");

        Swal.fire({
            icon: 'success',
            title: 'Copied',
            text: 'Admission Numbers copied to clipboard.',
            confirmButtonColor: '#28a745',
            confirmButtonText: 'OK'
        });
    }
</script>





