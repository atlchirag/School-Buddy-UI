
@{
    ViewData["Title"] = "Create Route";
}


<div class=" card container">
    <div class="row">

        <div class="col-lg-12">
            <div class="card-header rounded-top" style="background-color:midnightblue;color:white;">
                <p style="font-weight:600;margin:0px">Create Route</p>
            </div>
            <div class="card-body rounded" style="background-color:white;position:relative;top:25px;left:25px;width:1054px">
                <div id="googleMap" style="width:100%;height:270px;"></div>
                <div>
                   
                </div>
            </div>


        </div>

    </div>
</div>




<script src="https://maps.googleapis.com/maps/api/js?key=AIzaSyBbjIxsdDNnpgJ5afaqhkJqfYGHPeYKBkI&sensor=false"></script>

@section Scripts{
    <script>

        $(document).ready(function () {
            myMap();
        })

        function myMap() {
            directionsDisplay = new google.maps.DirectionsRenderer({

                draggable: true

            });
            var mapProp = {
                center: new google.maps.LatLng(51.508742, -0.120850),
                zoom: 5,
            };
            var map = new google.maps.Map(document.getElementById("googleMap"), mapProp);
        }

        function togglecheck(checkbox) {
            if (checkbox.checked) {
                //unchecked other checkbox
                var checkboxes = document.querySelectorAll('input[name="option"]');
                checkboxes.forEach(function (item) {
                    if (item != checkbox) {
                        item.checked = false;
                    }
                })

            }
        }
        function togglecheck1(checkbox) {
            if (checkbox.checked) {
                var checkboxes = document.querySelectorAll('input[name="option_"]');
                checkboxes.forEach(function (item) {
                    if (item != checkbox) {
                        item.checked = false;
                    }
                })
            }
        }
    </script>


}


