        // ------- GPS de-noise -------
        function denoise(points) {
        // drops zero coords, duplicate-timestamps, teleports & absurd speeds
        const out = [];
        for (let i = 0; i < points.length; i++) {
        const p = points[i];
        if (Math.abs(p.lat) < 0.001 && Math.abs(p.lng) < 0.001) continue;

        if (out.length === 0) { out.push(p); continue; }

        const prev = out[out.length - 1];
        const dt = (p.time - prev.time) / 1000;         // sec
        const d  = haversine(prev, p);                  // meters
        const v  = dt > 0 ? d / dt : 0;                 // m/s

        // drop duplicates or crazy hops
        if (dt < 1) continue;                           // duplicate stamp
        if (d > 250 && dt < 5) continue;                // teleport spike
        if (v > 45) continue;                           // >162 km/h — impossible for school bus

        out.push(p);
        }
        return out;
        }


        function detectStops(points, {
        driftMeters = 30,     // how far the bus can drift and still be considered stationary
        minSeconds  = 10,     // your requirement
        minSamples  = 2,      // need at least 2 telemetry points inside the stop window
        maxAvgSpeed = 1.5     // m/s ~ 5.4 km/h to filter creeping
        } = {}) {
        const stops = [];
        let i = 0;

        while (i < points.length) {
        const start = points[i];
        let j = i + 1;
        let last = start;
        let distAccum = 0;
        let prev = start;

        while (j < points.length) {
        const dFromStart = haversine(start, points[j]);   // meters from the start point
        const seg = haversine(prev, points[j]);           // segment distance for avg speed
        distAccum += seg;
        prev = points[j];

        if (dFromStart > driftMeters) break;

        last = points[j];
        j++;
        }

        const duration = (last.time - start.time) / 1000;   // seconds
        const avgSpeed = duration > 0 ? distAccum / duration : 0;
        const sampleCount = j - i;

        if (duration >= minSeconds && sampleCount >= minSamples && avgSpeed <= maxAvgSpeed) {
        const center = { lat: (start.lat + last.lat) / 2, lng: (start.lng + last.lng) / 2 };
        stops.push({ center, start, end: last, durationSec: duration });
        }

        i = Math.max(j, i + 1);
        }
        return stops;
        }




        // ------- cluster stops so overlapping circles become one -------
        function clusterStops(stops, mergeRadiusMeters = 60) {
        const clusters = [];
        for (const s of stops) {
        let k = -1;
        for (let i = 0; i < clusters.length; i++) {
        const c = clusters[i];
        if (haversine(s.center, c.center) <= mergeRadiusMeters) { k = i; break; }
        }
        if (k >= 0) {
        const c = clusters[k];
        const total = c.totalDur + s.durationSec;
        // weighted centroid by duration
        c.center.lat = (c.center.lat * c.totalDur + s.center.lat * s.durationSec) / total;
        c.center.lng = (c.center.lng * c.totalDur + s.center.lng * s.durationSec) / total;
        c.totalDur = total;
        c.count += 1;
        } else {
        clusters.push({ center: { ...s.center }, totalDur: s.durationSec, count: 1 });
        }
        }
        return clusters;
        }

