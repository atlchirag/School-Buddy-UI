        async function loadMultiDayRoute(schoolId, routeId, startDate, endDate) {
        // NEW: show popup while rendering
        showRenderNotice();

        try {
        clearGraphics();

        const res = await fetch(uiHaltsUrl, {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({
        schoolId: schoolId,
        routeId: routeId,
        startDate: startDate,
        endDate: endDate
        })
        });
        if (!res.ok) {
        console.error("Halts API error:", res.status, await res.text());
        return;
        }
        const daysData = await res.json();

        const allStops = [];
        const bounds = new google.maps.LatLngBounds();

        daysData.forEach((day, idx) => {
        const color = COLORS[idx % COLORS.length];
        const raw = (day.points || []).map(p => ({ lat: p.latitude, lng: p.longitude, time: new Date(p.gpsTime) }));

        // 1) de-noise
        const cleaned = denoise(raw);
        // 2) simplify (20–30m tolerance works well in cities)
        const simplified = rdp(cleaned, 25);

        // draw a lighter polyline
        if (simplified.length) {
        simplified.forEach(pt => bounds.extend(pt));
        const polyline = new google.maps.Polyline({
        path: simplified, geodesic: true,
        strokeColor: color, strokeOpacity: 0.7, strokeWeight: 2
        });
        polyline.setMap(map);
        polylines.push(polyline);
        }

        // detect stops on cleaned data (>=10s)
        const stops = detectStops(cleaned, { driftMeters: 30, minSeconds: 10, minSamples: 2, maxAvgSpeed: 1.5 });
        for (const s of stops) allStops.push({ ...s, day: idx });
        });

        // 3) cluster overlapping stops across all days
        const clusters = clusterStops(allStops, 60); // merge radius ~60m

        // lastClusters = clusters;

        lastClusters = clusters;
        // draw one circle per cluster, size by total duration
        clusters.forEach(c => {
        const r = Math.min(30 + (c.totalDur/60)*5, 120); // scale with minutes
        const circle = new google.maps.Circle({
        map, center: c.center, radius: r,
        strokeColor: "#FF3B30", strokeOpacity: 0.95, strokeWeight: 2,
        fillColor: "#FF3B30", fillOpacity: 0.25
        });
        const info = new google.maps.InfoWindow({
        content: `<div style="font:12px/1.4 sans-serif">
        <b>Stop cluster</b><br/>
        Occurrences: ${c.count}<br/>
        Total duration: ${(c.totalDur/60).toFixed(1)} min
        </div>`
        });
        circle.addListener("click", () => {
        openStopModal({ lat: c.center.lat, lng: c.center.lng });
        info.setPosition(c.center); info.open({ map }); });
        haltCircles.push(circle);
        });

        if (!bounds.isEmpty()) map.fitBounds(bounds);


        try {
        const existing = await fetchExistingStops(routeId);
        drawExistingStops(existing);
        } catch (e) {
        console.warn("Existing stops fetch failed:", e);
        }

            
