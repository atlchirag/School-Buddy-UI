@section Scripts{
        <script src="https://maps.googleapis.com/maps/api/js?key=AIzaSyBbjIxsdDNnpgJ5afaqhkJqfYGHPeYKBkI&sensor=false"></script>

        <script src="~/js/trip.js"></script>
        <script>

        $(document).ready(function () {

            $("#stop").DataTable();
        })

        @if (TempData["res"] != null)
        {
            <text>
                toastr.success('@TempData["res"]');
            </text>
        }
        @if (TempData["result"] != null)
        {
            var res = TempData["result"];
            @if (res.ToString().Contains("wrong"))
            {
                <text>
                    toastr.error('@TempData["result"]');
                </text>
            }
            @if (res.ToString().Contains("valid Excel Sheet"))
            {
                <text>
                    toastr.error('@TempData["result"]');
                </text>
            }
                         @if (res.ToString().Contains("already"))
                {
                        <text>
                                toastr.error('@TempData["result"]');
                        </text>
                }
            else
            {
                <text>
                    toastr.success('@TempData["result"]');
                </text>
            }
        }
        function addStudent(stopid){
                var table = $('#table_assigned_students').DataTable();
                table.clear().draw();
            $.ajax({
                type:'POST',
                data:{stopid:stopid},
                    url: '/schoolbuddy/Route/checkAssignedStudents',
                success:function(response){
                    //var sno = 0;
                    var res = JSON.parse(response);
                        let rows = res.map(item => [

                            item.student_name || "", // Handle potential missing properties
                            item.rf_id || ""
            
                        ]);

                        table.rows.add(rows).draw();
                },
                error:function(){
                    console.log('opps!!!');
                }
            })



            $('#assignstudentmodal').modal('show')
        }
            function addStop(){
                const url = new URL(window.location.href);
                const id = url.searchParams.get('id');
                console.log(id);
            $('#stop_modal').val(id);
            $('#addstopmodal').modal('show')
            }
            function deletestop(stopid){
            const url = new URL(window.location.href);
            const routeid = url.searchParams.get('id');
            console.log(stopid, routeid);
            console.log("");
            Swal.fire({
                title: "Are you sure?",
                text: "You won't be able to revert this!",
                icon: "warning",
                showCancelButton: true,
                confirmButtonColor: "#3085d6",
                cancelButtonColor: "#d33",
                confirmButtonText: "Yes, delete it!"
            }).then((result) => {
                if (result.isConfirmed) {
                    $.ajax({
                        type: 'POST',
                        url: '/schoolbuddy/Route/deleteStop',
                        data: { stopid: stopid, rid : routeid},
                        success:function response(){
                            if(response){
                                document.getElementById(stopid).remove();

                            }
                        }
                        
                        ,//function response(){
                        //    if(response){
                        //        window.location.reload();
                        //    }
                        //    window.location.reload();
                        //},
                        error: function (xhr, status, error) {
                            Swal.fire({
                                title: "Something Went Wrong!",
                                text: error,
                                icon: "error"
                            });
                        }
                        

                    });
                }
            });
                
            }

                    function openEditStopModal(stopId, stopName, latitude, longitude) {
            // Fill the form inputs
            $('#edit_stop_id').val(stopId);
            $('#edit_stopname').val(stopName);
            $('#edit_lat').val(latitude);
            $('#edit_lng').val(longitude);

            // Show the modal
            $('#editstopmodal').modal('show');
        }


          function addsingalstudent(stopid){
              //alert('hii');
            $('#exampleModal12').modal('show')
          }
        
            
        </script>



    
        

}


