                    //             s.father_name || '',
                    //             s.class_name || '',
                    //             s.mobile_no1 || '',
                    //             s.rf_id || '',
                    //             s.admission_no || '',
                    //             s.pick_stop_name || '',
                    //             s.drop_stop_name || '',
                    //             s.stop_name || ''
                    //         ]);
                    //         studentWiseTable.rows.add(rows).draw();
                    //     } else {
                    //     studentWiseTable.row.add(['No bus service students found', '', '', '', '', '', '', '', '', '']).draw();
                    //     }
                    // },
                    // error: function () {
                    // studentWiseTable.row.add(['Error fetching data', '', '', '', '', '', '', '', '']).draw();
                    // }
                    success: function(res) {

                        studentWiseTable.clear();

                        if (Array.isArray(res) && res.length > 0) {

                            const rows = res.map(s => [

                                s.student_name || '',

                                s.father_name || '',

                                s.class_name || '',

                                s.mobile_no1 || '',

                                s.rf_id || '',

                                s.admission_no || '',

                                s.pick_route_name || '',

                                s.drop_route_name || '',

                                s.stop_name || '',

                                `
                         <div class="d-flex justify-content-center gap-3">

                    <a onclick='openEditStudentModal(${JSON.stringify(s)})'
               title="Migrate Student">

                        <i class="bi bi-pencil-square text-primary"
                           style="font-size:1rem;
                                  font-weight:500;
                                  cursor:pointer;">
                        </i>

                    </a>

                    <a onclick="deleteStudent('${s.student_id}')"
                       title="Unassign Student">

                        <i class="bi bi-trash text-danger"
