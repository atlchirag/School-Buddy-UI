@using Newtonsoft.Json
@{
    ViewData["Title"] = "Routes";
}
@model IEnumerable<routedetails>

<style>
    /*input[type="datetime-local"]::-webkit-datetime-edit-fields-wrapper {
            color: transparent;
        }*/
    input[type=radio] {
        width: 10px;
        height: auto;
        border: 2px solid midnightblue
    }

    .layout {
        display: flex
    }

    .iconlayout {
        border: 2px solid;
        border-radius: 50%;
        border-color: midnightblue;
        padding: 1px;
        width: 3%;
        height: 3%;
        text-align: center;
        margin: 0 5px;
    }

    .fontsize {
        font-size: 12px
    }

    .inputbackgroundcolor {
        background-color: ghostwhite;
        /*f7f7f7*/ border-radius: 0.4rem;
    }

    .icon_color {
        color: midnightblue
    }

    .center {
        text-align: center;
        font-size: 20px
    }

    .divmarginoutsideicon {
        margin: 5px
    }

    #table_assigned_route_students th,
    #table_assigned_route_students td {
        text-align: center;
        vertical-align: middle;
    }

    #trip thead th {
        background-color: midnightblue !important;
        color: white !important;
        white-space: nowrap;
    }

        #trip thead th * {
            color: white !important;
        }

    #trip thead th {
        padding-right: 25px !important;
