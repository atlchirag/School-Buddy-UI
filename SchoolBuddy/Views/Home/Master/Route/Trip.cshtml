                                                                <td class="text-center">@routedetails.admission_no</td>
                                                                <td class="text-center">@routedetails.student_name</td>
                                                                <td class="text-center">@routedetails.father_name</td>
                                                                <td class="text-center">@routedetails.mobile_no</td>
                                                                <td class="text-center">@routedetails.class_name</td>
                                                                <td class="text-center">@routedetails.section</td>
                                                                <td class="text-center">@routedetails.rf_id</td>
                                                                <td class="text-center">@routedetails.stop_name</td>

