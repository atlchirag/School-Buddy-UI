    @section Scripts {
        <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
        <script>

            var routeList = @Html.Raw(
                        JsonConvert.SerializeObject(ViewBag.RouteList)
                        );
            function showCommonModal(message, title = "Message", type = "success") {
                const modalElement = document.getElementById("commonModal");
                const header = document.getElementById("commonModalHeader");
                const okButton = document.getElementById("commonModalOkButton");
                const normalizedType = ["success", "error", "warning"].includes(type)
                    ? type
                    : "info";

                document.getElementById("commonModalTitle").innerText = title;
                document.getElementById("commonModalMessage").innerText = message;

                const headerClass = normalizedType === "error"
                    ? "bg-danger"
                    : normalizedType === "info"
                        ? "bg-primary"
                        : `bg-${normalizedType}`;

                const buttonClass = normalizedType === "error"
                    ? "btn-danger"
                    : normalizedType === "info"
                        ? "btn-primary"
                        : `btn-${normalizedType}`;

                header.className = `modal-header ${headerClass}`;
                okButton.className = `btn ${buttonClass}`;

                bootstrap.Modal.getOrCreateInstance(modalElement).show();
            }

        </script>
        <!-- =========================================================
     SUBMIT FORM AJAX
========================================================= -->

        <script>
            function normalizeTransportId(value) {
                return String(value == null ? "" : value).trim();
            }

            $(document).ready(function() {

                $("#editStudentForm").submit(function(e) {

                    e.preventDefault();

                    var $form = $(this);
                    const prevPickRoute = normalizeTransportId($("#prev_pick_route_id").val());
                    const prevPickStop = normalizeTransportId($("#prev_pick_stop_id").val());
                    const prevDropRoute = normalizeTransportId($("#prev_drop_route_id").val());
                    const prevDropStop = normalizeTransportId($("#prev_drop_stop_id").val());
                    const currentPickRoute = normalizeTransportId($("#edit_pick_route").val());
                    const currentPickStop = normalizeTransportId($("#edit_pick_stop").val());
                    const currentDropRoute = normalizeTransportId($("#edit_drop_route").val());
                    const currentDropStop = normalizeTransportId($("#edit_drop_stop").val());

                    const pickChanged = currentPickRoute !== prevPickRoute ||
                        currentPickStop !== prevPickStop;
                    const dropChanged = currentDropRoute !== prevDropRoute ||
                        currentDropStop !== prevDropStop;


                    const currentPickRouteName = $("#edit_pick_route option:selected").text().trim();
                    const currentDropRouteName = $("#edit_drop_route option:selected").text().trim();
                    const containsPick = currentPickRouteName?.toLowerCase().includes("pick") ?? false;
                    const containsDrop = currentDropRouteName?.toLowerCase().includes("drop") ?? false;


                    $("#transport_change_type").val("");

                  
                    if (!pickChanged && !dropChanged) {
                        showCommonModal(
                            "No changes detected.",
                            "Student Status",
                            "warning"
                        );
                        return;
                    }

                    if (pickChanged) {
                        if (!currentPickRoute) {
                            showCommonModal("Please select a Pick Route.", "Student Status", "error");
                            return;
                        }

                        if (!currentPickStop) {
                            showCommonModal("Please select a Pick Stop.", "Student Status", "error");
                            return;
                        }
                        if (!containsPick) {
                            showCommonModal("Please select a Route of type pick", "Student Status", "error");
                            return;
                        }

                        $("#transport_change_type").val("pick");
                    }

                    if (dropChanged) {
                        if (!currentDropRoute) {
                            showCommonModal("Please select a Drop Route.", "Student Status", "error");
                            return;
                        }

                        if (!currentDropStop) {
                            showCommonModal("Please select a Drop Stop.", "Student Status", "error");
                            return;
                        }
                        if (!containsDrop) {
                            showCommonModal("Please select a Route of type Drop", "Student Status", "error");
                            return;
                        }

                        $("#transport_change_type").val("drop");
                    }
                    if (pickChanged && dropChanged) {
                        $("#transport_change_type").val("both");
                    }

                    var formData = $form.serialize();

                    $.ajax({
                        url: $form.attr("action"),
                        type: "POST",
                        data: formData,
                        dataType: "json",

                        success: function(response) {

                            console.log(response);

                            showCommonModal(
                                response.message,
                                "Student Status",
                                response.success ? "success" : "error"
                            );

                            if (response.success) {

                                var modal = bootstrap.Modal.getInstance(
                                    document.getElementById("editStudentModal")
                                );

                                if (modal) {
                                    modal.hide();
                                }
                            }
                        },

                        error: function(xhr) {

                            console.log(xhr.responseJSON);

                            var message = "Server error occurred";

                            if (xhr.responseJSON && xhr.responseJSON.message) {
                                message = xhr.responseJSON.message;
                            }

                            showCommonModal(
                                message,
                                "Student Status",
                                "error"
                            );
                        }
                    });

                });

            });
        </script>
        <script>
            function deleteStudent(id) {

                if (!id) {

                    showCommonModal(
                        "Invalid student id",
                        "Delete Student",
                        "error"
                    );

                    return;
                }

                if (!confirm("Are you sure you want to unassign this student?")) {
                    return;
                }

                $.ajax({

                    url: '/schoolbuddy/Route/DeleteStudent',

                    type: 'POST',

                    data: {
                        id: id
                    },

                    dataType: 'json',

                    success: function(response) {

                        showCommonModal(
                            response.message,
                            "Delete Student",
                            response.success ? "success" : "error"
                        );

                        if (response.success) {

                            // REMOVE ROW WITHOUT RELOAD
                            $("#row_" + id).remove();

                            // OPTIONAL
                            // location.reload();
                        }
                    },

                    error: function() {

                        showCommonModal(
                            "Server error occurred",
                            "Delete Student",
                            "error"
                        );
                    }
                });
            }


