            function addStudent(routeid) {
                $('#assignedRouteId').val(routeid);

                var table = $('#table_assigned_route_students').DataTable();

                table.clear().draw();

                $.ajax({
                    type: 'POST',
                    url: '/schoolbuddy/Route/assignedStudents',
                    data: { id: routeid },
                    success: function(response) {
                        console.log("Response:", response);

                        if (!Array.isArray(response)) {
                            table.row.add([
                                '', 'No data found', '', '', '', '', '', '', ''
                            ]).draw();
                            return;
                        }

                        let sno = 1;
                        let rows = response.map(item => [
                            sno++,
                            item.admission_no || '',
                            item.student_name || '',
                            item.father_name || '',
                            item.mobile_no || '',
                            item.class_name || '',
                            item.section || '',
                            item.rf_id || '',
                            item.stop_name || ''
                        ]);

                        table.rows.add(rows).draw();
                    },
                    error: function() {
                        table.row.add([
                            '', 'Failed to load data', '', '', '', '', '', '', ''
                        ]).draw();
                    }
                });

                $('#assignedstudentmodal').modal('show');
            }


