</style>
<div class=" card container-fluid">
    <div class="row">


        <div class="col-lg-12" style="margin-top:3vmin">
            <div class="card-header rounded-top" style="background-color:midnightblue;color:white;">
                <p style="font-weight:600;margin:0px">Route</p>
            </div>
            <div class="card-body rounded ms-2" style="background-color:white;">
                <div class="layout ">

                    <div class="layout w-100 justify-content-between align-items-center">
                        <a class="btn btn-sm" asp-controller="Route" asp-action="createtrip" title="Add Route" style="padding:0px">
                            <i style="font-size:36px" class="ri-add-circle-line center" aria-hidden="true"></i>
                        </a>


                        <button type="button"
                                class="btn btn-primary btn-sm"
                                data-bs-toggle="modal"
                                data-bs-target="#studentWiseModal"
                                data-sys-user-id="@ViewBag.SysUserId">
                            Student Wise
                        </button>


                    </div>

                    
                </div>
                <div class="row scrollit mt-1" style="background-color:white;">
                    <div class="col-lg-12 table-responsive">
                        <table id="trip" class=" table  table-striped table-hover">
                            <thead>
                                <tr class="text-center" style="font-size:14px;background-color:midnightblue;color:white">
                                    <th class="text-center">S.No</th>
                                    <th class="text-center">Trip Name</th>
                                    <th class="text-center">Trip Type</th>
                                    <th class="text-center">Vehicle</th>
                                    <th class="text-center">Trip Start Time</th>
                                    <th class="text-center">Trip End Time</th>
                                    <th class="text-center">Created on</th>
                                    @*     <th class="text-center">Vais Status</th> *@
                                    <th class="text-center">Action</th>
                                </tr>
                            </thead>
                            <tbody>
                                @{
                                    string trip_type = null;
                                    int sno = 1;
                                    if (Model != null)
                                    {
                                        foreach (var route in Model)
                                        {
                                            if (route.route_name.Contains("drop") || route.route_name.Contains("Drop") || route.route_name.Contains("DROP"))
                                            {
                                                trip_type = "Drop";
                                            }
                                            else
                                            {
                                                trip_type = "Pick";
                                            }

                                            <tr class="text-center" style="font-size:12px">
                                                <td class="text-center">@sno</td>
                                                <td class="text-center">@route.route_name</td>
                                                <td class="text-center">@trip_type</td>

                                                <td class="text-center">@route.veh_reg</td>
                                                <td class="text-center">@route.start_time_up</td>
                                                <td class="text-center">@route.end_time_up</td>

                                                <td class="text-center">@route.rowcreated</td>

                                                
                                                <td class="d-flex align-items-center">

                                                    <a href="javascript:void(0);" onclick="addStudent('@route.id')" class="me-1">
                                                        <i class="bi bi-view-list text-info" title="View Details"></i>
                                                    </a>

                                                    <a asp-controller="Route" asp-action="stopSection" asp-route-id="@route.id" class="me-1"><i class="ri-bus-2-fill text-primary" style="font-size:1rem;font-weight:500;cursor:pointer;text-align:center" aria-hidden="true" title="Stop Section"></i></a>
                                                    <a id="edit" data-row-id="@route.id" class="=me-1"><i class="ri-edit-box-line text-info" title="Edit Record" style="font-size:1rem;font-weight:500;cursor:pointer;text-align:center"></i></a>
                                                    <a id="delete" onclick="deleteroute(@route.id);" title="Delete Record"><i class="bi bi-trash text-danger" style="font-size:1rem;font-weight:500;cursor:pointer;text-align:center"></i></a>
                                                </td>

                                            </tr>
                                            sno++;
                                        }

                                    }

                                    else
                                    {

                                    }
                                }
                            </tbody>
                        </table>
                    </div>

                </div>
                <!-- Modal -->
                <!-- Button trigger modal -->
                <!-- Route wise student detail modal-->

                <div class="modal fade sb-common-modal" id="assignedstudentmodal" tabindex="-1" aria-labelledby="assignedStudentsModalLabel" aria-hidden="true">
