                                '',
                                '',
                                '',
                                '',
                                ''

                            ]).draw();
                        }
                    },

                    error: function() {

                        studentWiseTable.clear();

                        studentWiseTable.row.add([

                            'Error fetching data',

                            '',
                            '',
                            '',
                            '',
                            '',
                            '',
                            '',
                            '',
                            ''

                        ]).draw();
                    }
                });
            });

            function openEditStudentModal(s) {
                $('#studentWiseModal').modal('hide');

                const pickRouteId = normalizeTransportId(s.pick_route_id);
                const dropRouteId = normalizeTransportId(s.drop_route_id);
                const pickStopId = normalizeTransportId(s.pick_stop_id);
                const dropStopId = normalizeTransportId(s.drop_stop_id);

                $("#editStudentForm")[0].reset();
                $("#edit_student_id").val(s.student_id || '');
                $("#edit_student_name").val(s.student_name || '');
                $("#edit_father_name").val(s.father_name || '');
                $("#edit_class_name").val(s.class_name || '');
                $("#edit_mobile_no").val(s.mobile_no1 || '');
                $("#edit_rfid").val(s.rf_id || '');
                $("#edit_admission_no").val(s.admission_no || '');

                $("#prev_pick_route_id").val(pickRouteId);
                $("#prev_drop_route_id").val(dropRouteId);
                $("#prev_pick_stop_id").val(pickStopId);
                $("#prev_drop_stop_id").val(dropStopId);
                $("#transport_change_type").val('');

                populateRouteDropdown("#edit_pick_route", "Select Pick Route", pickRouteId);
                populateRouteDropdown("#edit_drop_route", "Select Drop Route", dropRouteId);

                setCurrentStopOption(
                    "#edit_pick_stop",
                    pickStopId,
                    s.pick_stop_name,
                    s.pick_latitude,
                    s.pick_longitude,
                    "Select Pick Stop"
                );
                setCurrentStopOption(
                    "#edit_drop_stop",
                    dropStopId,
                    s.drop_stop_name,
                    s.drop_latitude,
                    s.drop_longitude,
                    "Select Drop Stop"
                );

                $("#edit_pick_latitude").val(s.pick_latitude || '');
                $("#edit_pick_longitude").val(s.pick_longitude || '');
                $("#edit_drop_latitude").val(s.drop_latitude || '');
                $("#edit_drop_longitude").val(s.drop_longitude || '');

                bootstrap.Modal.getOrCreateInstance(
                    document.getElementById('editStudentModal')
                ).show();
            }

            function populateRouteDropdown(dropdownId, placeholder, selectedRouteId) {
                let options = `<option value="">${placeholder}</option>`;

                routeList.forEach(function(route) {
                    const selected = normalizeTransportId(route.id) === selectedRouteId
                        ? ' selected'
                        : '';
                    options += `<option value="${route.id}"${selected}>${route.route_name}</option>`;
                });

                $(dropdownId).html(options);
            }

            function setCurrentStopOption(
                dropdownId,
                stopId,
                stopName,
                latitude,
                longitude,
                placeholder
            ) {
                if (!stopId) {
                    $(dropdownId).html(`<option value="">${placeholder}</option>`);
                    return;
                }

                $(dropdownId).html(
                    `<option value="${stopId}" data-lat="${latitude || ''}" data-long="${longitude || ''}" selected>` +
                    `${stopName || placeholder}</option>`
                );
            }

            $("#edit_pick_route").change(function() {
                $("#edit_pick_latitude, #edit_pick_longitude").val('');
                loadStops($(this).val(), "#edit_pick_stop", "Select Pick Stop");
            });

            $("#edit_drop_route").change(function() {
                $("#edit_drop_latitude, #edit_drop_longitude").val('');
                loadStops($(this).val(), "#edit_drop_stop", "Select Drop Stop");
            });

            function loadStops(routeId, dropdownId, placeholder) {
                const $dropdown = $(dropdownId);
                $dropdown.html(`<option value="">${placeholder}</option>`);

                if (!normalizeTransportId(routeId)) {
                    return;
                }

                $.ajax({
                    url: '/schoolbuddy/Route/GetStopsByRoute',
                    type: 'GET',
                    data: { id: routeId },
                    success: function(res) {
                        let options = `<option value="">${placeholder}</option>`;

                        if (Array.isArray(res)) {
                            res.forEach(function(stop) {
                                options += `<option value="${stop.id}" ` +
                                    `data-lat="${stop.latitude || ''}" ` +
                                    `data-long="${stop.longitude || ''}">` +
                                    `${stop.user_stop_name}</option>`;
                            });
                        }

                        $dropdown.html(options);
                    },
                    error: function() {
                        $dropdown.html(`<option value="">Unable to load stops</option>`);
                    }
                });
            }

            $("#edit_pick_stop").change(function() {
                const selected = $(this).find(":selected");
                $("#edit_pick_latitude").val(selected.data("lat") || '');
                $("#edit_pick_longitude").val(selected.data("long") || '');
            });

            $("#edit_drop_stop").change(function() {
                const selected = $(this).find(":selected");
                $("#edit_drop_latitude").val(selected.data("lat") || '');
                $("#edit_drop_longitude").val(selected.data("long") || '');
            });


            function addVias(routeid, serviceid) {

                console.log(routeid, serviceid);

                $('#vias_modal').val(routeid);

                $('#exampleModal').modal('show');
            }
            $(document).on('click', '#edit', function() {
                var id = $(this).data('row-id');

                $.ajax({
                    url: '/schoolbuddy/Route/GetTripById',
                    data: { id: id },
                    dataType: 'json',
                    success: function(data1) {
                        var name = data1.route_name;
                        var namearr = name.split(" ");
                        if (namearr[1] && namearr[1].toLowerCase().includes("pick")) {
                            $('#pick').prop("checked", true);
                        } else {
                            $('#drop').prop("checked", true);
                        }

                        $('#routename').val(name);
                        $('#starttime').val(data1.start_time_up);
                        $('#endtime').val(data1.end_time_up);
                        $('#routeid').val(id);

                        const svcId = data1.sys_service_id ?? data1.service_id ?? '';
                        loadBusesIntoDropdown(svcId);
                        $('#editroute').modal('show');
                    }
                });
            });


            function deleteroute(id) {

                console.log(" ");
                Swal.fire({
                    title: "Are you sure?",
                    text: "With route, all stops and students assigned to those stops will be also deleted, You won't be able to revert this!",
                    icon: "warning",
                    showCancelButton: true,
                    confirmButtonColor: "#3085d6",
                    cancelButtonColor: "#d33",
                    confirmButtonText: "Yes, delete it!"
                }).then((result) => {
                    if (result.isConfirmed) {
                        $.ajax({
                            type: 'POST',
                            url: '/schoolbuddy/Route/deleteroute',
                            data: { rid: id },
                            success: function response() {
                                console.log(' ');
                                location.reload();
                            }
                        });
                    }
                });
            }


            function loadBusesIntoDropdown(selectedServiceId) {
                const $sel = $('#veh_reg');

                $sel.empty().append($('<option>').val('').text('Loading...'));

                $.ajax({
                    type: 'GET',
                    url: '/schoolbuddy/Route/GetBusesForEdit',
                    dataType: 'json',
                    success: function(res) {
                        $sel.empty();

                        let found = false;

                        if (Array.isArray(res)) {
                            res.forEach(r => {
                                const val = String(r.id);
                                const opt = $('<option>').val(val).text(r.veh_reg);

                                if (selectedServiceId != null && String(selectedServiceId) === val) {
                                    opt.prop('selected', true);
                                    found = true;
                                }
                                $sel.append(opt);
                            });
                        }

                        if (!found) {
                            $sel.prepend($('<option>').val('').text('Select Bus').prop('selected', true));
                        }

                        $sel.trigger('change');
                    },
                    error: function() {
                        $sel.empty().append($('<option>').val('').text('Failed to load'));
                    }
                });
            }


            $(document).on('click', '#exportAssignedStudentsExcel', function() {
                const routeId = $('#assignedRouteId').val();

                if (!routeId) {
                    Swal.fire({
                        icon: 'warning',
                        title: 'Required',
                        text: 'Please open assigned students first.',
                        confirmButtonColor: '#3085d6'
                    });
                    return;
                }

                window.location.href = '/schoolbuddy/Route/DownloadAssignedStudentsExcel?routeId=' + encodeURIComponent(routeId);
            });
        </script>
