
@{
    ViewData["Title"] = "UWB Tracking";
}

<style>

    .layout {
        display: flex
    }

    .iconlayout {
        border: 2px solid;
        border-radius: 50%;
        border-color: midnightblue;
        padding: 1px;
        /*font-size:24px;*/
        width: 3%;
        height: 3%;
        text-align: center;
        margin: 0 5px;
    }

    .icon_color {
        color: midnightblue
    }

    .center {
        /* text-align:center;
                        font-size:20px*/
    }

    .divmarginoutsideicon {
        margin: 5px
    }

    table thead th,
    table.dataTable thead th {
        background-color: midnightblue !important;
        color: white !important;
        text-align: center;
        vertical-align: middle !important;
        font-size: 12px;
        font-weight: 600;
        padding-right: 25px !important;
        white-space: nowrap;
    }

        table thead th *,
        table.dataTable thead th * {
            color: white !important;
        }

    .search-btn {
        color: midnightblue !important;
        border-color: midnightblue !important;
    }

        .search-btn:hover,
        .search-btn:focus {
            background-color: midnightblue !important;
            border-color: midnightblue !important;
            color: white !important;
        }
</style>

<div class="card container-fluid " >
    <div class="row">


        <div class="col-lg-12"style="padding:0px">
            <div class="card-header rounded-top " style="background-color:midnightblue;color:white;">
                <p style="font-weight:600;margin:0px">Ultra Wide Band (UWB)</p>
            </div>
            <br />
            <div class="card-body rounded" style="background-color:white;">

                <div class=" d-flex flex-column ">
                    <div class="card-body ">

                        <div class="row g-3">

                            <div class="col-lg-3 col-md-6">
                                <label class="form-label fw-semibold">
                                    Student Roll No / Name <span class="text-danger">*</span>
                                </label>
                                <input type="text" class="form-control" placeholder="Enter Roll No or Name">
                            </div>

                            <div class="col-lg-3 col-md-6">
                                <label class="form-label fw-semibold">
                                    Anchor Unit <span class="text-danger">*</span>
                                </label>
                                <input type="text" class="form-control" placeholder="Enter Anchor Unit">
                            </div>

                            <div class="col-lg-2 col-md-6">
                                <label class="form-label fw-semibold">
                                    From Date <span class="text-danger">*</span>
                                </label>
                                <input type="date" class="form-control" placeholder="Please Select Date">
                            </div>

                            <div class="col-lg-2 col-md-6">
                                <label class="form-label fw-semibold">
                                    To Date <span class="text-danger">*</span>
                                </label>
                                <input type="date" class="form-control" placeholder="Please Select Date">
                            </div>

                            <div class="col-lg-2 col-md-12 d-flex align-items-end">
                                <button class="btn btn-outline-primary search-btn">
                                    Search
                                </button>
                            </div>

                        </div>

                    </div>
                </div>

                @* <div class="row" style="margin-top: 20px">
                    <div class="col-lg-12">
                        <div class="layout divmarginoutsideicon">

                        
                            

                            <div style="position: absolute;right: 50px">

                                <form class="input-group my-2 my-md-0 justify-content-lg-start " style="width:90vh;height:auto;align-items: center;">
                                    <input autocomplete="off"
                                           type="search"
                                           class="form-control-sm rounded"
                                           placeholder='Search here...'
                                           style="min-width: 200px; background-color: white;width: 40px;border: 1px solid midnightblue;border-radius: 3.25rem !important;margin-left:auto" />
                                    <div class="layout" style="margin-left: -30px;">
                                        <i class="bi bi-search"></i>
                                    </div>

                                </form>

                            </div> 
                           
                        </div>
                    </div>
                    <!-- /.col-lg-12 -->
                </div> *@
                
            </div>

            <div>
                <div class="row scrollit mt-1  m-2 m-md-3 m-lg-4" style="background-color:white;">
                    <div class="col-lg-12 table-responsive" style="width:100%">
                        <table id="UWBtable" class="table table-striped table-hover table-bordered" style="border-color:lightgray">
                            <thead>
                                <tr>
                                    <th rowspan="2">S.No.</th>
                                    <th rowspan="2">Student Name</th>
                                    <th rowspan="2">Anchor Unit</th>
                                    <th colspan="2" class="text-center">Date</th>
                                    <th rowspan="2">Tracking</th>
                                </tr>
                                <tr>
                                    <th>From</th>
                                    <th>To</th>
                                </tr>
                            </thead>
                            <tbody>
                                @{
                                    if (Model != null)
                                    {
                                        int sno = 1;
                                        foreach (var uwb in Model)
                                        {
                                            <tr class="text-center" style="font-size:12px">
                                                <td class="text-center">@sno</td>
                                                <td>@uwb.StudentName</td>
                                                <td>@uwb.AnchorUnit</td>
                                                <td>@uwb.FromDate</td>
                                                <td>@uwb.ToDate</td>
                                                <td>
                                                    <a href="#" class="btn btn-sm btn-primary">
                                                        View Tracking
                                                    </a>
                                                </td>
                                            </tr>
                                            sno++;
                                        }
                                    }
                                    else
                                    {
                                         <tr class="text-center " style="font-size:12px">
                                            <td> &nbsp; </td>
                                            <td> </td>
                                            <td> </td>
                                            <td> </td>
                                            <td></td>
                                            <td></td>

                                         </tr>
                                        <tr class="text-center" style="font-size:12px">
                                            <td>&nbsp;</td>
                                            <td></td>
                                            <td></td>
                                            <td></td>
                                            <td></td>
                                            <td></td>

                                        </tr>
                                        <tr class="text-center" style="font-size:12px">
                                            <td>&nbsp;</td>
                                            <td></td>
                                            <td></td>
                                            <td></td>
                                            <td></td>
                                            <td></td>

                                        </tr>
                                        <tr class="text-center" style="font-size:12px">
                                            <td>&nbsp;</td>
                                            <td></td>
                                            <td></td>
                                            <td></td>
                                            <td></td>
                                            <td></td>

                                        </tr>
                                        <tr class="text-center" style="font-size:12px">
                                            <td>&nbsp;</td>
                                            <td></td>
                                            <td></td>
                                            <td></td>
                                            <td></td>
                                            <td></td>

                                        </tr>
                                        <tr class="text-center" style="font-size:12px">
                                            <td>&nbsp;</td>
                                            <td></td>
                                            <td></td>
                                            <td></td>
                                            <td></td>
                                            <td></td>

                                        </tr>
                                        <tr class="text-center" style="font-size:12px">
                                            <td>&nbsp;</td>
                                            <td></td>
                                            <td></td>
                                            <td></td>
                                            <td></td>
                                            <td></td>

                                        </tr>
                                    }
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
           </div>
        </div>
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
<script>

   
  
    $(document).ready(function () {

    var table = $('#UWBtable').DataTable({
    ordering: false,
    lengthChange: false,
    dom: '<"topbar d-flex justify-content-between align-items-center mb-4"<"excel-btn">f>rtip'
    });

    $('div.excel-btn').html(`
    <a class="btn btn-sm iconstyle"
    href="#"
    title="Download UWB Excel">
    <i class="bi bi-file-earmark-excel-fill text-success"></i>
    </a>
    `);

    });
</script>
