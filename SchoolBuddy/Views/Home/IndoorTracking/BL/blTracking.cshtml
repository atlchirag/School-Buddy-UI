
@{
    ViewData["Title"] = "BL Tracking";
}


<div class="card container-fluid">
    <div class="row">


        <div class="col-lg-12" style="padding:0px">
            <div class="card-header rounded-top" style="background-color:midnightblue;color:white;">
                <p style="font-weight:600;margin:0px">BL Tracking</p>
            </div>
            <div class="card-body rounded" style="background-color:white;">

                <div class="row">
                    <div class="col-lg-3">
                        <label class="form-control">Student Roll No/Name<span class="required_">*</span></label>
                        <input type="text" class="form-control inputbackgroundcolor" />
                    </div>
                    <div class="col-lg-3">
                        <label class="form-control">Anchor Unit<span class="required_">*</span></label>
                        <input type="text" class="form-control inputbackgroundcolor" />
                    </div>
                    <div class="col-lg-2">
                        <label class="form-control">From Date<span class="required_">*</span></label>
                        <input type="text" class="form-control inputbackgroundcolor" />

                    </div>
                    <div class="col-lg-2">
                        <label class="form-control">To date<span class="required_">*</span></label>
                        <input type="text" class="form-control inputbackgroundcolor" />

                    </div>
                    <div class="col-lg-2">
                        <button class="btn btn-sm" style="border: 2px solid;margin-top:37px;border-color: midnightblue;color:midnightblue">SAVE</button>

                    </div>
                
                </div>

                <div class="row" style="margin-top: 20px">
                    <div class="col-lg-12">
                        <div class="layout divmarginoutsideicon">

                            <a href="/createholidayenvent" class="iconlayout"><i class="fa fa-plus icon_color icon_color center" style="border:2px" aria-hidden="true"></i></a>

                            <a href="" class="iconlayout"> <i class="fa fa-file-excel-o icon_color center" aria-hidden="true"></i></a>
                            <a href="" class="iconlayout"> <i class="fa fa-file-pdf-o icon_color center" aria-hidden="true"></i></a>


                            <div style="position: absolute;right: 50px">
                                <form class="input-group my-2 my-md-0 justify-content-lg-start " style="width:90vh;height:auto;align-items: center;">
                                    <input autocomplete="off"
                                           type="search"
                                           class="form-control-sm rounded"
                                           placeholder='Search here...'
                                           style="min-width: 200px; background-color: white;width: 40px;border: 1px solid midnightblue;border-radius: 3.25rem !important;margin-left:auto" />
                                    <div class="layout" style="margin-left: -30px;">
                                        <i class="fa fa-search"></i>
                                    </div>

                                </form>


                            </div>
                        </div>
                    </div>
                    <!-- /.col-lg-12 -->
                </div>


            </div>


        </div>
    </div>
</div>

