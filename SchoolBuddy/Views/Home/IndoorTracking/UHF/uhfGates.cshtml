
@{
    ViewData["Title"] = "UHF Gates";
}


<div class="card container-fluid">
    <div class="row">


        <div class="col-lg-12" style="padding:0px">
            <div class="card-header rounded-top" style="background-color:midnightblue;color:white;">
                <p style="font-weight:600;margin:0px">UHF</p>
            </div>
            <div class="card-body rounded p-3 " style="background-color:white;">

                <div class="row g-3">
                    <div class="col-lg-5 d-grid  gap-3">
                        <label class="form-control">Device ID <span class="required_">*</span></label>
                        <select class="form-control">
                                    
                            <option>Please select device ID</option>
                        </select>
                    </div>
                    <div class="col-lg-5 d-grid  gap-3">
                        <label class="form-control">Gate Number<span class="required_">*</span></label>
                        <input type="text" class="form-control inputbackgroundcolor"/>
                    </div>
                    <div class="col-lg-2">
                        <button class="btn btn-sm" style="border: 2px solid;margin-top:37px;border-color: midnightblue;color:midnightblue">SAVE</button>

                    </div>
                </div>
               
                <div class="row mt-3">
                    <div class="col-lg-12">

                        <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 layout divmarginoutsideicon">

                            <!-- Left Icons -->
                            <div class="d-flex flex-wrap gap-3 align-items-center">

                                <a href="/createholidayenvent" class="iconlayout">
                                    <i class="fa fa-plus icon_color center" aria-hidden="true"></i>
                                </a>

                                <a href="" class="iconlayout">
                                    <i class="fa fa-file-excel-o icon_color center" aria-hidden="true"></i>
                                </a>

                                <a href="" class="iconlayout">
                                    <i class="fa fa-file-pdf-o icon_color center" aria-hidden="true"></i>
                                </a>

                            </div>

                            <!-- Search -->
                            <form class="d-flex align-items-center position-relative">

                                <input autocomplete="off"
                                       type="search"
                                       class="form-control form-control-sm rounded-pill pe-5"
                                       placeholder="Search here..."
                                       style="min-width:220px;border:1px solid midnightblue;" />

                                <i class="fa fa-search position-absolute"
                                   style="right:15px;color:midnightblue;"></i>

                            </form>

                        </div>

                    </div>
                </div>





            </div>


        </div>
    </div>
</div>

