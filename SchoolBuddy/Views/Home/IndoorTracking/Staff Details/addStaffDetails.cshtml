@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }

    <script>
        $(function () {
            var $form = $("#addStaffForm");
            if (!$form.length || !$.validator) return;

            // configure validator to use bootstrap classes and span error messages
            $form.validate({
                errorClass: "text-danger",
                errorElement: "span",
                highlight: function (element) {
                    $(element).addClass('is-invalid').removeClass('is-valid');
                },
                unhighlight: function (element) {
                    $(element).removeClass('is-invalid').addClass('is-valid');
                },
                errorPlacement: function (error, element) {
                    // place error after the asp-validation-for span if present
                    var $place = element.siblings("[data-valmsg-for='" + element.attr('name') + "']");
                    if ($place.length) {
                        $place.html(error);
                    } else {
                        error.insertAfter(element);
                    }
                }
            });

            // validate on blur for real-time feedback
            $form.on('blur', 'input,textarea,select', function () {
                $form.validate().element(this);
            });
        });
    </script>
     <script src="~/js/analysis.js?v=@DateTime.Now.Ticks"></script>
    }

