@model IEnumerable<SchoolBuddy.Models.Staff>
@using Newtonsoft.Json
@{
    ViewData["Title"] = "Staff Details";
}

<style>
    .layout {
        display: flex;
    }

    .iconlayout {
        border: 2px solid;
        border-radius: 50%;
        border-color: midnightblue;
        padding: 1px;
        width: 3%;
        height: 3%;
        text-align: center;
        margin: 0 5px;
    }

    .icon_color {
        color: midnightblue;
    }

    .divmarginoutsideicon {
        margin: 5px;
    }

    table thead th,
    table.dataTable thead th {
        background-color: midnightblue !important;
        color: white !important;
        text-align: center;
        vertical-align: middle !important;
        font-size: 12px;
        font-weight: 600;
        padding-right: 25px !important;
        white-space: nowrap;
    }

        table thead th *,
        table.dataTable thead th * {
            color: white !important;
        }
</style>

<div class="card container-fluid">
    <!-----popup Card------>
    <div>
        @if (TempData["SuccessMessage"] != null || TempData["ErrorMessage"] != null)
        {
            <div class="modal fade sb-common-modal" id="messageModal" tabindex="-1" aria-labelledby="messageModalLabel" aria-hidden="true">
                <div class="modal-dialog">
                    <div class="modal-content">

                        <div class="modal-header">
                            <h5 class="modal-title" id="messageModalLabel">Status</h5>
                            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                        </div>

                        <div class="modal-body">

                            @if (TempData["SuccessMessage"] != null)
                            {
                                <div class="alert alert-success">
                                    @TempData["SuccessMessage"]
                                </div>
                            }

                            @if (TempData["ErrorMessage"] != null)
                            {
                                <div class="alert alert-danger">

                                    <h5>
                                        <i class="fa fa-exclamation-triangle"></i>
                                        Upload Failed
                                    </h5>

                                    <div style="max-height:300px; overflow-y:auto;">

                                        @Html.Raw(
                                            TempData["ErrorMessage"]
                                            .ToString()
                                            .Replace("{", "<br>")
                                            .Replace("}", "<br>")
                                            .Replace("[", "<ul><li>")
                                            .Replace("]", "</li></ul>")
                                            .Replace("\",\"", "</li><li>")
                                            .Replace("\"", "")
                                            .Replace(",", "<br>")
                                        )

                                    </div>

                                </div>
                            }

                        </div>

                    </div>
                </div>
            </div>

            <script>
                document.addEventListener("DOMContentLoaded", function () {
                    var myModal = new bootstrap.Modal(document.getElementById('messageModal'));
                    myModal.show();
                });
            </script>
        }
 
        @{
    var message = TempData.Peek("excelErrorMessage")?.ToString();
   var raw = TempData["excelErrorList"] as string; 
            var list = string.IsNullOrEmpty(raw)
    ? null
    : JsonConvert.DeserializeObject<List<string>>(raw); ;
}

@if (message != null || (list != null && list.Any()))
{
   
            <!-- Responsive Bootstrap Error Modal -->
            <div class="modal fade sb-common-modal"
                 id="errorModal"
                 tabindex="-1"
                 aria-labelledby="errorModalLabel"
                 aria-hidden="true">

                <div class="modal-dialog modal-dialog-centered modal-lg modal-fullscreen-sm-down modal-dialog-scrollable">

                    <div class="modal-content">

                        <!-- Header -->
                        <div class="modal-header">

                            <h5 class="modal-title" id="errorModalLabel">

                                <i class="bi bi-exclamation-triangle-fill me-2"></i>
                                Upload Errors

                            </h5>

                            <button type="button"
                                    class="btn-close"
                                    data-bs-dismiss="modal"
                                    aria-label="Close">
                            </button>

                        </div>

                        <!-- Body -->
                        <div class="modal-body">

                            @if (!string.IsNullOrEmpty(message))
                            {
                                <div class="alert alert-danger rounded-3 shadow-sm">

                                    <strong>Error:</strong>
                                    @message

                                </div>
                            }

                            @if (list != null && list.Any())
                            {
                                <div style="max-height:400px; overflow-y:auto;">

                                    <ul class="list-group">

                                        @foreach (var err in list)
                                        {
                                            <li class="list-group-item d-flex align-items-start">

                                                <span class="text-danger fw-bold me-2">
                                                    •
                                                </span>

                                                <span class="text-break">
                                                    @err
                                                </span>

                                            </li>
                                        }

                                    </ul>

                                </div>
                            }

                        </div>

                        <!-- Footer -->
                        <div class="modal-footer">

                            <button type="button"
                                    class="btn btn-primary px-4"
                                    data-bs-dismiss="modal">

                                Close

                            </button>

                        </div>

                    </div>

                </div>

            </div>

            @if (TempData["excelErrorMessage"] != null)
            {
                <script>
                            document.addEventListener("DOMContentLoaded", function () {

                                var errorModal = new bootstrap.Modal(
                                    document.getElementById('errorModal')
                                );

                                errorModal.show();

                            });
                </script>
            }
        }
       
    </div>
    <div class="row">
        <div class="col-lg-12" style="padding:0px">
            <div class="card-header rounded-top" style="background-color:midnightblue;color:white;">
                <p style="font-weight:600;margin:0px">Staff Details</p>
            </div>
            <div class="card-body rounded" style="background-color:white;">
                <div class="d-flex justify-content-between align-items-center mb-2" style="margin-top: 20px">
                    <div class="divmarginoutsideicon">
                        <a class="btn btn-sm iconstyle" asp-controller="Home" asp-action="addStaffDetails" title="Add Staff">
                            <i class="bi bi-person-fill-add" aria-hidden="true"></i>
                        </a>
                        <a class="btn btn-sm iconstyle" asp-controller="Home" asp-action="StaffBulkUploadFile" title="Upload Excel For Bulk Staff">
                            <i class="bi bi-upload" aria-hidden="true"></i>
                        </a>
                        <a class="btn btn-sm iconstyle"
                           title="Download Staff Details"
                           asp-controller="Home"
                           asp-action="DownloadstaffDetails">
                            <i class="bi bi-file-earmark-excel-fill text-success" aria-hidden="true"></i>
                        </a>
                    </div>

                </div>

                    <div class="row scrollit mt-1" style="background-color:white;">
                        <div class="col-lg-12 table-responsive" style="width:100%">
                            <table id="staffTable" class="table table-striped table-hover">
                                <thead>
                                    <tr class="text-center" style="font-size:12px;background-color:midnightblue;color:white">
                                        <th class="text-center">S.No</th>
                                        <th class="text-center">Employee Code</th>
                                        <th class="text-center">Name</th>
                                        <th class="text-center">RFID</th>
                                        <th class="text-center">Mobile Number</th>
                                        <th class="text-center">Address</th>
                                        <th class="text-center">In Time</th>
                                        <th class="text-center">Out Time</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @{
                                        if (Model != null)
                                        {
                                            int sno = 1;
                                            foreach (var staff in Model)
                                            {
                                                <tr class="text-center" style="font-size:12px">
                                                    <td class="text-center">@sno</td>
                                                    <td class="text-center">@staff.emp_code</td>
                                                    <td class="text-center">@staff.name</td>
                                                    <td class="text-center">@staff.rf_id</td>
                                                    <td class="text-center">@staff.mobile_no</td>
                                                    <td class="text-center">@staff.address</td>
                                                    <td class="text-center">@staff.in_time.ToString("yyyy-MM-dd HH:mm")</td>
                                                    <td class="text-center">@staff.out_time.ToString("yyyy-MM-dd HH:mm")</td>
                                                </tr>
                                                sno++;
                                            }
                                        }
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
        </div>
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

<script>

    $(document).ready(function () {
        var table = $("#staffTable").DataTable();

        $("#staffSearch").on("keyup", function () {
            table.search(this.value).draw();
        });
    });
</script>
