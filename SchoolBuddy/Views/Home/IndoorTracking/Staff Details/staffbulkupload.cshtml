@{
    ViewData["Title"] = "Staff Bulk Upload";
}

<div class="card container-fluid mt-4">
    <div class="row">
        <div class="col-lg-12">
            <div class="card-header rounded-top" style="background-color:midnightblue;color:white;">
                <p style="font-weight:600;margin:0px">Staff Bulk Upload</p>
            </div>
            <div class="card-body" style="background-color:white">
                
                <form asp-controller="Home" asp-action="AddStaffInBulk" method="post" enctype="multipart/form-data">
                    <div class="row align-items-center">
                        <div class="col-md-6 mb-3">
                            <label for="Staff_file" class="form-label">Upload Excel File <span class="text-danger">*</span></label>
                            <input id="Staff_file" type="file" name="excelfile" class="form-control" accept=".xlsx" required />
                        </div>
                        <div class="col-md-6 d-flex justify-content-end align-items-end mb-3">
                            <a asp-controller="Home" asp-action="downloadStaffdetailsTemp" class="btn btn-sm btn-success">
                                <i class="bi bi-download"></i> Download Sample File
                            </a>
                        </div>
                    </div>

                    <div class="text-center">
                        <button type="submit" class="btn btn-primary">Add Staff Details</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>