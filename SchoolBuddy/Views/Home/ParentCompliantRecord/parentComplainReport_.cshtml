</div>


<!-- Modal -->
<div class="modal fade sb-common-modal" id="actionontickets" tabindex="-1" aria-labelledby="exampleModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h1 class="modal-title fs-5" id="exampleModalLabel">Action Taken to Resolve Complain</h1>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <input id="pendingticketid" type="hidden" value=""/>
                <div class="row">
                    <div class="col-lg-3">
                        <label>Action Taken</label>
                    </div>
                     <div class="col-lg-6">
                         <textarea id="cmt" class="form-control"></textarea> 
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                <button id="ticketclosureaction" type="button" class="btn btn-primary" onclick="uticket()">Ticket Closed</button>
            </div>
        </div>
    </div>
</div>


<script>
    window.onload = function () {
        var holidaycontrol = document.getElementById('A1');
        holidaycontrol.click();
        holidaycontrol.style.backgroundColor = 'midnightblue';
        holidaycontrol.style.color = 'white';
    }

    function changebg() {
        var holidaycontrol = document.getElementById('A1');
        var holidaycontrol1 = document.getElementById('A2');
        holidaycontrol.style.backgroundColor = 'midnightblue';
        holidaycontrol.style.color = 'white';

        holidaycontrol1.style.backgroundColor = 'white';
        holidaycontrol1.style.color = 'black';
    }
    function changebg1() {
        var holidaycontrol = document.getElementById('A1');
        var holidaycontrol1 = document.getElementById('A2');
        holidaycontrol1.style.backgroundColor = 'midnightblue';
        holidaycontrol1.style.color = 'white';

        holidaycontrol.style.backgroundColor = 'white';
        holidaycontrol.style.color = 'black';
    }



    function pending() {
        var table = $("#pendingticket").DataTable();
       // var uid = document.getElementById('user_id').value;
        // Clear existing data
        table.clear().draw();

        $.ajax({
            url: '/schoolbuddy/Complain/PendingTicket',
            type: 'POST',
           // data: { uid: uid },
            success: function (response) {
                let data;
                try {
                    data = JSON.parse(response);
                } catch (e) {
                    console.error('Failed to parse JSON:', e);
                    alert('Failed to load data.');
                    return;
                }

                const rows = data.map(item => [
                    item.student_name || "",
                    item.mobile_no1 || "",
                    item.route_name || "",
                    item.description || "",
                    item.complaint || "",
                    item.raised_on || "",
                    `<button  class="btn btn-sm bg-info" onclick="handleActionClick('${item.id || ""}')">Action</button>`
                ]);
                table.rows.add(rows).draw();

            },
            error: function (xhr, status, error) {
                console.error('Error occurred:', error);
                alert('An error occurred while fetching data.');
            }
        });
    }


    function resolved() {
        var table = $("#resolvedticket").DataTable();

        // Clear existing data
        table.clear().draw();

        $.ajax({
            url: '/schoolbuddy/Complain/ResolvedTicket',
            type: 'POST',
            success: function (response) {
                let data;
                try {
                    data = JSON.parse(response);
                } catch (e) {
                    console.error('Failed to parse JSON:', e);
                    alert('Failed to load data.');
                    return;
                }

                // Prepare data array for bulk addition
                let rows = data.map(item => [
                    item.student_name || "",
                    item.mobile_no1 || "",
                    item.route_name || "",
                    item.description || "",
                    item.comments || "",
                    item.raised_on || "",
                    item.resolved_on || "",

                ]);

                // Add all rows in a single operation
                table.rows.add(rows).draw();
            },
            error: function (xhr, status, error) {
                console.error('Error occurred:', error);
                alert('An error occurred while fetching data.');
            }
        });
    }

    function handleActionClick(ticketid){
        $('#pendingticketid').val(ticketid);
        $('#actionontickets').modal('show');
    }

   

        function uticket () {
           // alert('ncjd');
            var cmnt = $('#cmt').val();
            var tid = $('#pendingticketid').val();
            $.ajax({
            url: '/schoolbuddy/Complain/UpdateTicket',
                type: 'post',
                data: { comment: cmnt, ticketid: tid },
                success: function (response) {
                    if (response == "true") {
                        location.reload();
                    }
                    else {
                        alert('Something went wrong');
                    }

                },
                error: function () {
                    alert('Something went wrong');
                }
            });

        };





   


</script>

