                <p style="font-weight:600;margin:0px">Parent Complain Record</p>
            </div>
            <div class="card-body rounded" style="background-color:white;">
                <div class="row">
                    <div class="col-lg-12 col-xs-12">
                        <ul class="nav nav-tabs nav-justified d-flex justify-content-center align-content-center mt-1" style="border:0px;cursor: pointer; font-size: 20px; font-weight: 600;margin-left:0px;gap:5px;" role="tablist" id="main">
                            <li role="presentation">
                                <a class="tabstyle" aria-controls="Driver" data-bs-toggle="tab" id="A1" role="tab" href="#Pending" aria-expanded="false" onclick="changebg();pending()" style="border:1px solid midnightblue;
