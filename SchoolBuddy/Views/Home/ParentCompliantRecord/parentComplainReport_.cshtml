                                                <th style="color:black">Complaint</th>
                                                <th style="color:black">Raised on</th>
                                                <th style="color:black">Action</th>
                                            </tr>

                                        </thead>


                                    </table>
                                </div>
                            </div>
                            <!-- /.col-lg-12 -->
                        </div>
                    </div>
                    <div id="Resolved" class="tab-pane">
                        <div class="row" style="margin-top: 20px">
                            <div class="col-lg-12 col-xs-12">
                                <div class="layout">

                                    <div class="col-lg-12">
                                        <div class="mt-2 ms-2">
                                            <table id="resolvedticket" style="width:100%" class="table table-striped table-bordered table-hover dataTable no-footer" role="grid" aria-describedby="dataTables-example_info">
                                                <thead>
                                                    <tr role="row" style="background-color: #C8D7E3">
                                            
                                                        <th style="color:black">Student Name</th>
                                                        <th style="color:black">Mobile No</th>
                
                                                        <th style="color:black">Route</th>
                                                        <th style="color:black">Description</th>
                                                        <th style="color:black">Comment</th>
                                                        <th style="color:black">Raised on</th>
                                                        <th style="color:black">Resolved on</th>
                                                    </tr>

