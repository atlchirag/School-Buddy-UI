<script>
    var table;
    $(document).on("click", ".deleteBtn", function () {

   
    var data = table.row($(this).closest("tr")).data();

    var categoryId = data.category_id;

    console.log(categoryId);

    Swal.fire({
    title: "Delete Category?",
    text: "Are you sure you want to delete this category?",
    icon: "warning",
    showCancelButton: true,
    confirmButtonColor: "#d33",
    cancelButtonColor: "#3085d6",
    confirmButtonText: "Delete"
    }).then((result) => {

    if (result.isConfirmed) {

    $.ajax({
    url: "/Driver_Management/DeletePerformance",
    type: "POST",
    data: { category_id: categoryId },

    success: function (res) {

    if (res.status) {

    Swal.fire(
    "Deleted!",
    res.message,
    "success"
    ).then(() => {
    location.reload();
    });

    } else {

    Swal.fire(
    "Error",
    res.message,
    "error"
    );
    }
    },

    error: function () {
    Swal.fire(
    "Error",
    "Something went wrong.",
    "error"
    );
    }
    });

    }

    });

    });

    var response = @Html.Raw(JsonConvert.SerializeObject(Model));
    $('#driverTable tbody').on('click', '.editBtn', function () {

    editRowData = table.row($(this).closest('tr')).data();

    isEditMode = true;

    console.log("Edit:", editRowData);

    $("#driverPerformanceModal").modal("show");
    getDriverCriteria();

    });

    $('#driverTable tbody').on('click', '.deleteBtn', function () {

    var data = table.row($(this).closest('tr')).data();

    console.log("Delete:", data);

    });

    $(document).ready(function () {

    var tableData = [];

    $.each(response.Data.Category, function (categoryId, criteriaList) {

    var row = {
    category_id: parseInt(categoryId),
    category: "",
    overspeed: "N/A",
    Violation_Count:"N/A",
    distance: "N/A",
    halt: "N/A",
    running: "N/A",
    idle: "N/A",
    acceleration: "N/A",
    braking: "N/A",
    rashTurning: "N/A"
    };

    $.each(criteriaList, function (i, item) {

    row.category = item.Category_name;

    switch (item.Criteria_name) {

    case "Overspeed Limit":
    row.overspeed = parseInt(item.Min_value + " " + (item.Unit || "").trim());
    row.Violation_Count=parseInt(item.Max_value) ;
    break;

    case "Distance Range":
    row.distance = parseInt(item.Min_value) + " - " + parseInt(item.Max_value) + " " + (item.Unit || "").trim();    break;

    case "Halt Time Range":
    row.halt = parseInt(item.Min_value) + " - " + parseInt(item.Max_value) + " " + (item.Unit || "").trim();    break;

    case "Running Time Range":
    row.running = parseInt(item.Min_value) + " - " + parseInt(item.Max_value) + " " + (item.Unit || "").trim();
    break;

    case "Idle Time Range":
    row.idle = parseInt(item.Min_value) + " - " + parseInt(item.Max_value) + " " + (item.Unit || "").trim();
    break;

    case "Harsh Acceleration":
    row.acceleration = parseInt(item.Min_value);
    break;

    case "Harsh Braking":
    row.braking = parseInt(item.Min_value);
    break;

    case "Rash Turning":
    row.rashTurning = parseInt(item.Min_value);
    break;
    }

    });

    tableData.push(row);

    });

    console.log(tableData);

     table = $("#driverTable").DataTable({

    destroy: true,
    responsive: false,
    autoWidth: false,
    pageLength: 10,
   
    dom: 'Brt<"d-flex justify-content-between align-items-center mt-2"ip>',
    pagingType: "full_numbers",
    language: {
    paginate: {
    first: "«",
    previous: "‹",
    next: "›",
    last: "»"
    }
    },

    columnDefs: [
    {
    targets: "_all",
    className: "text-center align-middle"
    }
    ],
    data: tableData,

    columns: [



    {
    data: null,
    render: function (data, type, row, meta) {
    return meta.row + 1;
    }
    },

    { data: "category" },
    { data: "overspeed" },
    {data:"Violation_Count"},
    { data: "distance" },
    { data: "halt" },
    { data: "running" },
    { data: "idle" },
    { data: "acceleration" },
    { data: "braking" },
    { data: "rashTurning" },

    {
    data: null,
    orderable: false,
    searchable: false,
    className: "text-center",
    render: function (data, type, row) {
    return `
    <button class="btn btn-link text-primary p-0 me-2 editBtn" title="Edit">
    <i class="bi bi-pencil-square fs-5"></i>
    </button>

    <button class="btn btn-link text-danger p-0 deleteBtn" title="Delete">
    <i class="bi bi-trash3 fs-5"></i>
    </button>
    `;
    }
    }

    ],

    buttons: [

    {
    extend: 'excelHtml5',
    title: 'Driver Performance'
    },

    {
    extend: 'csvHtml5',
    title: 'Driver Performance'
    },

    {
    extend: 'pdfHtml5',
    title: 'Driver Performance'
    },

    {
    extend: 'print',
    title: 'Driver Performance'
    },

    {
    extend: 'copyHtml5'
    }

    ]


    });

    $(".dt-buttons").hide();

    $("#customSearch").on("keyup", function () {
    table.search($(this).val()).draw();
    });

    $("#btnExcel").click(function () {
    table.button(".buttons-excel").trigger();
    });

    $("#btnCsv").click(function () {
    table.button(".buttons-csv").trigger();
    });

    $("#btnPdf").click(function () {
    table.button(".buttons-pdf").trigger();
    });

    $("#btnPrint").click(function () {
    table.button(".buttons-print").trigger();
    });

    $("#btnCopy").click(function () {
    table.button(".buttons-copy").trigger();
    });

    });

</script>
<script>

  
    $(document).on("change",".criteriaChk",function(){

    let id=$(this).data("id");


    if($(this).is(":checked"))
    {

    $("#card_"+id).removeClass("d-none");

    }
    else
    {

    $("#card_"+id).addClass("d-none");

    $("#card_"+id)
    .find("input")
    .val("")
    .removeClass("is-invalid");

    }

    });
   
</script>
<script>

    $(document).on("keydown", ".criteriaInput", function (e) {

    if (e.key === "." || e.key === ",") {
    e.preventDefault();
    }

    });
    $(document).on("change",".criteriaInput",function(){


    if($(this).val().trim()=="")
    {
    $(this).addClass("is-invalid");
    }
    else
    {
    $(this).removeClass("is-invalid");
    }


    });


    $("#ddlCategory").change(function(){

    if($(this).val()=="")
    {
    $(this).addClass("is-invalid");
    }
    else
    {
    $(this).removeClass("is-invalid");
    }

    });
    function loadCategoryDropdown()
    {
    let existing = [];

    if ($.fn.DataTable.isDataTable("#driverTable")) {

    let rows = $("#driverTable").DataTable().rows().data();

    $.each(rows, function (i, row) {

    if (row.category) {
    existing.push(row.category.trim().toLowerCase());
    }

    });
    }

    let categories = [
    { id: 1, name: "Excellent" },
    { id: 2, name: "Good" },
    { id: 3, name: "Average" },
    { id: 4, name: "Poor" }
    ];

    $("#ddlCategory").empty();
    $("#ddlCategory").append(`<option value="">Select Category</option>`);

    $.each(categories, function (i, item) {

    if (!existing.includes(item.name.toLowerCase())) {

    $("#ddlCategory").append(`
    <option value="${item.id}">
    ${item.name}
    </option>
    `);

    }

    });
    }
    $(document).on("click",".removeCard",function(){

    let id=$(this).data("id");


    $("#card_"+id)
    .addClass("d-none");


    $("#card_"+id)
    .find("input")
    .val("");


    $('.criteriaChk[data-id="'+id+'"]')
    .prop("checked",false);


    });
    let criteriaList = [];
    let isEditMode = false;
    let editRowData = null;

    $(document).on("click", "#btnConfigure", function () {

    isEditMode = false;
    editRowData = null;

    getDriverCriteria();
    loadCategoryDropdown();

    });


    function getDriverCriteria()
    {
    $("#criteriaContainer").empty();
    $("#criteriaCards").empty();

    $.ajax({
    url: "/Driver_Management/GetDriverCriteria",
    type: "GET",

    beforeSend: function () {
    console.log("AJAX started");
    $("body").css("cursor", "wait");
    },

    success: function (res) {

    if (res.status) {
    criteriaList = res.data;
    generateCriteria(res.data);

    if (isEditMode && editRowData != null) {
    bindEditPerformance(editRowData);
    }
    }
    else {
    Swal.fire("Error", res.message, "error");
    }
    },

    error: function () {
    Swal.fire("Error", "Unable to fetch driver criteria.", "error");
    },

    complete: function () {
    console.log("AJAX completed");
    $("body").css("cursor", "default");
    }
    });
    }
    function generateCriteria(data)
    {

    $("#criteriaContainer").empty();

    $("#criteriaCards").empty();



    $.each(data,function(i,item){


    let id=item.id;



    // checkbox

    $("#criteriaContainer").append(`

    <div class="col-md-4 mb-3">

    <div class="form-check">

    <input class="form-check-input criteriaChk"
    type="checkbox"
    data-id="${id}">

    <label class="form-check-label">
    ${item.name}
    </label>

    </div>

    </div>

    `);



    // card

    let inputHtml="";


    if(id=="1")
    {

    inputHtml=`

    <div class="col-5">
    <input type="number"
    step="1"
    min="0"
    class="form-control criteriaInput"
    data-criteria="${id}"
    data-id="${id}"
    placeholder="Limit">
    </div>


    <div class="col-5">
    <input type="number"
    step="1"
    min="0"
    class="form-control criteriaInput"
    data-criteria="${id}"
    data-id="${id}"
    placeholder="Count">
    </div>

    `;

    }
    else if(id=="8" || id=="9" || id=="10")
    {

    inputHtml=`

    <div class="col-10">
    <input type="number"
    step="1"
    min="0"
    class="form-control criteriaInput"
    data-criteria="${id}"
    data-id="${id}"
    placeholder="Count">
    </div>

    `;

    }
    else
    {

    inputHtml=`

    <div class="col-5">
    <input type="number"
    step="1"
    min="0"
    class="form-control criteriaInput"
    data-criteria="${id}"
    data-id="${id}"
    placeholder="Min">
    </div>


    <div class="col-5">
    <input type="number"
    step="1"
    min="0"
    class="form-control criteriaInput"
    data-criteria="${id}"
    data-id="${id}"
    placeholder="Max">
    </div>

    `;

    }



    $("#criteriaCards").append(`

    <div class="col-md-6 px-1 d-none criteriaCard"
    id="card_${id}">

    <div class="card shadow-sm">

    <div class="card-body">


    <h6>
    ${item.name} (${(item.unit || "").trim()})
    </h6>

    <div class="row">

    ${inputHtml}


    <div class="col-2 text-end">

    <i class="bi bi-trash text-danger removeCard"
    data-id="${id}">
    </i>

    </div>


    </div>

    </div>

    </div>

    </div>

    `);



    });


    }
    $("#savePerformance").click(function () {

    if ($("#ddlCategory").val() == "") {

    $("#ddlCategory").addClass("is-invalid");
    return;
    }

    let criterion_selection = {};

    $(".criteriaCard").each(function () {

    let card = $(this);

    if (!card.hasClass("d-none")) {

    let id = card.attr("id").replace("card_", "");

    let values = [];
    let valid = true;

    card.find(".criteriaInput").each(function () {

    let value = $(this).val().trim();

    if (value == "") {
    $(this).addClass("is-invalid");
    valid = false;
    }
    else {
    $(this).removeClass("is-invalid");
    }

    values.push(value);

    });

    if (!valid) {
    return false;
    }

    criterion_selection[id] = values.join(",");

    }
    });

    // Add blank values for unchecked criteria
    criteriaList.forEach(function (item) {

    if (!criterion_selection.hasOwnProperty(item.id)) {
    criterion_selection[item.id] = "";
    }

    });
    if ($(".is-invalid").length > 0) {

    Swal.fire(
   
    "Please fill all selected criteria.",
   
    );

    return;
    }
    let payload = {
    type: parseInt($("#ddlCategory").val()),
    criterion_selection: criterion_selection
    };

    console.log(payload);
    let postUrl = isEditMode
    ? "/Driver_Management/UpdateDriverPerformance"
    : "/Driver_Management/SaveDriverPerformance";
    $.ajax({

    url:postUrl,

    type: "POST",

    contentType: "application/json",

    data: JSON.stringify(payload),

    beforeSend: function () {

    $("body").css("cursor", "wait");

    },

    success: function (res) {

    if (res.status) {

    Swal.fire(
    "Success",
    res.message,
    "success"
    ).then(function () {

    location.reload();

    });

    }
    else {

    Swal.fire("Error", res.message, "error");

    }

    },

    error: function () {

    Swal.fire(
    "Error",
    "Something went wrong.",
    "error"
    );

    },

    complete: function () {

    $("body").css("cursor", "default");

    }

    });

    });
    function bindEditPerformance(row) {

    $("#ddlCategory").empty();

    $("#ddlCategory").append(`
    <option value="${row.category_id}">
    ${row.category}
    </option>
    `);

    $("#ddlCategory").val(row.category_id);

    let map = {
    "1": row.overspeed + "," + row.Violation_Count,
    "2": row.distance,
    "3": row.halt,
    "4": row.running,
    "5": row.idle,
    "8": row.acceleration,
    "9": row.braking,
    "10": row.rashTurning
    };

    $.each(map, function (id, value) {

    if (!value || value == "N/A") {
    return;
    }

    value = value.replace("KM/H", "")
    .replace("KM", "")
    .replace("Hr", "")
    .trim();

    let values = value.split("-");

    if (id == "1") {
    values = value.split(",");
    }

    if (id == "8" || id == "9" || id == "10") {
    values = [value];
    }

    $('.criteriaChk[data-id="' + id + '"]').prop("checked", true);

    $("#card_" + id).removeClass("d-none");

    $("#card_" + id).find(".criteriaInput").each(function (index) {

    $(this).val((values[index] || "").trim());

    });

    });
    }
</script>
