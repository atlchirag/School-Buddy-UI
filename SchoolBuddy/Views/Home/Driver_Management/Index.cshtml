@model List<SchoolBuddy.Models.Driver.driver>
<link rel="stylesheet"
      <link rel="stylesheet"
      <link rel="stylesheet"
      href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
<style>
    
    #driverTable thead th {
        background-color: midnightblue !important;
        color: white !important;
      
        vertical-align: middle !important;
        
    }

    #driverTable thead th {
        background-color: midnightblue !important;

        color: white !important;
        white-space: nowrap;
        font-size: 0.70rem !important;
        font-weight: 600 !important;
    }

        #driverTable thead th * {
            color: white !important;
        }

    #driverTable thead th {
        padding-right: 15px !important;
        vertical-align: middle !important;
    }

    #driverTable {
        width: 90% !important;
    }

    #driverTable {
        font-size: 0.75rem !important; /* Entire table */
    }

    

    /* ===========================
       LABELS
    =========================== */

    /* ==========================================
       DRIVER MODAL
    ========================================== */

    .driver-modal .modal-dialog {
        max-width: 920px;
    }

    /* ==========================================
       HEADER
    ========================================== */

    /* ==========================================
       BODY
    ========================================== */

    /* ==========================================
       GRID SPACING
    ========================================== */

    .driver-modal .row {
        row-gap: 12px;
    }

    /* ==========================================
       LABELS
    ========================================== */

    .form-label {
        margin-bottom: 5px;
        font-size: .82rem;
        font-weight: 600;
        color: #444;
    }

        .form-label .text-danger {
            font-size: .9rem;
        }

    /* ==========================================
       INPUTS
    ========================================== */

    .form-control,
    .form-select {
        height: 40px;
        border-radius: 8px;
        border: 1px solid #d5d8dd;
        font-size: .88rem;
        color: #333;
        transition: all .25s ease;
        box-shadow: none;
    }

        .form-control::placeholder {
            color: #9aa0a6;
            font-size: .84rem;
        }

    textarea.form-control {
        height: 85px;
        resize: none;
        padding-top: 10px;
    }

    /* ==========================================
       FOCUS
    ========================================== */

    .form-control:focus,
    .form-select:focus {
        border-color: midnightblue;
        box-shadow: 0 0 0 .15rem rgba(25,25,112,.10);
    }

    /* ==========================================
       DATE INPUT
    ========================================== */

    input[type="date"] {
        cursor: pointer;
    }

    /* ==========================================
       FILE INPUT
    ========================================== */

    input[type="file"] {
        height: 40px;
        padding: 6px;
        font-size: .85rem;
    }

    input[type=file]::file-selector-button {
        border: none;
        background: #f3f5f7;
        padding: 7px 14px;
        margin-right: 12px;
        cursor: pointer;
        border-radius: 6px;
        transition: .3s;
    }

        input[type=file]::file-selector-button:hover {
            background: midnightblue;
            color: white;
        }

    /* ==========================================
       VALIDATION
    ========================================== */

    .error {
        display: block;
        min-height: 18px;
        margin-top: 3px;
        font-size: .73rem;
        color: #dc3545;
    }

    .is-invalid {
        border-color: #dc3545 !important;
    }

    .is-valid {
        border-color: #198754 !important;
    }

  
   
    /* ==========================================
       FOOTER
    ========================================== */

    /* ==========================================
       RESPONSIVE
    ========================================== */

    @@media (max-width:991px) {

        .driver-modal .modal-dialog {
            margin: 10px;
            max-width: 100%;
        }

        .form-control,
        .form-select {
            height: 38px;
            font-size: .85rem;
        }

        textarea.form-control {
            height: 75px;
        }
    }
    @@media (max-width: 768px) {

        .driver-modal .modal-dialog {
            margin: 10px;
            max-width: calc(100% - 20px);
        }

        .driver-modal .modal-content {
            max-height: calc(100vh - 20px);
            overflow-y: auto;
        }
    }
    .form-control,
    .form-select {
        transition: none;
    }
    /* File Input */
.form-control[type="file"] {
    height: 40px;
    padding: 0;
    font-size: .85rem;
    line-height: 40px;
}

.form-control[type="file"]::file-selector-button {
    height: 100%;
    margin-right: 12px;
    padding: 0 16px;
    
    cursor: pointer;
}
/* ==========================================
   ASSIGN UNIT MODAL
========================================== */

#assignUnitModal .modal-dialog{
    max-width:700px;
}

/* ==========================================
   TABS
========================================== */

.unit-tabs{
    display:flex;
    border-bottom:1px solid #e9ecef;
}

.tab-item{
    flex:1;
    text-align:center;
    padding:12px;
    font-size:.90rem;
    font-weight:600;
    color:#666;
    cursor:pointer;
    transition:.25s;
}

.tab-item:hover{
    background:#f5f5f5;
}

.tab-item.active{
    color:midnightblue;
    border-bottom:3px solid midnightblue;
    background:#f8f9fa;
}

/* ==========================================
   ASSIGN CONTENT
========================================== */

.assign-title{
    text-align:center;
    margin:22px 0;
    color:midnightblue;
    font-size:1.05rem;
    font-weight:600;
}

.form-area{
    width:85%;
    margin:0 auto 20px;
}

.input-label{
    display:block;
    margin-bottom:6px;
    font-size:.85rem;
    font-weight:600;
    color:midnightblue;
}

.input-label span{
    color:red;
}

.unit-select{
    height:42px;
    border-radius:8px;
    border:1px solid #ced4da;
    font-size:.88rem;
}

.unit-select:focus{
    border-color:midnightblue;
    box-shadow:0 0 0 .15rem rgba(25,25,112,.15);
}

/* ==========================================
   FOOTER
========================================== */

#deleteAssignBtn{
    border-radius:8px;
    padding:8px 20px;
    font-size:.85rem;
}

#assignContent .btn-primary{
    background:midnightblue;
    border-color:midnightblue;
    border-radius:8px;
    padding:8px 22px;
    font-size:.85rem;
}

#assignContent .btn-primary:hover{
    background:#11115c;
    border-color:#11115c;
}

/* ==========================================
   HISTORY
========================================== */

#historyTable_wrapper {
    padding-bottom: 30px;
}
.history-header{
    display:flex;
    justify-content:space-between;
    align-items:center;
    padding:18px 20px;
}

.history-header h4{
    margin:0;
    color:midnightblue;
    font-size:1rem;
    font-weight:600;
}

.search-box{
    width:180px;
    height:36px;
    display:flex;
    align-items:center;
    border:1px solid #ced4da;
    border-radius:6px;
    padding:0 10px;
}

.search-box input{
    border:none;
    outline:none;
    width:100%;
    font-size:.82rem;
}

.history-table{
    width:95%;
    margin:0 auto;
    border-collapse:collapse;
    font-size:.82rem;
}

.history-table th{
    background:midnightblue !important;
    color:#fff;
    padding:10px;
    text-align:center;
    font-weight:600;
}

.history-table td{
    padding:10px;
    text-align:center;
    color:#555;
    border-bottom:1px solid #ececec;
}

.history-table tbody tr:hover{
    background:#f8f9fa;
}

#historyTable_wrapper{
    width:95%;
    margin:auto;
}

#historyTable_filter{
    float:right;
    margin-bottom:10px;
}

#historyTable_filter input{
    height:36px;
    border-radius:6px;
}

#historyTable_length{
    float:left;
}

#historyTable_info{
    font-size:.85rem;
}

#historyTable_paginate{
    margin-top:10px;
}

#historyTable_paginate .paginate_button{
    padding:.3rem .75rem !important;
    border-radius:6px !important;
    margin:0 2px;
}

#historyTable_paginate .paginate_button.current{
    background:midnightblue !important;
    color:#fff !important;
    border:1px solid midnightblue !important;
}

#historyTable_paginate .paginate_button:hover{
    background:midnightblue !important;
    color:#fff !important;
}

/* ==========================================
   RESPONSIVE
========================================== */

@@media(max-width:768px){

    #assignUnitModal .modal-dialog{
        max-width:95%;
        margin:10px auto;
    }

    .history-header{
        flex-direction:column;
        gap:12px;
        align-items:stretch;
    }

    .search-box{
        width:100%;
    }

    .form-area{
        width:92%;
    }

    .history-table{
        font-size:.75rem;
    }

    .history-table th,
    .history-table td{
        padding:8px;
    }

    .pagination{
        flex-wrap:wrap;
        gap:10px;
    }

    #assignContent .modal-footer{
        flex-direction:column;
    }

    #assignContent .modal-footer button{
        width:100%;
    }
}
.unit-select{
    border:1px solid #d0d7de;
    border-radius:8px;
    height:42px;
    padding:0 12px;
    font-size:14px;
    background:#fff;
    color:#333;
    box-shadow:none;
    transition:all .2s ease;
    cursor:pointer;
}

.unit-select:hover{
    border-color:midnightblue;
}

.unit-select:focus{
    border-color:midnightblue;
    box-shadow:0 0 0 0.15rem rgba(25,25,112,.15);
}

.unit-select option{
    padding:8px;
}

/* delete driver */

.driver-delete-popup{
    border-radius:12px;
    padding:20px;
}

.driver-delete-title{
    color:midnightblue;
    font-weight:600;
    font-size:2rem;
}

.driver-delete-btn,
.driver-cancel-btn{
    min-width:110px;
    border-radius:25px !important;
    font-weight:600;
    background:midnightblue !important;
    border-color:midnightblue !important;
    color:#fff !important;
}

.driver-delete-btn:hover,
.driver-cancel-btn:hover{
    background:#15155f !important;
    border-color:#15155f !important;
}

#driverTable td:nth-child(11),
#driverTable th:nth-child(11) {

    width: 220px;
    max-width: 220px;

}

#driverTable {
    width: 100% !important;
}

#driverTable th:nth-child(7),
#driverTable td:nth-child(7) {
    white-space: nowrap;
    min-width: 110px;
}

#driverTable th:nth-child(11),
#driverTable td:nth-child(11) {
    min-width: 220px;
    max-width: 220px;
}


/* All normal tables + DataTables */
table thead th,
table.dataTable thead th,
table.dataTable thead td {
    background-color: midnightblue !important;
    color: white !important;
    white-space: nowrap;
    padding-right: 25px !important;
    vertical-align: middle !important;
}

table thead th *,
table.dataTable thead th *,
table.dataTable thead td * {
    color: white !important;
}

/* Buttons container */



/* Buttons container */
div.dt-buttons {
    display: flex;
    gap: 15px;
    margin-bottom: 20px;
}

/* Base style for all buttons */
div.dt-buttons .dt-button {
    width: 45px !important;
    height: 45px !important;
    padding: 0 !important;
    margin: 0 !important;
    
    display: flex !important;
    justify-content: center !important;
    align-items: center !important;
    
    border-radius: 50% !important; /* Makes it circular */
    background: #ffffff !important; /* White background */
    border: 2px solid transparent !important; /* Default transparent, colored via specific classes */
    
    box-shadow: 0 2px 5px rgba(0,0,0,0.1) !important; /* Subtle shadow for "pop" */
    transition: all 0.3s ease !important;
}

/* Hover Effect */
div.dt-buttons .dt-button:hover {
    transform: translateY(-2px);
    box-shadow: 0 4px 8px rgba(0,0,0,0.15) !important;
    background: #f8f9fa !important;
}

/* Adjust Icon size inside the circles */
div.dt-buttons .dt-button i {
    font-size: 18px !important;
}

/* Specific Border Colors */
.copy-btn { border-color: #00BCD4 !important; }
.copy-btn i { color: #00BCD4 !important; }

.excel-btn { border-color: #28A745 !important; }
.excel-btn i { color: #28A745 !important; }

.csv-btn { border-color: #FFC107 !important; }
.csv-btn i { color: #FFC107 !important; }

.pdf-btn { border-color: #FF3B30 !important; }
.pdf-btn i { color: #FF3B30 !important; }

.print-btn { border-color: #2979FF !important; }
.print-btn i { color: #2979FF !important; }

.iconstyle{
    background: #fff !important;
}

.iconstyle i{
    color: inherit !important;
}

/* Individual buttons */
#btnCopy{
    color:#00BCD4 !important;
    border:1px solid currentColor !important;
}

#btnExcel{
    color:#28A745 !important;
    border:1px solid currentColor !important;
}

#btnCsv{
    color:#FFC107 !important;
    border:1px solid currentColor !important;
}

#btnPdf{
    color:#FF3B30 !important;
    border:1px solid currentColor !important;
}

#btnPrint{
    color:#2979FF !important;
    border:1px solid currentColor !important;
}

</style>
@{
    ViewData["Title"] = "Driver Management";
}

<div class="card container-fluid">

    <div class="row">

        <div class="col-lg-12"
             style="margin-top:3vmin">

            <!-- CARD HEADER -->

            <div class="card-header rounded-top"
                 style="background-color:midnightblue;color:white;">

                <p style="font-weight:600;margin:0px">

                    Driver Management

                </p>

            </div>



            <!-- CARD BODY -->

            <div class="card-body rounded p-3"
                 style="background-color:white">

                <!-- TOP ACTIONS -->
                <div class="d-flex justify-content-between p-">
                <div class="d-flex justify-content-between align-items-center mb-1">

                    <div class="d-flex align-items-center gap-2">

    <!-- Add Driver -->
    <button class="btn btn-sm iconstyle"
            data-bs-toggle="modal"
            data-bs-target="#addDriverModal">
        <i class="bi bi-person-fill-add fs-5"></i>
    </button>

    

    <!-- Copy -->
    <button class="btn btn-sm iconstyle" id="btnCopy">
        <i class="bi bi-copy fs-5"></i>
    </button>

    <!-- Excel -->
    <button class="btn btn-sm iconstyle" id="btnExcel">
        <i class="bi bi-file-earmark-excel-fill text-success fs-5"></i>
    </button>

    <!-- CSV -->
    <button class="btn btn-sm iconstyle" id="btnCsv">
        <i class="bi bi-file-earmark-spreadsheet-fill text-warning  fs-5"></i>
    </button>

    <!-- PDF -->
    <button class="btn btn-sm iconstyle" id="btnPdf">
        <i class="bi bi-file-earmark-pdf-fill text-danger fs-5"></i>
    </button>

    <!-- Print -->
    <button class="btn btn-sm iconstyle" id="btnPrint">
        <i class="bi bi-printer-fill text-primary fs-5"></i>
    </button>

</div>

                </div>
                    <p style="font-size:0.1.2rem"><b>Total Driver  :  @ViewBag.DriverCount</b></p>
                 </div>



                <!-- TABLE -->

                <div class="row scrollit mt-1 w-90"
                     style="background-color:white;">

                    <div class="col-lg-12 table-responsive"
                         style="width:100%">

                        <table id="driverTable" 
                               class="table table-striped table-hover">

                            <thead>

                                <tr class="text-center driver-table-header">

                                    <th>S.No</th>

                                    <th>Name</th>

                                    <th>DL No</th>
                                    <th>Assigned Unit</th>
                                   

                                    <th>DL Issued Date</th>

                                    <th>DL Expiry Date</th>
                                    

                                    <th>DOB</th>

                                    <th>Email</th>

                                    <th>Contact No</th>

                                    <th>Emergency No</th>

                                    <th>Address</th>

                                    <th>DL Copy</th>

                                    <th>Assign Unit</th>

                                    <th>Action</th>

                                </tr>

                            </thead>

                            <tbody>

                                @if (Model != null && Model.Count > 0)
                                {
                                    int sno = 1;

                                    foreach (var driver in Model)
                                    {
                                        <tr class="text-center driver-table-row">

                                            <td>@sno</td>

                                            <td>@driver.name</td>

                                            <td>@driver.dl_no</td>

                                            <td>@(!string.IsNullOrWhiteSpace(driver.veh_reg) ? driver.veh_reg : "N/A")</td>

                                            <td>
                                                @(DateTime.TryParse(driver.dl_issued, out var dt)
                                                    ? dt.ToString("dd-MM-yyyy")
                                                    : "N/A")
                                            </td>

                                            <td>
    @(DateTime.TryParse(driver.dl_expiry, out var dt1)
        ? dt1.ToString("dd-MM-yyyy")
        : "N/A")
</td>

                                            <td>
    @(DateTime.TryParse(driver.dob, out var dt2)
        ? dt2.ToString("dd-MM-yyyy")
        : "N/A")
</td>

                                            <td>@driver.email</td>

                                            <td>@driver.mobile</td>

                                            <td>@driver.emergency_contact_no</td>

                                            <td>
    @(string.IsNullOrWhiteSpace(driver.address)
        ? "N/A"
        : (driver.address.Length > 30
            ? driver.address.Substring(0, 30) + "..."
            : driver.address))
</td>

                                            <td>

                                                <a href="@driver.dl_copy"
                                                   target="_blank"
                                                   title="View DL Copy">

                                                    <i class="bi bi-eye text-danger fs-5"></i>
                                                </a>

                                            </td>

                                           
                                                <td>
    <button type="button"
        class="btn btn-primary btn-sm assignBtn"
        data-driverid="@driver.id"
        data-drivername="@driver.name"
    data-serviceid="@driver.service_id">
    Assign
</button>
</td>

                                            

                                            <td>

                                                <div class="d-flex justify-content-center gap-2">

                                                    <a href="javascript:void(0)"
                                                    title="Edit Driver"
   class="editDriverBtn"
   data-id="@driver.id"
   data-name="@driver.name"
   data-dob="@driver.dob"
   data-mobile="@driver.mobile"
   data-email="@driver.email"
   data-dl="@driver.dl_no"
   data-issued="@driver.dl_issued"
   data-expiry="@driver.dl_expiry"
   data-address="@driver.address"
   data-emergency="@driver.emergency_contact_no"
   data-dlcopy="@driver.dl_copy">
   <i class="bi bi-pencil-square fs-5"></i>


</a>

                                                        

                                                   <a href="javascript:void(0)"
   class="deleteDriverBtn"
   data-id="@driver.id"
   data-name="@driver.name"
   title="Delete Driver">

    <i class="bi bi-trash text-danger tableicon fs-5"></i>

</a>

                                                </div>

                                            </td>

                                        </tr>

                                        sno++;
                                    }
                                }
                                

                            </tbody>

                        </table>

                    </div>

                </div>

            </div>

        </div>

    </div>

</div>

<!-- Add Driver Modal -->
<div class="modal fade sb-common-modal"
     id="addDriverModal"
     tabindex="-1"
     aria-labelledby="addDriverModalLabel"
     aria-hidden="true">

    <div class="modal-dialog modal-lg modal-fullscreen-sm-down driver-modal">

        <div class="modal-content">

            <!-- Header -->
            <div class="modal-header">
                <h4 class="modal-title" id="addDriverModalLabel">
                    <i class="bi bi-person-plus-fill me-2"></i>
                    Add Driver
                </h4>

                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="modal"
                        aria-label="Close"></button>
            </div>

            <form id="driverForm" enctype="multipart/form-data"" novalidate>
                <input type="hidden" id="editdriverId" name="driver_id" value="0" />
                <div class="modal-body">

                    <div class="row g-3">

                        <!-- Name -->
                        <div class="col-lg-4">
                            <label class="form-label">
                                Driver Name
                                <span class="text-danger">*</span>
                            </label>

                            <input type="text"
                                   id="driverName"
                                   name="name"
                                   class="form-control"
                            maxlength="100"
                            placeholder="Enter Driver Name">

                            <small class="text-danger error"
                                   id="driverNameError"></small>
                        </div>

                        <!-- Mobile -->
                        <div class="col-lg-4">
                            <label class="form-label">
                                Mobile Number
                                <span class="text-danger">*</span>
                            </label>

                           <input type="text"
       id="mobile"
       name="mobile"
       class="form-control"
       maxlength="10"
       inputmode="numeric"
       autocomplete="off"
       placeholder="Enter Mobile Number">

                            <small class="text-danger error"
                                   id="mobileError"></small>
                        </div>

                        <!-- Email -->
                        <div class="col-lg-4">
                            <label class="form-label">
                                Email
                                <span class="text-danger">*</span>
                            </label>

                            <input type="email"
                                   id="email"
                                    name="email"
                                   class="form-control"
                            placeholder="Email Address">

                            <small class="text-danger error"
                                   id="emailError"></small>
                        </div>

                        <!-- DOB -->
                        <div class="col-lg-4">
                            <label class="form-label">
                                Date of Birth
                                <span class="text-danger">*</span>
                            </label>

                           <input type="date"
                                name="dob"
       id="dob"
       name="dob"
       class="form-control"
       max="@DateTime.Today.AddYears(-18).ToString("yyyy-MM-dd")" />

                            <small class="text-danger error"
                                   id="dobError"></small>
                        </div>

                        <!-- Emergency -->
                        <div class="col-lg-4">
                            <label class="form-label">
                                Emergency Contact
                                <span class="text-danger">*</span>
                            </label>

                            <input type="text"
                                   maxlength="10"
                                   name="emergency_contact"
                                   id="emergency"
                                   class="form-control"
                            placeholder="Enter Emergency Contact Number">

                            <small class="text-danger error"
                                   id="emergencyError"></small>
                        </div>

                        <!-- DL Number -->
                        <div class="col-lg-4">
                            <label class="form-label">
                                Driving Licence No
                                <span class="text-danger">*</span>
                            </label>

                            <input type="text"
                                   id="dlNo"
                                    name="dl_number"
                                   class="form-control"
                            placeholder="Enter Driving Licence No">

                            <small class="text-danger error"
                                   id="dlNoError"></small>
                        </div>

                        <!-- Issue Date -->
                        <div class="col-lg-4">
                            <label class="form-label">
                                DL Issue Date
                                <span class="text-danger">*</span>
                            </label>

                            <input type="date"
       id="issueDate"
       name="dl_issue_Date"
       class="form-control"
       max="@DateTime.Today.ToString("yyyy-MM-dd")" />

                            <small class="text-danger error"
                                   id="issueDateError"></small>
                        </div>

                        <!-- Expiry Date -->
                        <div class="col-lg-4">
                            <label class="form-label">
                                DL Expiry Date
                                <span class="text-danger">*</span>
                            </label>

                            <input type="date"
       id="expiryDate"
       name="dl_expiry_Date"
       class="form-control"
       min="@DateTime.Today.ToString("yyyy-MM-dd")" />

                            <small class="text-danger error"
                                   id="expiryDateError"></small>
                        </div>

                        <!-- Upload -->
                        <div class="col-lg-4">

