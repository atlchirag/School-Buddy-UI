<script>
    $(document).on("click", ".deleteDriverBtn", function () {

    let driverId = $(this).data("id");
    let driverName = $(this).data("name");

    Swal.fire({
        title: "Remove Driver",
        html: "Are you sure you want to remove <b>" + driverName + "</b>?",
        icon: "warning",
        showCancelButton: true,
        confirmButtonText: "Delete",
        cancelButtonText: "Cancel",
        confirmButtonColor: "midnightblue",
        cancelButtonColor: "#6c757d",
        reverseButtons: true
    }).then((result) => {

        if (!result.isConfirmed)
            return;

        $.ajax({

            url: "/Driver_Management/DeleteDriver",

            type: "POST",

            data: {
                driver_id: driverId
            },

            beforeSend: function () {

                Swal.fire({
                    title: "Deleting Driver...",
                    allowOutsideClick: false,
                    didOpen: function () {
                        Swal.showLoading();
                    }
                });

            },

            success: function (response) {

                if (response.success) {

                    Swal.fire({
                        icon: "success",
                        title: "Deleted",
                        text: response.message
                    }).then(function () {

                        location.reload();

                    });

                }
                else {

                    Swal.fire({
                        icon: "error",
                        title: "Error",
                        text: response.message
                    });

                }

            },

            error: function () {

                Swal.fire({
                    icon: "error",
                    title: "Error",
                    text: "Something went wrong."
                });

            }

        });

    });

});
    $(document).on("click", ".editDriverBtn", function () {

    isEdit = true;

    $("#editdriverId").val($(this).data("id"));

    $("#driverName").val($(this).data("name"));
    $("#mobile").val($(this).data("mobile"));
    $("#email").val($(this).data("email"));
    $("#dob").val(formatDate($(this).data("dob")));
    $("#emergency").val($(this).data("emergency"));
    $("#dlNo").val($(this).data("dl"));
    $("#issueDate").val(formatDate($(this).data("issued")));
    $("#expiryDate").val(formatDate($(this).data("expiry")));
    $("#address").val($(this).data("address"));

$("#dlCopy").val("");

let dl = $(this).data("dlcopy");

if (dl) {

  let fileName = dl.split('/').pop();

// Trim filename if it's too long
if (fileName.length > 20) {
    let ext = fileName.substring(fileName.lastIndexOf('.'));
    fileName = fileName.substring(0, 15) + "..." + ext;
}

$("#existingDlLink")
    .attr("href", dl)
    .text(fileName);
    $("#existingDlFile").show();

}
else {

    $("#existingDlFile").hide();

}
    $(".modal-title").html(
        '<i class="bi bi-pencil-square me-2"></i> Edit Driver'
    );

