    // ==========================
    // Error Success
    // ==========================


    function showError(id,message)
    {

        $("#"+id)
        .addClass("is-invalid")
        .removeClass("is-valid");


        $("#"+id+"Error").text(message);

    }



    function showSuccess(id)
    {

        $("#"+id)
        .removeClass("is-invalid")
        .addClass("is-valid");


        $("#"+id+"Error").text("");

    }




    // ==========================
    // Validation Functions
    // ==========================


    function validateDriverName()
    {

        if($("#driverName").val().trim()=="")
        {
            showError("driverName","Driver Name is required");
            return false;
        }


        showSuccess("driverName");
        return true;

    }




    function validateMobile()
    {

        let regex=/^[6-9]\d{9}$/;

        let value=$("#mobile").val();


        if(value=="")
        {
            showError("mobile","Mobile Number is required");
            return false;
        }


        if(!regex.test(value))
        {
            showError("mobile","Enter valid 10 digit mobile number");
            return false;
        }


        showSuccess("mobile");
        return true;

    }





    function validateEmail()
    {

        let regex=/^[^\s@@]+@@[^\s@@]+\.[^\s@@]+$/;

        let value=$("#email").val();


        if(value=="")
        {
            showError("email","Email is required");
            return false;
        }


        if(!regex.test(value))
        {
            showError("email","Invalid Email");
            return false;
        }


        showSuccess("email");
        return true;

    }





    function validateDOB()
    {

        let value=$("#dob").val();


        if(value=="")
        {
            showError("dob","Date of Birth is required");
            return false;
        }


        let dob=new Date(value);

        let today=new Date();

        today.setHours(0,0,0,0);



        if(dob>=today)
        {
            showError("dob","DOB must be before today");
            return false;
        }


        showSuccess("dob");
        return true;

    }





    function validateEmergency()
    {

        let regex=/^[6-9]\d{9}$/;

        let value=$("#emergency").val();



        if(value=="")
        {
            showError("emergency","Emergency Contact is required");
            return false;
        }


        if(!regex.test(value))
        {
            showError("emergency","Invalid Emergency Contact");
            return false;
        }


        showSuccess("emergency");
        return true;

    }






    function validateDL()
    {

        let value=$("#dlNo").val().trim();

        let regex=/^[A-Z]{2}[0-9]{2}[0-9]{11,13}$/;



        if(value=="")
        {
            showError("dlNo","Driving Licence Number is required");
            return false;
        }


        if(!regex.test(value))
        {
            showError("dlNo","Invalid Driving Licence Number");
            return false;
        }


        showSuccess("dlNo");
        return true;

    }






    function validateIssueDate()
    {

        if($("#issueDate").val()=="")
        {
            showError("issueDate","Issue Date is required");
            return false;
        }


        showSuccess("issueDate");
        return true;

    }






    function validateExpiryDate()
    {

        let expiry=$("#expiryDate").val();

        let issue=$("#issueDate").val();



        if(expiry=="")
        {
            showError("expiryDate","Expiry Date is required");
            return false;
        }



        if(issue!="" && new Date(expiry)<=new Date(issue))
        {
            showError("expiryDate","Expiry date must be after issue date");
            return false;
        }


        showSuccess("expiryDate");
        return true;

    }







    function validateAddress()
    {

        if($("#address").val().trim()=="")
        {
            showError("address","Address is required");
            return false;
        }


        showSuccess("address");
        return true;

    }







    function validateDLFile() {

    let file = $("#dlCopy")[0].files[0];

    // In Edit mode, file is optional
    if (!file) {

        if (isEdit) {
            showSuccess("dlCopy");
            return true;
        }

        showError("dlCopy", "Please upload Driving Licence Copy");
        return false;
    }

    let ext = file.name.split('.').pop().toLowerCase();

    let allowed = ["jpg", "jpeg", "png", "pdf"];

    if (!allowed.includes(ext)) {

        showError("dlCopy", "Only JPG, JPEG, PNG and PDF files are allowed.");
        return false;
    }

    // Maximum file size = 2 MB
    const maxSize = 2 * 1024 * 1024;

    if (file.size > maxSize) {

        showError("dlCopy", "File size must not exceed 2 MB.");
        return false;
    }

    showSuccess("dlCopy");
    return true;
}






