    $("#deleteAssignBtn").click(function () {

    var driverId = $("#driverId").val();
    var serviceId = $("#serviceId").val();
    var deviceId = $("#deviceId").val();
   
    Swal.fire({
        title: "Unassign Vehicle?",
        text: "Do you want to unassign this vehicle?",
        icon: "warning",
        showCancelButton: true,
        confirmButtonColor: "midnightblue",
        cancelButtonColor: "#d33",
        confirmButtonText: "Yes, Unassign"
    }).then((result) => {

        if (!result.isConfirmed)
            return;

        $.ajax({
            url: "/Driver_Management/UnAssignVehicle",
            type: "POST",
            data: {
                driverId: driverId,
                serviceId: serviceId,
                deviceId: deviceId
            },
            success: function (response) {

    if (response.success) {

                    Swal.fire({
                        icon: "success",
                        title: "Success",
                        text: response.message
                    }).then(function () {

                        $("#unitList").val("");
                        $("#deleteAssignBtn").hide();

                        bootstrap.Modal.getInstance(
                            document.getElementById("assignUnitModal")
                        ).hide();

                        location.reload();
                    });

                } else {

                    Swal.fire(
                        "Error",
                        response.message,
                        "error"
                    );
                }

            },
            error: function () {

                Swal.fire(
                    "Error",
                    "Something went wrong.",
                    "error"
                );

            }
        });



    });

});
    $(document).on("click", ".assignBtn", function () {

    var driverName = $(this).data("drivername");
    var driverId = $(this).data("driverid");
    var serviceId = $(this).data("serviceid");
    $("#assignName").text(driverName);   // Set the driver's name
    $("#driverId").val(driverId);
    
    $("#serviceId").val(serviceId);

    $.ajax({
        url: "/Driver_Management/Veh_list",
        type: "POST",
        success: function (response) {

            $("#unitList").empty();
            $("#unitList").append('<option value="">Select Unit</option>');

            if (response.success) {

                $.each(response.data, function (i, item) {

                    var selected = "";

                    // Preselect if service id matches
                    if (serviceId && Number(serviceId) === Number(item.service_id)) {
                        selected = "selected";
                    }

                    $("#unitList").append(
                        `<option value="${item.service_id}" ${selected}>
                            ${item.veh_reg}
                        </option>`
                    );
                });

                // Show/Hide Delete button
                if (serviceId && serviceId != "" && serviceId != 0) {
                    $("#deleteAssignBtn").show();
                } else {
                    $("#deleteAssignBtn").hide();
                }

                var modal = new bootstrap.Modal(document.getElementById("assignUnitModal"));
                modal.show();
            }
        }
    });

});
    </script>

